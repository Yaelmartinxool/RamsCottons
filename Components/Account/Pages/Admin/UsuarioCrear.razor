@page "/admin/usuarios/crear"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using RamsCottons.Data
@using RamsCottons.Models
@using RamsCottons.Models.CycData
@using RamsCottons.Services
@using System.Text
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.WebUtilities
@using System.ComponentModel.DataAnnotations
@attribute [Authorize(Roles = "SuperAdministrador")]

@inject UserManager<ApplicationUser> UserManager
@inject RoleManager<IdentityRole> RoleManager
@inject IEmailSender<ApplicationUser> EmailSender
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Crear Usuario | RAMS Cottons</PageTitle>

<div class="create-user-container">
    <!-- Header -->
    <div class="dashboard-header">
        <div class="header-content">
            <div class="header-title">
                <div class="title-icon">
                    <i class="bi bi-person-plus-fill"></i>
                </div>
                <div>
                    <h1>Crear Nuevo Usuario</h1>
                    <p class="subtitle">Registre un nuevo miembro en el sistema</p>
                </div>
            </div>
            <button class="btn-back" @onclick="Volver">
                <span>Volver a Usuarios</span>
            </button>
        </div>
    </div>

    <!-- EditForm envuelve TODO el row -->
    <EditForm Model="model" OnValidSubmit="CrearUsuario" FormName="crearUsuario">
        <DataAnnotationsValidator />
        <ValidationSummary class="validation-summary" />

        <div class="row">
            <!-- Columna Principal: Formulario -->
            <div class="col-lg-8">
                <div class="form-card">
                    <div class="card-header">
                        <div class="header-left">
                            <i class="bi bi-pencil-square"></i>
                            <h3>Informacion del Usuario</h3>
                        </div>
                        <span class="required-badge">* Campos obligatorios</span>
                    </div>
                    <div class="card-body">
                        <div class="form-grid">
                            <!-- Nombre Completo -->
                            <div class="form-group full-width">
                                <label class="form-label">
                                    Nombre Completo <span class="text-danger">*</span>
                                </label>
                                <div class="input-wrapper">
                                    <i class="bi bi-person input-icon"></i>
                                    <InputText @bind-Value="model.NombreCompleto"
                                               class="form-control"
                                               placeholder="Ej: Juan Carlos Perez" />
                                </div>
                                <ValidationMessage For="() => model.NombreCompleto" class="validation-message" />
                            </div>

                            <!-- Nombre de Usuario -->
                            <div class="form-group full-width">
                                <label class="form-label">
                                    Nombre de Usuario <span class="text-danger">*</span>
                                </label>
                                <div class="input-wrapper">
                                    <i class="bi bi-at input-icon"></i>
                                    <InputText @bind-Value="model.UserName"
                                               class="form-control"
                                               placeholder="usuario" />
                                </div>
                                <ValidationMessage For="() => model.UserName" class="validation-message" />
                                <span class="field-hint">Nombre unico para iniciar sesion</span>
                            </div>

                            <!-- Email y Telefono -->
                            <div class="form-group">
                                <label class="form-label">
                                    Correo Electronico <span class="text-danger">*</span>
                                </label>
                                <div class="input-wrapper">
                                    <i class="bi bi-envelope input-icon"></i>
                                    <InputText @bind-Value="model.Email"
                                               class="form-control"
                                               placeholder="usuario@ramscottons.com" />
                                </div>
                                <ValidationMessage For="() => model.Email" class="validation-message" />
                            </div>

                            <div class="form-group">
                                <label class="form-label">
                                    Telefono <span class="text-danger">*</span>
                                </label>
                                <div class="input-wrapper">
                                    <i class="bi bi-telephone input-icon"></i>
                                    <InputText @bind-Value="model.Telefono"
                                               class="form-control"
                                               placeholder="+521234567890" />
                                </div>
                                <ValidationMessage For="() => model.Telefono" class="validation-message" />
                                <span class="field-hint">Formato internacional</span>
                            </div>

                            <!-- Contrasena -->
                            <div class="form-group full-width">
                                <label class="form-label">
                                    Contrasena Temporal <span class="text-danger">*</span>
                                </label>
                                <div class="input-wrapper">
                                    <i class="bi bi-lock input-icon"></i>
                                    <InputText type="password" @bind-Value="model.Password"
                                               class="form-control"
                                               placeholder="••••••••" />
                                </div>
                                <ValidationMessage For="() => model.Password" class="validation-message" />
                                <span class="field-hint">Minimo 6 caracteres. El usuario la cambiara al activar su cuenta.</span>
                            </div>

                            <!-- Roles (Selector Visual con ICONOS) -->
                            <div class="form-group full-width">
                                <label class="form-label">
                                    Rol de Usuario <span class="text-danger">*</span>
                                </label>
                                <ValidationMessage For="() => model.Rol" class="validation-message" />
                                <div class="roles-grid">
                                    @foreach (var rol in roles.Where(r => !string.IsNullOrEmpty(r.Name)))
                                    {
                                        var roleName = rol.Name!;
                                        var isSelected = model.Rol == roleName;
                                        <div class="role-card @(isSelected ? "selected" : "")" @onclick="() => SeleccionarRol(roleName)">
                                            <div class="role-icon">
                                                <i class="bi @GetRoleIcon(roleName)"></i>
                                            </div>
                                            <div class="role-info">
                                                <span class="role-name">@rol.Name</span>
                                                <span class="role-desc">@GetRoleDescription(rol.Name)</span>
                                            </div>
                                            <div class="role-check">
                                                @if (isSelected)
                                                {
                                                    <span class="check-mark">✓</span>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Mensaje Informativo -->
                            <div class="info-message full-width">
                                <i class="bi bi-info-circle-fill"></i>
                                <span>
                                    <strong>Nota:</strong> Se enviara un correo de confirmacion al usuario con las instrucciones para activar su cuenta y acceder al sistema.
                                </span>
                            </div>

                            <!-- Botones de Accion -->
                            <div class="form-actions full-width">
                                <button type="submit" class="btn-submit" disabled="@cargando">
                                    @(cargando ? "Creando..." : "Crear Usuario")
                                </button>
                                <button type="button" class="btn-cancel" @onclick="Volver">
                                    Cancelar
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Columna Lateral -->
            <div class="col-lg-4">
                <div class="info-card">
                    <div class="info-card-header">
                        <i class="bi bi-envelope-paper"></i>
                        <h4>Proceso de Activacion</h4>
                    </div>
                    <div class="info-card-body">
                        <div class="process-step">
                            <div class="step-number">1</div>
                            <div class="step-text">Completa el formulario con los datos del nuevo usuario</div>
                        </div>
                        <div class="process-step">
                            <div class="step-number">2</div>
                            <div class="step-text">El sistema envia un correo de confirmacion automatico</div>
                        </div>
                        <div class="process-step">
                            <div class="step-number">3</div>
                            <div class="step-text">El usuario confirma su cuenta desde el enlace recibido</div>
                        </div>
                        <div class="process-step">
                            <div class="step-number">4</div>
                            <div class="step-text">¡El usuario ya puede iniciar sesion en el sistema!</div>
                        </div>
                    </div>
                </div>

                <div class="info-card">
                    <div class="info-card-header">
                        <i class="bi bi-shield-check"></i>
                        <h4>Roles Disponibles</h4>
                    </div>
                    <div class="info-card-body">
                        <div class="role-info-item">
                            <span class="role-tag role-tag-superadmin">
                                <i class="bi bi-shield-fill-check me-1"></i>
                                SuperAdministrador
                            </span>
                            <p class="role-description">Control total del sistema, todos los permisos.</p>
                        </div>
                        <div class="role-info-item">
                            <span class="role-tag role-tag-admin">
                                <i class="bi bi-person-fill-gear me-1"></i>
                                Administrador
                            </span>
                            <p class="role-description">Administracion del sistema y gestion de contenido.</p>
                        </div>
                    </div>
                </div>

                <div class="tip-card">
                    <i class="bi bi-lightbulb"></i>
                    <div>
                        <h5>Consejo de Seguridad</h5>
                        <p>Utiliza una contrasena temporal simple. El sistema forzara al usuario a cambiarla en su primer inicio de sesion despues de confirmar su email.</p>
                    </div>
                </div>
            </div>
        </div>
    </EditForm>

    @if (!string.IsNullOrEmpty(mensajeExito))
    {
        <div class="toast-notification toast-success">
            <i class="bi bi-check-circle-fill"></i>
            <span>@mensajeExito</span>
        </div>
    }

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="toast-notification toast-error">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>@error</span>
        </div>
    }
</div>

@code {
    private List<IdentityRole> roles = new();
    private bool cargando;
    private string? error;
    private string? mensajeExito;

    private Modelo model = new();

    protected override async Task OnInitializedAsync()
    {
        var allRoles = await RoleManager.Roles.ToListAsync();
        roles = allRoles
            .Where(r => r.Name == "SuperAdministrador" || r.Name == "Administrador")
            .ToList();
    }

    private void SeleccionarRol(string rol)
    {
        model.Rol = rol;
    }

    private string GetRoleDescription(string? rol)
    {
        return rol switch
        {
            "SuperAdministrador" => "Control total del sistema, todos los permisos",
            "Administrador" => "Administracion del sistema y gestion de contenido",
            _ => "Acceso al sistema"
        };
    }

    private string GetRoleIcon(string? rol)
    {
        return rol switch
        {
            "SuperAdministrador" => "bi-shield-fill-check",
            "Administrador" => "bi-person-fill-gear",
            _ => "bi-person-fill"
        };
    }

    private async Task CrearUsuario()
    {
        cargando = true;
        error = null;
        mensajeExito = null;
        StateHasChanged();

        try
        {
            var existenteUser = await UserManager.FindByNameAsync(model.UserName);
            if (existenteUser != null)
            {
                error = "Ya existe un usuario con este nombre de usuario.";
                cargando = false;
                StateHasChanged();
                return;
            }

            var existenteEmail = await UserManager.FindByEmailAsync(model.Email);
            if (existenteEmail != null)
            {
                error = "Ya existe un usuario con este correo electronico.";
                cargando = false;
                StateHasChanged();
                return;
            }

            var user = new ApplicationUser
            {
                UserName = model.UserName,
                Email = model.Email,
                NombreCompleto = model.NombreCompleto,
                Telefono = model.Telefono,
                EmailConfirmed = false,
                Activo = true,
                FechaRegistro = DateTime.Now,
                IdSucursal = null
            };

            var result = await UserManager.CreateAsync(user, model.Password);

            if (!result.Succeeded)
            {
                error = string.Join(", ", result.Errors.Select(e => e.Description));
                cargando = false;
                StateHasChanged();
                return;
            }

            if (!string.IsNullOrEmpty(model.Rol))
            {
                await UserManager.AddToRoleAsync(user, model.Rol);
            }

            var code = await UserManager.GenerateEmailConfirmationTokenAsync(user);
            code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));

            var callbackUrl = NavigationManager.GetUriWithQueryParameters(
                NavigationManager.ToAbsoluteUri("Account/ConfirmEmail").AbsoluteUri,
                new Dictionary<string, object?>
                {
                    ["userId"] = user.Id,
                    ["code"] = code
                });

            await EmailSender.SendConfirmationLinkAsync(
                user,
                user.Email!,
                HtmlEncoder.Default.Encode(callbackUrl));

            mensajeExito = $"Usuario {model.NombreCompleto} creado. Se envio correo a {model.Email}.";

            model = new Modelo();
            await Task.Delay(3000);
            NavigationManager.NavigateTo("/admin/usuarios");
        }
        catch (Exception ex)
        {
            error = $"Error inesperado: {ex.Message}";
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private void Volver()
    {
        NavigationManager.NavigateTo("/admin/usuarios");
    }

    private class Modelo
    {
        [Required(ErrorMessage = "El nombre completo es obligatorio")]
        public string NombreCompleto { get; set; } = "";

        [Required(ErrorMessage = "El nombre de usuario es obligatorio")]
        public string UserName { get; set; } = "";

        [Required(ErrorMessage = "El correo es obligatorio")]
        [EmailAddress(ErrorMessage = "Formato de correo invalido")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "El telefono es obligatorio")]
        public string Telefono { get; set; } = "";

        [Required(ErrorMessage = "La contrasena es obligatoria")]
        [MinLength(6, ErrorMessage = "La contrasena debe tener al menos 6 caracteres")]
        public string Password { get; set; } = "";

        [Required(ErrorMessage = "Debes seleccionar un rol")]
        public string Rol { get; set; } = "";
    }
}

