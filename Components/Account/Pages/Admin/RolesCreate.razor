@page "/admin/roles/crear"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using System.ComponentModel.DataAnnotations

@attribute [Authorize(Roles = "SuperAdministrador")]

@inject RoleManager<IdentityRole> RoleManager
@inject NavigationManager NavigationManager

<PageTitle>Crear Rol | RAMS Cottons</PageTitle>
<br>
<div class="create-role-container">
    <!-- Header -->
    <div class="dashboard-header">
        <div class="header-content">
            <div class="header-title">
                <div class="title-icon">
                    <i class="bi bi-shield-plus"></i>
                </div>
                <div>
                    <h1>Crear Nuevo Rol</h1>
                    <p class="subtitle">Agregue un nuevo rol al sistema</p>
                </div>
            </div>
            <button class="btn-back" @onclick="Volver">
                <span>Volver a Roles</span>
            </button>
        </div>
    </div>

    <div class="row g-4">
        <!-- Columna Principal: Formulario -->
        <div class="col-lg-8">
            <div class="form-card">
                <div class="card-header">
                    <div class="header-left">
                        <i class="bi bi-pencil-square"></i>
                        <h3>Información del Rol</h3>
                    </div>
                    <span class="required-badge">* Campos obligatorios</span>
                </div>
                <div class="card-body">
                    <EditForm Model="model" OnValidSubmit="CrearRol" FormName="crearRol">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="validation-summary" />

                        <div class="form-grid">
                            <!-- Nombre del Rol -->
                            <div class="form-group full-width">
                                <label class="form-label">
                                    Nombre del Rol <span class="text-danger">*</span>
                                </label>
                                <div class="input-wrapper">
                                    <i class="bi bi-shield input-icon"></i>
                                    <InputText @bind-Value="model.Nombre"
                                            class="form-control"
                                            placeholder="Ej: Supervisor, Analista, Coordinador" />
                                </div>
                                <ValidationMessage For="() => model.Nombre" class="validation-message" />
                                <span class="field-hint">Nombre único, sin espacios (Ej: SupervisorVentas)</span>
                            </div>

                            <!-- Vista Previa del Rol -->
                            <div class="preview-card full-width">
                                <div class="preview-header">
                                    <i class="bi bi-eye"></i>
                                    <span>Vista previa del rol</span>
                                </div>
                                <div class="preview-body">
                                    <div class="role-preview">
                                        <div class="preview-icon" style="background: @GetRoleColor(model.Nombre)">
                                            <i class="@GetRoleIcon(model.Nombre)"></i>
                                        </div>
                                        <div class="preview-details">
                                            <span class="preview-name">@(!string.IsNullOrWhiteSpace(model.Nombre) ? model.Nombre : "Nombre del Rol")</span>
                                            <span class="preview-desc">@GetRoleDescription(model.Nombre)</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Mensaje Informativo -->
                            <div class="info-message full-width">
                                <i class="bi bi-info-circle-fill"></i>
                                <span>
                                    <strong>Nota:</strong> Después de crear el rol, podrás asignarle permisos específicos desde la gestión de roles.
                                </span>
                            </div>

                            <!-- Botones de Acción -->
                            <div class="form-actions full-width">
                                <button type="submit" class="btn-submit" disabled="@cargando">
                                    @(cargando ? "Creando..." : "Crear Rol")
                                </button>
                                <button type="button" class="btn-cancel" @onclick="Volver">
                                    Cancelar
                                </button>
                            </div>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>

        <!-- Columna Lateral: Información y Ayuda -->
        <div class="col-lg-4">
            <!-- Tarjeta de Proceso -->
            <div class="info-card">
                <div class="info-card-header">
                    <i class="bi bi-diagram-3"></i>
                    <h4>Proceso de Creación</h4>
                </div>
                <div class="info-card-body">
                    <div class="process-step">
                        <div class="step-number">1</div>
                        <div class="step-text">Define un nombre único y descriptivo para el rol</div>
                    </div>
                    <div class="process-step">
                        <div class="step-number">2</div>
                        <div class="step-text">El sistema valida que el nombre no exista previamente</div>
                    </div>
                    <div class="process-step">
                        <div class="step-number">3</div>
                        <div class="step-text">Se crea el rol y queda disponible para asignar permisos</div>
                    </div>
                    <div class="process-step">
                        <div class="step-number">4</div>
                        <div class="step-text">Ya puedes asignar este rol a usuarios y configurar permisos</div>
                    </div>
                </div>
            </div>

            <!-- Tarjeta de Roles del Sistema -->
            <div class="info-card">
                <div class="info-card-header">
                    <i class="bi bi-shield-check"></i>
                    <h4>Roles del Sistema</h4>
                </div>
                <div class="info-card-body">
                    <div class="role-example-item">
                        <div class="example-icon" style="background: linear-gradient(135deg, #7c3aed, #5b21b6);">
                            <i class="bi bi-shield-fill-check"></i>
                        </div>
                        <div class="example-info">
                            <span class="example-name">SuperAdministrador</span>
                            <span class="example-desc">Control total del sistema, todos los permisos</span>
                        </div>
                    </div>
                    <div class="role-example-item">
                        <div class="example-icon" style="background: linear-gradient(135deg, #1e293b, #0f172a);">
                            <i class="bi bi-person-fill-gear"></i>
                        </div>
                        <div class="example-info">
                            <span class="example-name">Administrador</span>
                            <span class="example-desc">Administración del sistema y gestión de contenido</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tarjeta de Consejo -->
            <div class="tip-card">
                <i class="bi bi-lightbulb"></i>
                <div>
                    <h5>Consejo de Nomenclatura</h5>
                    <p>Usa nombres descriptivos y consistentes. Ej: "SupervisorVentas" en lugar de "sv" o "ventas_sup". Esto facilita la gestión de permisos.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Toasts para notificaciones -->
    @if (!string.IsNullOrEmpty(mensajeExito))
    {
        <div class="toast-notification toast-success">
            <i class="bi bi-check-circle-fill"></i>
            <span>@mensajeExito</span>
        </div>
    }

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="toast-notification toast-error">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>@error</span>
        </div>
    }
</div>

@code {
    private bool cargando;
    private string? error;
    private string? mensajeExito;
    private Modelo model = new();

    private async Task CrearRol()
    {
        cargando = true;
        error = null;
        mensajeExito = null;
        StateHasChanged();

        try
        {
            var existente = await RoleManager.FindByNameAsync(model.Nombre);
            if (existente != null)
            {
                error = $"Ya existe un rol con el nombre '{model.Nombre}'";
                cargando = false;
                StateHasChanged();
                return;
            }

            var rol = new IdentityRole(model.Nombre);
            var result = await RoleManager.CreateAsync(rol);

            if (result.Succeeded)
            {
                mensajeExito = $"Rol '{model.Nombre}' creado exitosamente.";

                // Esperar un momento y redirigir
                await Task.Delay(2000);
                NavigationManager.NavigateTo("/admin/roles");
            }
            else
            {
                error = string.Join(", ", result.Errors.Select(e => e.Description));
            }
        }
        catch (Exception ex)
        {
            error = $"Error inesperado: {ex.Message}";
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private void Volver()
    {
        NavigationManager.NavigateTo("/admin/roles");
    }

    // Helpers para la vista previa
    private string GetRoleColor(string? roleName)
    {
        if (string.IsNullOrWhiteSpace(roleName))
            return "linear-gradient(135deg, #64748b, #475569)";

        return roleName switch
        {
            "SuperAdministrador" => "linear-gradient(135deg, #7c3aed, #5b21b6)",
            "Administrador" => "linear-gradient(135deg, #1e293b, #0f172a)",
            _ => "linear-gradient(135deg, #64748b, #475569)"
        };
    }

    private string GetRoleIcon(string? roleName)
    {
        if (string.IsNullOrWhiteSpace(roleName))
            return "bi bi-person-badge";

        return roleName switch
        {
            "SuperAdministrador" => "bi bi-shield-fill-check",
            "Administrador" => "bi bi-person-fill-gear",
            _ => "bi bi-person-badge"
        };
    }

    private string GetRoleDescription(string? roleName)
    {
        if (string.IsNullOrWhiteSpace(roleName))
            return "Rol personalizado";

        return roleName switch
        {
            "SuperAdministrador" => "Control total del sistema, todos los permisos",
            "Administrador" => "Administración del sistema y gestión de contenido",
            _ => "Rol personalizado"
        };
    }

    private class Modelo
    {
        [Required(ErrorMessage = "El nombre del rol es obligatorio")]
        [RegularExpression(@"^[a-zA-Z0-9]+$", ErrorMessage = "Solo letras y números, sin espacios ni caracteres especiales")]
        [StringLength(50, MinimumLength = 3, ErrorMessage = "El nombre debe tener entre 3 y 50 caracteres")]
        public string Nombre { get; set; } = "";
    }
}