@page "/admin/usuarios/view/{UserId}"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using RamsCottons.Data

@attribute [Authorize(Roles = "SuperAdministrador,Administrador")]

@inject UserManager<ApplicationUser> UserManager
@inject RoleManager<IdentityRole> RoleManager
@inject NavigationManager NavigationManager


<PageTitle>Ver Usuario | RAMS Cottons</PageTitle>

<br>
@if (cargandoInicial)
{
    <div class="loading-container">
        <div class="spinner-border text-primary"></div>
        <p>Cargando información del usuario...</p>
    </div>
}
else if (usuario is null)
{
    <div class="error-container">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <h3>Usuario no encontrado</h3>
        <p>El usuario que buscas no existe o ha sido eliminado.</p>
        <button class="btn-back" @onclick="Volver">
            <i class="bi bi-arrow-left"></i>
            <span>Volver a Usuarios</span>
        </button>
    </div>
}
else
{
    <div class="view-user-container">
        <!-- Header -->
        <div class="dashboard-header">
            <div class="header-content">
                <div class="header-title">
                    <div class="title-icon">
                        <i class="bi bi-eye-fill"></i>
                    </div>
                    <div>
                        <h1>Detalles del Usuario</h1>
                        <p class="subtitle">Información completa del miembro en el sistema</p>
                    </div>
                </div>
                <button class="btn-back" @onclick="Volver">
                    <span>Volver a Usuarios</span>
                </button>
            </div>
        </div>

        <div class="row g-4">
            <!-- Columna Principal: Información del Usuario -->
            <div class="col-lg-8">
                <!-- Tarjeta de Perfil -->
                <div class="profile-card">
                    <div class="profile-header" style="background: linear-gradient(135deg, @GetGradientStart(), @GetGradientEnd())">
                        <div class="profile-avatar">
                            @(string.IsNullOrWhiteSpace(usuario.NombreCompleto) ? "?" : usuario.NombreCompleto.Substring(0, 1).ToUpper())
                        </div>
                        <div class="profile-title">
                            <h2>@usuario.NombreCompleto</h2>
                            <p>@@@usuario.UserName</p>
                        </div>
                        @if (!usuario.Activo)
                        {
                            <span class="profile-badge inactive">
                                <i class="bi bi-exclamation-triangle"></i>
                                Inactivo
                            </span>
                        }
                    </div>
                </div>

                <!-- Tarjeta de Información Personal -->
                <div class="info-card">
                    <div class="info-card-header">
                        <i class="bi bi-person-badge"></i>
                        <h4>Información Personal</h4>
                    </div>
                    <div class="info-card-body">
                        <div class="info-grid">
                            <!-- Email -->
                            <div class="info-item">
                                <div class="info-icon" style="background: rgba(59, 130, 246, 0.1); color: var(--info);">
                                    <i class="bi bi-envelope-fill"></i>
                                </div>
                                <div class="info-content">
                                    <span class="info-label">Correo Electrónico</span>
                                    <span class="info-value">@usuario.Email</span>
                                    @if (usuario.EmailConfirmed)
                                    {
                                        <span class="info-badge success">
                                            <i class="bi bi-check-circle-fill"></i> Confirmado
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="info-badge warning">
                                            <i class="bi bi-exclamation-triangle-fill"></i> Pendiente
                                        </span>
                                    }
                                </div>
                            </div>

                            <!-- Teléfono -->
                            <div class="info-item">
                                <div class="info-icon" style="background: rgba(16, 185, 129, 0.1); color: var(--success);">
                                    <i class="bi bi-telephone-fill"></i>
                                </div>
                                <div class="info-content">
                                    <span class="info-label">Teléfono</span>
                                    <span class="info-value">
                                        @if (!string.IsNullOrEmpty(usuario.Telefono))
                                        {
                                            @usuario.Telefono
                                        }
                                        else
                                        {
                                            <span class="text-muted fw-normal">No registrado</span>
                                        }
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tarjeta de Información de la Cuenta -->
                <div class="info-card">
                    <div class="info-card-header">
                        <i class="bi bi-shield-lock"></i>
                        <h4>Información de la Cuenta</h4>
                    </div>
                    <div class="info-card-body">
                        <div class="account-info-grid">
                            <!-- ID de Usuario -->
                            <div class="account-info-item">
                                <span class="account-info-label">ID de Usuario:</span>
                                <code class="account-info-value">@usuario.Id</code>
                            </div>

                            <!-- Nombre de Usuario -->
                            <div class="account-info-item">
                                <span class="account-info-label">Nombre de Usuario:</span>
                                <span class="account-info-value">@usuario.UserName</span>
                            </div>

                            <!-- Estado de la Cuenta -->
                            <div class="account-info-item">
                                <span class="account-info-label">Estado de la Cuenta:</span>
                                <div class="account-info-value">
                                    <span class="status-badge @(usuario.Activo ? "status-active" : "status-inactive")">
                                        <i class="bi @(usuario.Activo ? "bi-check-circle-fill" : "bi-x-circle-fill")"></i>
                                        @(usuario.Activo ? "Activo" : "Inactivo")
                                    </span>
                                </div>
                            </div>

                            <!-- Confirmación de Email -->
                            <div class="account-info-item">
                                <span class="account-info-label">Confirmación Email:</span>
                                <div class="account-info-value">
                                    @if (usuario.EmailConfirmed)
                                    {
                                        <span class="status-badge status-active">
                                            <i class="bi bi-check-circle-fill"></i> Confirmado
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-warning">
                                            <i class="bi bi-exclamation-triangle-fill"></i> Pendiente
                                        </span>
                                    }
                                </div>
                            </div>

                            <!-- 2FA (si aplica) -->
                            @if (usuario.TwoFactorEnabled)
                            {
                                <div class="account-info-item">
                                    <span class="account-info-label">Autenticación 2FA:</span>
                                    <div class="account-info-value">
                                        <span class="status-badge status-active">
                                            <i class="bi bi-shield-check"></i> Activado
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Columna Lateral -->
            <div class="col-lg-4">
                <!-- Tarjeta de Roles -->
                <div class="info-card">
                    <div class="info-card-header">
                        <i class="bi bi-shield-check"></i>
                        <h4>Roles Asignados</h4>
                    </div>
                    <div class="info-card-body">
                        @if (rolesUsuario.Any())
                        {
                            <div class="roles-list">
                                @foreach (var rol in rolesUsuario)
                                {
                                    <div class="role-assigned-item">
                                        <div class="role-icon-small" style="background: @GetRoleColor(rol);">
                                            @if (rol == "SuperAdministrador")
                                            {
                                                <i class="bi bi-shield-fill-check"></i>
                                            }
                                            else if (rol == "Administrador")
                                            {
                                                <i class="bi bi-person-fill-gear"></i>
                                            }
                                            else if (rol == "Gerente")
                                            {
                                                <i class="bi bi-graph-up"></i>
                                            }
                                            else if (rol == "Vendedor")
                                            {
                                                <i class="bi bi-shop"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-person-badge"></i>
                                            }
                                        </div>
                                        <div class="role-info">
                                            <span class="role-name">@rol</span>
                                            <span class="role-desc">@GetRoleDescription(rol)</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="no-roles">
                                <i class="bi bi-shield-exclamation"></i>
                                <p>Este usuario no tiene roles asignados</p>
                            </div>
                        }
                    </div>
                </div>

                <!-- Tarjeta de Estado de la Cuenta -->
                <div class="info-card">
                    <div class="info-card-header">
                        <i class="bi bi-clock-history"></i>
                        <h4>Estado de la Cuenta</h4>
                    </div>
                    <div class="info-card-body">
                        <div class="activity-timeline">
                            <div class="activity-item">
                                <div class="activity-dot" style="background: @(usuario.EmailConfirmed ? "var(--success)" : "var(--warning)");"></div>
                                <div class="activity-content">
                                    <span class="activity-text">
                                        @(usuario.EmailConfirmed ? "Email confirmado" : "Email pendiente de confirmación")
                                    </span>
                                </div>
                            </div>
                            <div class="activity-item">
                                <div class="activity-dot" style="background: @(usuario.Activo ? "var(--success)" : "var(--danger)");"></div>
                                <div class="activity-content">
                                    <span class="activity-text">
                                        Cuenta @(usuario.Activo ? "activa" : "inactiva")
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal Eliminar -->
@if (mostrarModalEliminar && usuario != null)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(5px);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Confirmar eliminación</h5>
                    <button class="btn-close-custom" @onclick="CerrarModal">
                        <i class="bi bi-x"></i>
                    </button>
                </div>
                <div class="modal-body text-center p-4">
                    <div class="rounded-circle bg-danger bg-opacity-10 d-flex align-items-center justify-content-center mx-auto mb-4"
                         style="width: 80px; height: 80px;">
                        <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 2.5rem;"></i>
                    </div>
                    
                    <h5 class="fw-bold mb-3">¿Eliminar usuario?</h5>
                    <p class="text-muted mb-4">
                        Estás a punto de eliminar a 
                        <span class="fw-bold text-dark">@usuario.NombreCompleto</span>
                        <br>Esta acción no se puede deshacer.
                    </p>
                </div>
                <div class="modal-footer justify-content-center border-0 pb-4">
                    <button class="btn btn-light px-5 py-2 rounded-3" @onclick="CerrarModal">
                        Cancelar
                    </button>
                    <button class="btn btn-danger px-5 py-2 rounded-3" @onclick="EliminarUsuario">
                        <i class="bi bi-trash3 me-2"></i>
                        Eliminar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal Cargando -->
@if (mostrarModalCargando)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(5px);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-body text-center p-5">
                    <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;"></div>
                    <h5 class="fw-bold mb-2">@mensajeCargando</h5>
                    <p class="text-muted mb-0">Por favor espere...</p>
                </div>
            </div>
        </div>
    </div>
}

<!-- Toasts para notificaciones -->
@if (!string.IsNullOrEmpty(mensajeExito))
{
    <div class="toast-notification toast-success">
        <i class="bi bi-check-circle-fill"></i>
        <span>@mensajeExito</span>
    </div>
}

@if (!string.IsNullOrEmpty(error))
{
    <div class="toast-notification toast-error">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span>@error</span>
    </div>
}

@code {
    [Parameter]
    public string UserId { get; set; } = string.Empty;

    private ApplicationUser? usuario;
    private List<string> rolesUsuario = new();
    private bool cargandoInicial = true;
    private bool mostrarModalEliminar;
    private bool mostrarModalCargando;
    private string? error;
    private string? mensajeExito;
    private string mensajeCargando = "";

    protected override async Task OnParametersSetAsync()
    {
        await CargarUsuario();
    }

    private async Task CargarUsuario()
    {
        cargandoInicial = true;
        error = null;

        try
        {
            usuario = await UserManager.FindByIdAsync(UserId);
            
            if (usuario != null)
            {
                var roles = await UserManager.GetRolesAsync(usuario);
                rolesUsuario = roles.ToList();
            }
        }
        catch (Exception ex)
        {
            error = $"Error al cargar el usuario: {ex.Message}";
        }
        finally
        {
            cargandoInicial = false;
        }
    }

    private string GetGradientStart()
    {
        var rol = rolesUsuario.FirstOrDefault() ?? "";
        return rol switch
        {
            "SuperAdministrador" => "#7c3aed",
            "Administrador" => "#1e293b",
            "Gerente" => "#0891b2",
            "Vendedor" => "#059669",
            _ => "#667eea"
        };
    }

    private string GetGradientEnd()
    {
        var rol = rolesUsuario.FirstOrDefault() ?? "";
        return rol switch
        {
            "SuperAdministrador" => "#5b21b6",
            "Administrador" => "#0f172a",
            "Gerente" => "#0e7490",
            "Vendedor" => "#047857",
            _ => "#764ba2"
        };
    }

    private string GetRoleColor(string rol)
    {
        return rol switch
        {
            "SuperAdministrador" => "linear-gradient(135deg, #7c3aed, #5b21b6)",
            "Administrador" => "linear-gradient(135deg, #1e293b, #0f172a)",
            "Gerente" => "linear-gradient(135deg, #0891b2, #0e7490)",
            "Vendedor" => "linear-gradient(135deg, #059669, #047857)",
            _ => "linear-gradient(135deg, #64748b, #475569)"
        };
    }

    private string GetRoleDescription(string rol)
    {
        return rol switch
        {
            "SuperAdministrador" => "Control total del sistema, todos los permisos",
            "Administrador" => "Administración por sucursal, puede crear usuarios",
            "Gerente" => "Supervisión, reportes, ver todo",
            "Vendedor" => "Registrar clientes y ver promociones",
            _ => "Acceso al sistema"
        };
    }

    private void EditarUsuario()
    {
        NavigationManager.NavigateTo($"/admin/usuarios/edit/{UserId}");
    }

    private async Task ToggleEstado()
    {
        if (usuario == null) return;

        try
        {
            mostrarModalCargando = true;
            mensajeCargando = "Actualizando estado...";
            StateHasChanged();

            usuario.Activo = !usuario.Activo;
            var result = await UserManager.UpdateAsync(usuario);

            if (result.Succeeded)
            {
                mensajeExito = $"Usuario {(usuario.Activo ? "activado" : "desactivado")} correctamente";
                await CargarUsuario();
            }
            else
            {
                error = string.Join(", ", result.Errors.Select(e => e.Description));
            }
        }
        catch (Exception ex)
        {
            error = $"Error: {ex.Message}";
        }
        finally
        {
            mostrarModalCargando = false;
            StateHasChanged();
            await Task.Delay(2000);
            mensajeExito = null;
            error = null;
        }
    }

    private void ConfirmarEliminar()
    {
        mostrarModalEliminar = true;
    }

    private void CerrarModal()
    {
        mostrarModalEliminar = false;
    }

    private async Task EliminarUsuario()
    {
        if (usuario == null) return;

        try
        {
            mostrarModalCargando = true;
            mensajeCargando = "Eliminando usuario...";
            StateHasChanged();

            var result = await UserManager.DeleteAsync(usuario);

            if (result.Succeeded)
            {
                mostrarModalCargando = false;
                await Task.Delay(500);
                NavigationManager.NavigateTo("/admin/usuarios");
            }
            else
            {
                error = string.Join(", ", result.Errors.Select(e => e.Description));
            }
        }
        catch (Exception ex)
        {
            error = $"Error: {ex.Message}";
        }
        finally
        {
            mostrarModalCargando = false;
            CerrarModal();
            StateHasChanged();
        }
    }

    private void Volver()
    {
        NavigationManager.NavigateTo("/admin/usuarios");
    }
}
