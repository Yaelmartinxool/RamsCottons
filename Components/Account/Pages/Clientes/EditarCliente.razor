@page "/clientes/editar/{Id}"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using RamsCottons.Models
@using RamsCottons.Data
@using RamsCottons.Models.CycData
@using RamsCottons.Services
@using System.ComponentModel.DataAnnotations

@attribute [Authorize]

@inject ApplicationDbContext DbContext
@inject NavigationManager NavigationManager
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject WhatsAppService _whatsApp
@inject SucursalService SucursalService

<PageTitle>Editar Cliente | RAMS Cottons</PageTitle>

<div class="editar-cliente-container">
    <div class="dashboard-header">
        <div class="header-content">
            <div class="header-title">
                <div class="title-icon">
                    <i class="bi bi-pencil-fill"></i>
                </div>
                <div>
                    <h1>Editar Cliente</h1>
                    <p class="subtitle">Modifique la información del cliente</p>
                </div>
            </div>

            <button class="btn-back" @onclick="Volver">
                <span>Volver</span>
            </button>
        </div>
    </div>

    @if (cargando)
    {
        <div class="loading-container">
            <div class="spinner-border text-primary"></div>
            <p>Cargando información del cliente...</p>
        </div>
    }
    else if (cliente == null)
    {
        <div class="error-container">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <h3>Cliente no encontrado</h3>
            <p>El cliente que intentas editar no existe o ha sido eliminado.</p>
            <button class="btn-back" @onclick="Volver">Volver</button>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-8">
                <div class="form-card">
                    <div class="card-header">
                        <div class="header-left">
                            <i class="bi bi-pencil-square"></i>
                            <h3>Información del Cliente</h3>
                        </div>

                        <span class="required-badge">
                            * Campos obligatorios
                        </span>
                    </div>

                    <div class="card-body">
                        <EditForm Model="modelo"
                                  OnValidSubmit="GuardarCliente"
                                  FormName="editarCliente">

                            <DataAnnotationsValidator />
                            <ValidationSummary class="validation-summary" />

                            <div class="form-grid">

                                <div class="form-group full-width">
                                    <label class="form-label">
                                        Nombre Completo
                                        <span class="text-danger">*</span>
                                    </label>

                                    <div class="input-wrapper">
                                        <i class="bi bi-person input-icon"></i>

                                        <InputText @bind-Value="modelo.NombreCompleto"
                                                   class="form-control" />
                                    </div>

                                    <ValidationMessage For="() => modelo.NombreCompleto"
                                                       class="validation-message" />
                                </div>

                                <div class="form-group">
                                    <label class="form-label">
                                        Teléfono
                                        <span class="text-danger">*</span>
                                    </label>

                                    <div class="input-wrapper">
                                        <i class="bi bi-telephone input-icon"></i>

                                        <InputText @bind-Value="modelo.Telefono"
                                                   class="form-control" />
                                    </div>

                                    <ValidationMessage For="() => modelo.Telefono"
                                                       class="validation-message" />
                                </div>

                                <div class="form-group">
                                    <label class="form-label">
                                        Correo Electrónico
                                    </label>

                                    <div class="input-wrapper">
                                        <i class="bi bi-envelope input-icon"></i>

                                        <input type="text"
                                               @bind="modelo.Correo"
                                               class="form-control"
                                               placeholder="correo@ejemplo.com" />
                                    </div>
                                </div>

                                <div class="form-group full-width">
                                    <label class="form-label">
                                        Categoría
                                    </label>

                                    <div class="input-wrapper">
                                        <i class="bi bi-tags input-icon"></i>

                                        <select @bind="modelo.IdCategoriaProducto"
                                                class="form-control">

                                            <option value="">
                                                Seleccione una categoría
                                            </option>

                                            @foreach (var cat in categorias)
                                            {
                                                <option value="@cat.IdCategoria">
                                                    @cat.NombreCat
                                                </option>
                                            }

                                        </select>
                                    </div>
                                </div>

                                <div class="form-group full-width">
                                    <label class="form-label">
                                        Tipo de Cliente
                                    </label>

                                    <div class="input-wrapper">
                                        <i class="bi bi-diagram-3 input-icon"></i>

                                        <select @bind="modelo.TipoCliente"
                                                class="form-control">

                                            <option value="">
                                                Seleccione una opción
                                            </option>

                                            @foreach (var tipo in tiposCliente)
                                            {
                                                <option value="@tipo.Nombre">
                                                    @tipo.Nombre
                                                </option>
                                            }

                                        </select>
                                    </div>
                                </div>

                                <div class="form-group full-width">
                                    <label class="form-label">
                                        Sucursal
                                        <span class="text-danger">*</span>
                                    </label>

                                    <div class="sucursal-search-wrapper @(errorSucursal ? "has-error" : "")">

                                        <i class="bi bi-shop"></i>

                                        <input type="text"
                                               class="sucursal-search-input"
                                               placeholder="Busca y selecciona una sucursal..."
                                               @bind="busquedaSucursal"
                                               @bind:event="oninput"
                                               @onfocus="AbrirDropdownSucursal" />

                                        <i class="bi bi-chevron-down sucursal-search-arrow @(mostrarDropdownSucursal ? "rotated" : "")"></i>

                                        @if (mostrarDropdownSucursal)
                                        {
                                            <div class="sucursal-dropdown">

                                                @if (sucursalesFiltradas.Any())
                                                {
                                                    @foreach (var sucursal in sucursalesFiltradas)
                                                    {
                                                        <div class="sucursal-dropdown-item @(selectedSucursal == sucursal.Almacen ? "selected" : "")"
                                                             @onmousedown:preventDefault
                                                             @onclick="() => SeleccionarSucursal(sucursal)">

                                                            <span class="sucursal-almacen">
                                                                @sucursal.Almacen
                                                            </span>

                                                            <span class="sucursal-nombre">
                                                                @sucursal.NombreCompleto
                                                            </span>

                                                        </div>
                                                    }
                                                }
                                                else
                                                {
                                                    <div class="sucursal-dropdown-empty">
                                                        <i class="bi bi-search"></i>
                                                        No se encontraron sucursales
                                                    </div>
                                                }

                                            </div>
                                        }
                                    </div>

                                    @if (errorSucursal)
                                    {
                                        <div class="validation-message"
                                             style="margin-top: 0.25rem;">

                                            <i class="bi bi-exclamation-circle-fill me-1"></i>
                                            @mensajeErrorSucursal

                                        </div>
                                    }
                                </div>

                                <div class="form-group full-width">
                                    <div class="form-check">

                                        <InputCheckbox @bind-Value="modelo.AceptaWhatsApp"
                                                       id="aceptaWhatsApp"
                                                       class="form-check-input" />

                                        <label class="form-check-label"
                                               for="aceptaWhatsApp">

                                            <i class="bi bi-whatsapp text-success"></i>
                                            Acepta recibir promociones por WhatsApp

                                        </label>

                                        <small class="form-text text-muted d-block mt-1">
                                            Si el cliente no acepta, no podrá recibir promociones por WhatsApp
                                        </small>

                                    </div>
                                </div>

                                <div class="form-group full-width">
                                    <label class="form-label">
                                        Estado
                                    </label>

                                    <div class="status-toggle">

                                        <label class="toggle-switch">
                                            <InputCheckbox @bind-Value="modelo.Estado" />
                                            <span class="toggle-slider"></span>
                                        </label>

                                        <span class="status-text">
                                            @(modelo.Estado ? "Activo" : "Inactivo")
                                        </span>

                                    </div>
                                </div>

                                <div class="info-message full-width">
                                    <i class="bi bi-info-circle-fill"></i>

                                    <span>
                                        <strong>Nota:</strong>
                                        Al cambiar el teléfono, asegúrate de que no esté registrado en otro cliente.
                                    </span>
                                </div>

                                <div class="form-actions full-width">

                                    <button type="submit"
                                            class="btn-submit"
                                            disabled="@guardando">

                                        @(guardando ? "Guardando..." : "Guardar Cambios")

                                    </button>

                                    <button type="button"
                                            class="btn-cancel"
                                            @onclick="Volver">

                                        Cancelar

                                    </button>

                                </div>

                            </div>

                        </EditForm>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">

                <div class="info-card">

                    <div class="info-card-header">
                        <i class="bi bi-person-badge"></i>
                        <h4>Información del Cliente</h4>
                    </div>

                    <div class="info-card-body">

                        <div class="info-item">
                            <span class="info-label">
                                ID:
                            </span>

                            <span class="info-value">
                                CL-@cliente.Id
                            </span>
                        </div>

                        <div class="info-item">
                            <span class="info-label">
                                Fecha registro:
                            </span>

                            <span class="info-value">
                                @cliente.FechaRegistro.ToString("dd/MM/yyyy")
                            </span>
                        </div>

                        <div class="info-item">
                            <span class="info-label">
                                Registrado por:
                            </span>

                            <span class="info-value">
                                @cliente.IdUsuario
                            </span>
                        </div>

                        <div class="info-item">
                            <span class="info-label">
                                Origen:
                            </span>

                            <span class="info-value">

                                @if (!string.IsNullOrEmpty(cliente.TipoCliente))
                                {
                                    <span class="origen-badge">
                                        @cliente.TipoCliente
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        No definido
                                    </span>
                                }

                            </span>
                        </div>

                    </div>
                </div>

                <div class="tip-card">

                    <i class="bi bi-lightbulb"></i>

                    <div>
                        <h5>Consejo de Edición</h5>

                        <p>
                            Al cambiar el teléfono, verifica que no exista otro cliente
                            con el mismo número para evitar duplicados.
                        </p>
                    </div>

                </div>

            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(mensajeExito))
    {
        <div class="toast-notification toast-success">
            <i class="bi bi-check-circle-fill"></i>
            <span>@mensajeExito</span>
        </div>
    }

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="toast-notification toast-error">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>@error</span>
        </div>
    }
</div>

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private int ClienteId =>
        int.TryParse(Id, out var id) ? id : 0;

    private Cliente? cliente;

    private List<CategoriaProducto> categorias = new();
    private List<TipoCliente> tiposCliente = new();
    private List<SucursalCyc> SucursalesDisponibles = new();

    private bool cargando = true;
    private bool guardando = false;

    private string? error;
    private string? mensajeExito;

    private ClienteModel modelo = new();

    private string? selectedSucursal = null;
    private string busquedaSucursal = "";
    private bool mostrarDropdownSucursal = false;
    private bool errorSucursal = false;
    private string mensajeErrorSucursal = "";

    private bool aceptaWhatsAppAnterior = false;

    private IEnumerable<SucursalCyc> sucursalesFiltradas =>
        string.IsNullOrWhiteSpace(busquedaSucursal)
            ? SucursalesDisponibles
            : SucursalesDisponibles.Where(s =>
                s.Almacen.Contains(
                    busquedaSucursal,
                    StringComparison.OrdinalIgnoreCase
                ) ||
                (
                    s.NombreCompleto != null &&
                    s.NombreCompleto.Contains(
                        busquedaSucursal,
                        StringComparison.OrdinalIgnoreCase
                    )
                )
            );

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        cargando = true;

        try
        {
            SucursalesDisponibles =
                SucursalService.GetAllSucursales();

            categorias = await DbContext
                .CategoriaProductos
                .ToListAsync();

            tiposCliente = await DbContext
                .TiposCliente
                .Where(t => t.Activo)
                .OrderBy(t => t.IdTipoCliente)
                .ToListAsync();

            cliente = await DbContext
                .Clientes
                .FirstOrDefaultAsync(c => c.Id == ClienteId);

            if (cliente != null)
            {
                modelo = new ClienteModel
                {
                    NombreCompleto = cliente.NombreCompleto,
                    Telefono = cliente.Telefono ?? "",
                    Correo = cliente.Correo,
                    IdCategoriaProducto = cliente.IdCategoriaProducto,
                    Estado = cliente.Estado == 1,
                    AceptaWhatsApp = cliente.AceptaWhatsApp,
                    TipoCliente = cliente.TipoCliente
                };

                aceptaWhatsAppAnterior =
                    cliente.AceptaWhatsApp;

                if (!string.IsNullOrEmpty(cliente.IdSucursal))
                {
                    selectedSucursal =
                        cliente.IdSucursal;

                    busquedaSucursal =
                        SucursalesDisponibles
                            .FirstOrDefault(
                                s => s.Almacen == cliente.IdSucursal
                            )?.NombreCompleto
                        ?? cliente.IdSucursal;
                }
            }
        }
        catch (Exception ex)
        {
            error =
                $"Error cargando datos: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private void AbrirDropdownSucursal()
    {
        mostrarDropdownSucursal = true;
    }

    private void SeleccionarSucursal(
        SucursalCyc sucursal
    )
    {
        selectedSucursal =
            sucursal.Almacen;

        busquedaSucursal =
            sucursal.NombreCompleto
            ?? sucursal.Almacen;

        mostrarDropdownSucursal = false;
        errorSucursal = false;
        mensajeErrorSucursal = "";
    }

    private async Task GuardarCliente()
    {
        if (cliente == null)
        {
            return;
        }

        guardando = true;

        error = null;
        mensajeExito = null;

        errorSucursal = false;
        mensajeErrorSucursal = "";

        StateHasChanged();

        try
        {
            if (string.IsNullOrEmpty(selectedSucursal))
            {
                error =
                    "Debes seleccionar una sucursal";

                errorSucursal = true;

                mensajeErrorSucursal =
                    "Debes seleccionar una sucursal";

                guardando = false;

                StateHasChanged();

                return;
            }

            var existe =
                await DbContext.Clientes.AnyAsync(
                    c =>
                        c.Telefono == modelo.Telefono &&
                        c.Id != ClienteId
                );

            if (existe)
            {
                error =
                    "Ya existe otro cliente con este número de teléfono.";

                guardando = false;

                StateHasChanged();

                return;
            }

            bool aceptaWhatsAppOriginal =
                cliente.AceptaWhatsApp;

            var correo =
                modelo.Correo;

            if (string.IsNullOrWhiteSpace(correo))
            {
                correo = null;
            }

            cliente.NombreCompleto =
                modelo.NombreCompleto;

            cliente.Telefono =
                modelo.Telefono;

            cliente.Correo =
                correo;

            cliente.IdCategoriaProducto =
                modelo.IdCategoriaProducto > 0
                    ? modelo.IdCategoriaProducto
                    : null;

            cliente.Estado =
                modelo.Estado ? 1 : 0;

            cliente.AceptaWhatsApp =
                modelo.AceptaWhatsApp;

            cliente.TipoCliente =
                modelo.TipoCliente;

            cliente.IdSucursal =
                selectedSucursal;

            await DbContext.SaveChangesAsync();

bool cambioAWhatsApp =
    modelo.AceptaWhatsApp &&
    !aceptaWhatsAppOriginal;

if (
    cambioAWhatsApp &&
    !string.IsNullOrEmpty(cliente.Telefono)
)
{
    try
    {
        var telefonoLimpio =
            cliente.Telefono
                .Replace(" ", "")
                .Replace("-", "")
                .Replace("+", "");

        if (!telefonoLimpio.StartsWith("52"))
        {
            telefonoLimpio =
                "52" + telefonoLimpio;
        }

        var primerNombre =
            cliente.NombreCompleto
                .Split(' ')[0];

        await _whatsApp.EnviarPlantillaConImagenAsync(
            numeroDestino: telefonoLimpio,
            nombrePlantilla: "bienvenida_rams_cliente",
            idioma: "es_MX",
            parametros: new Dictionary<string, string>
            {
                { "1", primerNombre }
            },
            imagenUrl: "https://rams.no-ip.info:8082/images/LogoRamsCottons.jpg"
        );
    }
    catch (Exception ex)
    {
        Console.WriteLine(
            $"Error al enviar mensaje de bienvenida: {ex.Message}"
        );
    }
}

            mensajeExito =
                $"Cliente {cliente.NombreCompleto} actualizado correctamente.";

            await Task.Delay(2000);

            NavigationManager.NavigateTo(
                "/clientes"
            );
        }
        catch (Exception ex)
        {
            error =
                $"Error inesperado: {ex.Message}";
        }
        finally
        {
            guardando = false;

            StateHasChanged();
        }
    }

    private void Volver()
    {
        NavigationManager.NavigateTo(
            "/clientes"
        );
    }

    private class ClienteModel
    {
        [Required(
            ErrorMessage =
                "El nombre completo es obligatorio"
        )]
        [StringLength(
            180,
            MinimumLength = 3,
            ErrorMessage =
                "El nombre debe tener entre 3 y 180 caracteres"
        )]
        public string NombreCompleto { get; set; } = "";

        [Required(
            ErrorMessage =
                "El teléfono es obligatorio"
        )]
        [RegularExpression(
            @"^[0-9+\s-]{8,20}$",
            ErrorMessage =
                "Formato de teléfono inválido"
        )]
        public string Telefono { get; set; } = "";

        public string? Correo { get; set; }

        public int? IdCategoriaProducto { get; set; }

        public bool Estado { get; set; } = true;

        public bool AceptaWhatsApp { get; set; } = false;

        public string? TipoCliente { get; set; }
    }
}