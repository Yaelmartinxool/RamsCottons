@page "/clientes/crear"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using RamsCottons.Models
@using RamsCottons.Data
@using RamsCottons.Models.CycData
@using RamsCottons.Services
@using System.ComponentModel.DataAnnotations

@attribute [Authorize]

@inject ApplicationDbContext DbContext
@inject NavigationManager NavigationManager
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject RoleManager<IdentityRole> RoleManager
@inject WhatsAppService _whatsApp
@inject SucursalService SucursalService
@inject PermisoService PermisoService

<PageTitle>Nuevo Cliente | RAMS Cottons</PageTitle>

@if (autorizado)
{
<div class="crear-cliente-container">
    <div class="dashboard-header">
        <div class="header-content">
            <div class="header-title">
                <div class="title-icon">
                    <i class="bi bi-person-plus-fill"></i>
                </div>
                <div>
                    <h1>Nuevo Cliente</h1>
                    <p class="subtitle">Registre un nuevo cliente en el sistema</p>
                </div>
            </div>

            <button class="btn-back" @onclick="Volver">
                <span>Volver</span>
            </button>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="form-card">
                <div class="card-header">
                    <div class="header-left">
                        <i class="bi bi-pencil-square"></i>
                        <h3>Información del Cliente</h3>
                    </div>

                    <span class="required-badge">
                        * Campos obligatorios
                    </span>
                </div>

                <div class="card-body">
                    <EditForm Model="modelo"
                              OnValidSubmit="GuardarCliente"
                              FormName="crearCliente">

                        <DataAnnotationsValidator />
                        <ValidationSummary class="validation-summary" />

                        <div class="form-grid">

                            <div class="form-group full-width">
                                <label class="form-label">
                                    Nombre Completo
                                    <span class="text-danger">*</span>
                                </label>

                                <div class="input-wrapper">
                                    <i class="bi bi-person input-icon"></i>

                                    <InputText @bind-Value="modelo.NombreCompleto"
                                               class="form-control"
                                               placeholder="Ej: Juan Carlos Perez" />
                                </div>

                                <ValidationMessage For="() => modelo.NombreCompleto"
                                                   class="validation-message" />
                            </div>

                            <div class="form-group">
                                <label class="form-label">
                                    Teléfono
                                    <span class="text-danger">*</span>
                                </label>

                                <div class="input-wrapper">
                                    <i class="bi bi-telephone input-icon"></i>

                                    <InputText @bind-Value="modelo.Telefono"
                                               class="form-control"
                                               placeholder="+521234567890" />
                                </div>

                                <ValidationMessage For="() => modelo.Telefono"
                                                   class="validation-message" />
                            </div>

                            <div class="form-group">
                                <label class="form-label">
                                    Correo Electrónico
                                </label>

                                <div class="input-wrapper">
                                    <i class="bi bi-envelope input-icon"></i>

                                    <InputText @bind-Value="modelo.Correo"
                                               class="form-control"
                                               placeholder="cliente@correo.com" />
                                </div>

                                <ValidationMessage For="() => modelo.Correo"
                                                   class="validation-message" />
                            </div>

                            <div class="form-group full-width">
                                <label class="form-label">
                                    Categoría
                                </label>

                                <div class="input-wrapper">
                                    <i class="bi bi-tags input-icon"></i>

                                    <select @bind="modelo.IdCategoriaProducto"
                                            class="form-control"
                                            disabled="@(!puedeAsignarCategoria)">

                                        <option value="">
                                            @(puedeAsignarCategoria
                                                ? "Seleccione una categoría"
                                                : "Sin permiso para asignar categoría")
                                        </option>

                                        @if (puedeAsignarCategoria)
                                        {
                                            @foreach (var cat in categorias)
                                            {
                                                <option value="@cat.IdCategoria">
                                                    @cat.NombreCat
                                                </option>
                                            }
                                        }

                                    </select>
                                </div>

                                @if (!puedeAsignarCategoria)
                                {
                                    <small class="form-text text-muted d-block mt-1">
                                        <i class="bi bi-lock-fill me-1"></i>
                                        No tienes permiso para asignar una categoría al cliente.
                                    </small>
                                }
                            </div>

                            <div class="form-group full-width">
                                <label class="form-label">
                                    Tipo de Cliente
                                </label>

                                <div class="input-wrapper">
                                    <i class="bi bi-diagram-3 input-icon"></i>

                                    <select @bind="modelo.TipoCliente"
                                            class="form-control">

                                        <option value="">
                                            Seleccione una opción
                                        </option>

                                        @foreach (var tipo in tiposCliente)
                                        {
                                            <option value="@tipo.Nombre">
                                                @tipo.Nombre
                                            </option>
                                        }

                                    </select>
                                </div>
                            </div>

                            <div class="form-group full-width">
                                <label class="form-label">
                                    Sucursal
                                    <span class="text-danger">*</span>
                                </label>

                                <div class="sucursal-search-wrapper @(errorSucursal ? "has-error" : "")">

                                    <i class="bi bi-shop sucursal-search-icon"></i>

                                    <input type="text"
                                           class="sucursal-search-input"
                                           placeholder="Busca y selecciona una sucursal..."
                                           @bind="busquedaSucursal"
                                           @bind:event="oninput"
                                           @onfocus="AbrirDropdownSucursal" />

                                    <i class="bi bi-chevron-down sucursal-search-arrow @(mostrarDropdownSucursal ? "rotated" : "")"
   style="cursor:pointer;"
   @onclick="ToggleDropdownSucursal"></i>

                                    @if (mostrarDropdownSucursal)
                                    {
                                        <div class="sucursal-dropdown">

    <div class="sucursal-dropdown-item cerrar-lista"
         @onmousedown:preventDefault
         @onclick="CerrarDropdownSucursal">

        <span class="sucursal-almacen">
            <i class="bi bi-x-circle"></i>
        </span>

        <span class="sucursal-nombre">
            Cerrar lista
        </span>

    </div>

                                            @if (sucursalesFiltradas.Any())
                                            {
                                                @foreach (var sucursal in sucursalesFiltradas)
                                                {
                                                    <div class="sucursal-dropdown-item @(selectedSucursal == sucursal.Almacen ? "selected" : "")"
                                                         @onmousedown:preventDefault
                                                         @onclick="() => SeleccionarSucursal(sucursal)">

                                                        <span class="sucursal-almacen">
                                                            @sucursal.Almacen
                                                        </span>

                                                        <span class="sucursal-nombre">
                                                            @sucursal.NombreCompleto
                                                        </span>

                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <div class="sucursal-dropdown-empty">
                                                    <i class="bi bi-search"></i>
                                                    No se encontraron sucursales
                                                </div>
                                            }

                                        </div>
                                    }

                                </div>

                                @if (errorSucursal)
                                {
                                    <div class="validation-message"
                                         style="margin-top: 0.25rem;">

                                        <i class="bi bi-exclamation-circle-fill me-1"></i>
                                        @mensajeErrorSucursal

                                    </div>
                                }
                            </div>

                            <div class="form-group full-width">
                                <div class="form-check">

                                    <InputCheckbox @bind-Value="modelo.AceptaWhatsApp"
                                                   id="aceptaWhatsApp"
                                                   class="form-check-input" />

                                    <label class="form-check-label"
                                           for="aceptaWhatsApp">

                                        <i class="bi bi-whatsapp text-success"></i>
                                        Acepta recibir promociones por WhatsApp

                                    </label>

                                    <small class="form-text text-muted d-block mt-1">
                                        Si el cliente no acepta, no podrá recibir promociones por WhatsApp
                                    </small>

                                </div>
                            </div>

                            <div class="info-message full-width">
                                <i class="bi bi-info-circle-fill"></i>

                                <span>
                                    <strong>Nota:</strong>
                                    El cliente quedará registrado con estado activo.
                                    Puedes generar su código QR después.
                                </span>
                            </div>

                            <div class="form-actions full-width">

                                <button type="submit"
                                        class="btn-submit"
                                        disabled="@guardando">

                                    @(guardando ? "Guardando..." : "Guardar Cliente")

                                </button>

                                <button type="button"
                                        class="btn-cancel"
                                        @onclick="Volver">

                                    Cancelar

                                </button>

                            </div>

                        </div>

                    </EditForm>
                </div>
            </div>
        </div>

        <div class="col-lg-4">

            <div class="info-card">

                <div class="info-card-header">
                    <i class="bi bi-diagram-3"></i>
                    <h4>Proceso de Registro</h4>
                </div>

                <div class="info-card-body">

                    <div class="process-step">
                        <div class="step-number">1</div>
                        <div class="step-text">
                            Completa el formulario con los datos del cliente
                        </div>
                    </div>

                    <div class="process-step">
                        <div class="step-number">2</div>
                        <div class="step-text">
                            El sistema valida la información
                        </div>
                    </div>

                    <div class="process-step">
                        <div class="step-number">3</div>
                        <div class="step-text">
                            El cliente queda registrado en la base de datos
                        </div>
                    </div>

                    <div class="process-step">
                        <div class="step-number">4</div>
                        <div class="step-text">
                            Genera el código QR para el cliente
                        </div>
                    </div>

                </div>
            </div>

            <div class="tip-card">

                <i class="bi bi-lightbulb"></i>

                <div>
                    <h5>Consejo de Registro</h5>

                    <p>
                        Utiliza un teléfono válido y un correo electrónico real
                        para que el cliente pueda recibir sus promociones y código QR.
                    </p>
                </div>

            </div>

        </div>
    </div>

    @if (!string.IsNullOrEmpty(mensajeExito))
    {
        <div class="toast-notification toast-success">

            <i class="bi bi-check-circle-fill"></i>
            <span>@mensajeExito</span>

        </div>
    }

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="toast-notification toast-error">

            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>@error</span>

        </div>
    }

</div>

}

<style>
.cerrar-lista {
    font-weight: 600;
    border-bottom: 1px solid #e5e7eb;
}

.cerrar-lista:hover {
    background: #f8fafc;
}
</style>

@code {
    private List<CategoriaProducto> categorias = new();
    private List<TipoCliente> tiposCliente = new();
    private List<SucursalCyc> SucursalesDisponibles = new();

    private bool autorizado = false;
    private bool puedeAsignarCategoria = false;
    private bool guardando = false;
    private string? error;
    private string? mensajeExito;
    private ClienteModel modelo = new();

    private string? selectedSucursal = null;
    private string busquedaSucursal = "";
    private bool mostrarDropdownSucursal = false;
    private bool errorSucursal = false;
    private string mensajeErrorSucursal = "";

    private IEnumerable<SucursalCyc> sucursalesFiltradas =>
        string.IsNullOrWhiteSpace(busquedaSucursal)
            ? SucursalesDisponibles
            : SucursalesDisponibles.Where(s =>
                s.Almacen.Contains(
                    busquedaSucursal,
                    StringComparison.OrdinalIgnoreCase
                ) ||
                (
                    s.NombreCompleto != null &&
                    s.NombreCompleto.Contains(
                        busquedaSucursal,
                        StringComparison.OrdinalIgnoreCase
                    )
                )
            );

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        var tienePermiso = await PermisoService.TienePermisoAsync(
            user,
            Permissions.Clientes_Crear
        );

        if (!tienePermiso)
        {
            NavigationManager.NavigateTo("/clientes", true);
            return;
        }

        puedeAsignarCategoria = await PermisoService.TienePermisoAsync(
            user,
            Permissions.Clientes_AsignarCategoria
        );

        autorizado = true;
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        if (puedeAsignarCategoria)
        {
            await CargarCategorias();
        }
        else
        {
            categorias.Clear();
            modelo.IdCategoriaProducto = null;
        }

        await CargarTiposCliente();

        SucursalesDisponibles =
            SucursalService.GetAllSucursales();
    }

    private async Task CargarCategorias()
    {
        try
        {
            categorias = await DbContext
                .CategoriaProductos
                .ToListAsync();
        }
        catch (Exception ex)
        {
            error =
                $"Error cargando categorías: {ex.Message}";
        }
    }

    private async Task CargarTiposCliente()
    {
        try
        {
            tiposCliente = await DbContext
                .TiposCliente
                .Where(t => t.Activo)
                .OrderBy(t => t.IdTipoCliente)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            error =
                $"Error cargando tipos de cliente: {ex.Message}";
        }
    }

    private void AbrirDropdownSucursal()
    {
        mostrarDropdownSucursal = true;
    }

    private void CerrarDropdownSucursal()
    {
        mostrarDropdownSucursal = false;
    }

    private void ToggleDropdownSucursal()
    {
        mostrarDropdownSucursal = !mostrarDropdownSucursal;
    }

    private void SeleccionarSucursal(
        SucursalCyc sucursal
    )
    {
        selectedSucursal = sucursal.Almacen;

        busquedaSucursal =
            sucursal.NombreCompleto ??
            sucursal.Almacen;

        mostrarDropdownSucursal = false;
        errorSucursal = false;
        mensajeErrorSucursal = "";
    }

    private async Task GuardarCliente()
    {
        var authStatePermiso = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userPermiso = authStatePermiso.User;

        var tienePermiso = await PermisoService.TienePermisoAsync(
            userPermiso,
            Permissions.Clientes_Crear
        );

        if (!tienePermiso)
        {
            NavigationManager.NavigateTo("/clientes", true);
            return;
        }

        var puedeAsignarCategoriaGuardar =
            await PermisoService.TienePermisoAsync(
                userPermiso,
                Permissions.Clientes_AsignarCategoria
            );

        if (!puedeAsignarCategoriaGuardar)
        {
            modelo.IdCategoriaProducto = null;
        }

        guardando = true;

        error = null;
        mensajeExito = null;

        errorSucursal = false;
        mensajeErrorSucursal = "";

        StateHasChanged();

        try
        {
            if (string.IsNullOrEmpty(selectedSucursal))
            {
                error =
                    "Debes seleccionar una sucursal";

                errorSucursal = true;

                mensajeErrorSucursal =
                    "Debes seleccionar una sucursal";

                guardando = false;

                StateHasChanged();

                return;
            }

            var authState =
                await AuthenticationStateProvider
                    .GetAuthenticationStateAsync();

            var user =
                authState.User;

            var usuario =
                await UserManager
                    .GetUserAsync(user);

            if (usuario == null)
            {
                error =
                    "No se pudo identificar al usuario actual.";

                guardando = false;

                StateHasChanged();

                return;
            }

            var existe =
                await DbContext.Clientes.AnyAsync(
                    c => c.Telefono == modelo.Telefono
                );

            if (existe)
            {
                error =
                    "Ya existe un cliente con este número de teléfono.";

                guardando = false;

                StateHasChanged();

                return;
            }

            var cliente = new Cliente
            {
                NombreCompleto = modelo.NombreCompleto,
                Telefono = modelo.Telefono,
                Correo = modelo.Correo,
                IdUsuario = usuario.Id,
                IdSucursal = selectedSucursal,

                IdCategoriaProducto =
                    puedeAsignarCategoriaGuardar &&
                    modelo.IdCategoriaProducto > 0
                        ? modelo.IdCategoriaProducto
                        : null,

                FechaRegistro = DateTime.Now,
                Estado = 1,
                AceptaWhatsApp = modelo.AceptaWhatsApp,
                TipoCliente = modelo.TipoCliente
            };

            DbContext.Clientes.Add(cliente);

            await DbContext.SaveChangesAsync();

           if (
    cliente.AceptaWhatsApp &&
    !string.IsNullOrEmpty(cliente.Telefono)
)
{
    try
    {
        var telefonoLimpio =
            cliente.Telefono
                .Replace(" ", "")
                .Replace("-", "")
                .Replace("+", "");

        if (!telefonoLimpio.StartsWith("52"))
        {
            telefonoLimpio = "52" + telefonoLimpio;
        }

        var primerNombre =
            cliente.NombreCompleto
                .Split(' ')[0];

        await _whatsApp.EnviarPlantillaConImagenAsync(
    numeroDestino: telefonoLimpio,
    nombrePlantilla: "bienvenida_rams_cliente",
    idioma: "es_MX",
    parametros: new Dictionary<string, string>
    {
        { "1", primerNombre }
    },
    imagenUrl: "https://rams.no-ip.info:8082/images/LogoRamsCottons.jpg"
);
    }
    catch (Exception ex)
    {
        Console.WriteLine(
            $"Error al enviar mensaje de bienvenida: {ex.Message}"
        );
    }
}

            mensajeExito =
                $"Cliente {modelo.NombreCompleto} registrado correctamente.";

            await Task.Delay(2000);

            NavigationManager.NavigateTo(
                "/clientes"
            );
        }
        catch (Exception ex)
        {
            error =
                $"Error inesperado: {ex.Message}";
        }
        finally
        {
            guardando = false;

            StateHasChanged();
        }
    }

    private void Volver()
    {
        NavigationManager.NavigateTo(
            "/clientes"
        );
    }

    private class ClienteModel
    {
        [Required(
            ErrorMessage =
                "El nombre completo es obligatorio"
        )]
        [StringLength(
            180,
            MinimumLength = 3,
            ErrorMessage =
                "El nombre debe tener entre 3 y 180 caracteres"
        )]
        public string NombreCompleto { get; set; } = "";

        [Required(
            ErrorMessage =
                "El teléfono es obligatorio"
        )]
        [RegularExpression(
            @"^[0-9+\s-]{8,20}$",
            ErrorMessage =
                "Formato de teléfono inválido"
        )]
        public string Telefono { get; set; } = "";

        [EmailAddress(
            ErrorMessage =
                "Formato de correo inválido"
        )]
        public string? Correo { get; set; }

        public int? IdCategoriaProducto { get; set; }

        public bool AceptaWhatsApp { get; set; } = false;

        public string? TipoCliente { get; set; }
    }
}