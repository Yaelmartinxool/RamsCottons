@page "/clientes/ver/{Id}"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using RamsCottons.Models
@using RamsCottons.Data
@using RamsCottons.Models.CycData
@using RamsCottons.Services


@attribute [Authorize]

@inject ApplicationDbContext DbContext
@inject NavigationManager NavigationManager
@inject SucursalService SucursalService
@inject UserManager<ApplicationUser> UserManager

<PageTitle>Detalles del Cliente | RAMS Cottons</PageTitle>

<div class="ver-cliente-container">
    <br>
    <!-- Header -->
    <div class="dashboard-header">
        <div class="header-content">
            <div class="header-title">
                <div class="title-icon">
                    <i class="bi bi-eye-fill"></i>
                </div>
                <div>
                    <h1>Detalles del Cliente</h1>
                    <p class="subtitle">Informacion completa del cliente</p>
                </div>
            </div>
            <button class="btn-back" @onclick="Volver">
                <span>Volver</span>
            </button>
        </div>
    </div>

    @if (cargando)
    {
        <div class="loading-container">
            <div class="spinner-border text-primary"></div>
            <p>Cargando informacion...</p>
        </div>
    }
    else if (cliente == null)
    {
        <div class="error-container">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <h3>Cliente no encontrado</h3>
            <p>El cliente que buscas no existe o ha sido eliminado.</p>
            <button class="btn-back" @onclick="Volver">Volver</button>
        </div>
    }
    else
    {
        <div class="row">
            <!-- Columna Principal -->
            <div class="col-lg-12">
                <!-- Tarjeta de Perfil -->
                <div class="profile-card">
                    <div class="profile-header" style="background: linear-gradient(135deg, #0f172a, #2d2d2d)">
                        <div class="profile-avatar">
                            @cliente.NombreCompleto.Substring(0,1).ToUpper()
                        </div>
                        <div class="profile-info">
                            <h2>@cliente.NombreCompleto</h2>
                            <p>ID: CL-@cliente.Id</p>
                        </div>
                        <div class="profile-status @(cliente.Estado == 1 ? "status-active" : "status-inactive")">
                            <i class="bi @(cliente.Estado == 1 ? "bi-check-circle-fill" : "bi-x-circle-fill")"></i>
                            @(cliente.Estado == 1 ? "Activo" : "Inactivo")
                        </div>
                    </div>
                </div>

                <!-- Tarjeta de Informacion Personal -->
                <div class="info-card">
                    <div class="info-card-header">
                        <i class="bi bi-person-badge"></i>
                        <h4>Informacion Personal</h4>
                    </div>
                    <div class="info-card-body">
                        <div class="info-grid">
                            <div class="info-item">
                                <div class="info-icon" style="background: rgba(59, 130, 246, 0.1);">
                                    <i class="bi bi-telephone-fill"></i>
                                </div>
                                <div class="info-content">
                                    <span class="info-label">Telefono</span>
                                    <span class="info-value">@cliente.Telefono</span>
                                </div>
                            </div>

                            <div class="info-item">
                                <div class="info-icon" style="background: rgba(16, 185, 129, 0.1);">
                                    <i class="bi bi-envelope-fill"></i>
                                </div>
                                <div class="info-content">
                                    <span class="info-label">Correo Electronico</span>
                                    <span class="info-value">@(string.IsNullOrEmpty(cliente.Correo) ? "No registrado" : cliente.Correo)</span>
                                </div>
                            </div>

                            <div class="info-item">
                                <div class="info-icon" style="background: rgba(245, 158, 11, 0.1);">
                                    <i class="bi bi-tags-fill"></i>
                                </div>
                                <div class="info-content">
                                    <span class="info-label">Categoria</span>
                                    <span class="info-value">
                                        @{
                                            var categoria = categorias.FirstOrDefault(c => c.IdCategoria == cliente.IdCategoriaProducto);
                                        }
                                        @(categoria != null ? categoria.NombreCat : "Sin categoria")
                                    </span>
                                </div>
                            </div>

                            <!-- NUEVO: Tipo de Cliente -->
                            <div class="info-item">
                                <div class="info-icon" style="background: rgba(139, 92, 246, 0.1);">
                                    <i class="bi bi-diagram-3-fill"></i>
                                </div>
                                <div class="info-content">
                                    <span class="info-label">Tipo de Cliente</span>
                                    <span class="info-value">
                                        @if (!string.IsNullOrEmpty(cliente.TipoCliente))
                                        {
                                            <span class="origen-badge @(cliente.TipoCliente == "Redes Sociales" ? "origen-redes" : cliente.TipoCliente == "Pagina web" ? "origen-web" : "origen-mayoreo")">
                                                @cliente.TipoCliente
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">No definido</span>
                                        }
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tarjeta de Informacion de Registro -->
                <div class="info-card">
                    <div class="info-card-header">
                        <i class="bi bi-clock-history"></i>
                        <h4>Informacion de Registro</h4>
                    </div>
                    <div class="info-card-body">
                        <div class="info-grid">
                            <div class="info-item">
                                <div class="info-icon" style="background: rgba(139, 92, 246, 0.1);">
                                    <i class="bi bi-calendar3"></i>
                                </div>
                                <div class="info-content">
                                    <span class="info-label">Fecha de Registro</span>
                                    <span class="info-value">@cliente.FechaRegistro.ToString("dddd, dd MMMM yyyy")</span>
                                </div>
                            </div>

                            <div class="info-item">
                                <div class="info-icon" style="background: rgba(236, 72, 153, 0.1);">
                                    <i class="bi bi-person"></i>
                                </div>
                                <div class="info-content">
                                    <span class="info-label">Registrado por</span>
                                    <span class="info-value">@nombreCreador</span>
                                </div>
                            </div>

                            <div class="info-item">
                                <div class="info-icon" style="background: rgba(20, 184, 166, 0.1);">
                                    <i class="bi bi-building"></i>
                                </div>
                                <div class="info-content">
                                    <span class="info-label">Sucursal</span>
                                    <span class="info-value">@GetSucursalNombre(cliente.IdSucursal)</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private int ClienteId => int.TryParse(Id, out var id) ? id : 0;
    private string nombreCreador = "No disponible";
    private Cliente? cliente;
    private List<CategoriaProducto> categorias = new();
    private bool cargando = true;
    private Dictionary<string, string> SucursalesCache = new();

    protected override async Task OnInitializedAsync()
    {
        CargarSucursales();
        await CargarDatos();
    }

    private void CargarSucursales()
    {
        try
        {
            var sucursales = SucursalService.GetAllSucursales();
            SucursalesCache = sucursales.ToDictionary(s => s.Almacen, s => s.NombreCompleto);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando sucursales: {ex.Message}");
        }
    }

   private async Task CargarDatos()
{
    cargando = true;
    try
    {
        cliente = await DbContext.Clientes.FirstOrDefaultAsync(c => c.Id == ClienteId);
        categorias = await DbContext.CategoriaProductos.ToListAsync();

        // NUEVO: Cargar nombre del creador
        if (cliente != null && !string.IsNullOrEmpty(cliente.IdUsuario))
        {
            var usuario = await UserManager.FindByIdAsync(cliente.IdUsuario);
            if (usuario != null)
            {
                nombreCreador = usuario.NombreCompleto ?? usuario.Email ?? "No disponible";
            }
        }
    }
    catch (Exception ex)
    {
        Console.WriteLine($"Error: {ex.Message}");
    }
    finally
    {
        cargando = false;
    }
}
    private string GetSucursalNombre(string? almacen)
    {
        if (string.IsNullOrEmpty(almacen))
            return "Sin sucursal";

        if (SucursalesCache.TryGetValue(almacen, out var nombre))
            return nombre;

        return almacen;
    }

    private void Volver()
    {
        NavigationManager.NavigateTo("/clientes");
    }
}