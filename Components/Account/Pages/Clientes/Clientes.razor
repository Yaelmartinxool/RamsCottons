    private async Task EliminarCliente()
    {
        if (clienteEliminar == null) return;

        try
        {
            var nombreCliente = clienteEliminar.NombreCompleto;
            DbContext.Clientes.Remove(clienteEliminar);
            await DbContext.SaveChangesAsync();

            await CargarClientes();
            await MostrarNotificacionExito($"Cliente {nombreCliente} eliminado correctamente");
        }
        catch (Exception ex)
        {
            await MostrarNotificacionError($"Error al eliminar cliente: {ex.Message}");
        }
        finally
        {
            CerrarModalEliminar();
        }
    }

    private string GetCategoriaClass(string? categoria)
    {
        return categoria?.ToLower() switch
        {
            "ropa" => "categoria-ropa",
            "promocion" => "categoria-promocion",
            "calzado" => "categoria-calzado",
            "accesorios" => "categoria-accesorios",
            _ => "categoria-default"
        };
    }
