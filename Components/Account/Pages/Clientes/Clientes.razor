private string GetOrigenClass(string? tipoCliente)
{
    if (string.IsNullOrWhiteSpace(tipoCliente))
        return "origen-sin";

    return tipoCliente.Trim().ToLowerInvariant() switch
    {
        "redes sociales" => "origen-redes",
        "página web" => "origen-web",
        "pagina web" => "origen-web",
        "mayoreo" => "origen-mayoreo",
        "clientes de tiendas" => "origen-tiendas",
        _ => "origen-sin"
    };
}
    private void CargarSucursalesDisponibles()
    {
        SucursalesDisponibles = SucursalService.GetAllSucursales();
        SucursalesCache = SucursalesDisponibles.ToDictionary(s => s.Almacen, s => s.NombreCompleto);
    }

    private string GetSucursalNombre(string? almacen)
    {
        if (string.IsNullOrEmpty(almacen))
            return "Sin sucursal";

        if (SucursalesCache.TryGetValue(almacen, out var nombre))
            return nombre;

        return almacen;
    }

    private MarkupString GetSucursalNombreHtml(string? almacen)
    {
        if (string.IsNullOrEmpty(almacen))
            return new MarkupString("Sin sucursal");

        if (!SucursalesCache.TryGetValue(almacen, out var nombre))
            return new MarkupString(almacen);

        if (nombre.Length <= 35)
            return new MarkupString(nombre);

        var indexParentesis = nombre.IndexOf('(');
        if (indexParentesis > 0)
        {
            var parte1 = nombre.Substring(0, indexParentesis).Trim();
            var parte2 = nombre.Substring(indexParentesis).Trim();

            var contenidoParentesis = parte2.Trim('(', ')', ' ').Trim();
            if (string.IsNullOrEmpty(contenidoParentesis) || contenidoParentesis == "." || contenidoParentesis.Length <= 2)
            {
                return new MarkupString(nombre);
            }

            return new MarkupString($"{parte1}<br/>{parte2}");
        }

        return new MarkupString(nombre);
    }

    private MarkupString GetNombreFormateado(string? nombreCompleto)
    {
        if (string.IsNullOrEmpty(nombreCompleto))
            return new MarkupString("");

        if (nombreCompleto.Length <= 25)
            return new MarkupString(nombreCompleto);

        var palabras = nombreCompleto.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        
        if (palabras.Length <= 1)
            return new MarkupString(nombreCompleto);

        var mitad = (palabras.Length + 1) / 2;
        
        var linea1 = string.Join(" ", palabras.Take(mitad));
        var linea2 = string.Join(" ", palabras.Skip(mitad));

        return new MarkupString($"{linea1}<br/>{linea2}");
    }

