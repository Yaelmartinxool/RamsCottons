   private async Task EnviarPromocion(Promocion promo, string enlace)
{
    mostrarModalPromociones = false;

    var clientesParaEnviar = clientesSeleccionados
        .Select(id => clientes.FirstOrDefault(c => c.Id == id))
        .Where(c => c != null && !string.IsNullOrEmpty(c.Telefono))
        .ToList();

    if (clientesParaEnviar.Count == 0)
    {
        await MostrarNotificacionError("Ninguno de los clientes seleccionados tiene un telefono valido");
        return;
    }

    var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
    var user = authState.User;
    var usuarioActual = await UserManager.GetUserAsync(user);
    var usuarioId = usuarioActual?.Id ?? "";

    var enviados = 0;
    var fallidos = 0;
    string? ultimoError = null; 

    foreach (var cliente in clientesParaEnviar)
    {
        try
        {
            var telefonoLimpio = cliente!.Telefono!.Replace(" ", "").Replace("-", "").Replace("+", "");
            if (!telefonoLimpio.StartsWith("52")) telefonoLimpio = "52" + telefonoLimpio;

                var resultado = await _whatsApp.EnviarPlantillaConBotonAsync(
                    numeroDestino: telefonoLimpio,
                    nombrePlantilla: "promocion_rams_v6",
                    idioma: "es_MX",
                    parametros: new Dictionary<string, string>
                    {
                        { "1", cliente.NombreCompleto.Split(' ')[0] },
                        { "2", $"{promo.Titulo} - {promo.Descripcion}" },
                        { "3", promo.FechaFin.ToString("dd/MM/yyyy") }
                    },
                    urlBoton: promo.TokenUnico ?? ""
                );
            //  LOG en el navegador (F12 → Console)
            await JS.InvokeVoidAsync("console.log", $"[WhatsApp] Envío a {telefonoLimpio} - Resultado: {resultado}");
            await JS.InvokeVoidAsync("console.log", $"[WhatsApp] Error: {_whatsApp.UltimoError ?? "Ninguno"}");

            // Guardar el error para mostrarlo después
            if (!resultado && !string.IsNullOrEmpty(_whatsApp.UltimoError))
            {
                ultimoError = _whatsApp.UltimoError;
            }

            var historial = new HistorialEnvio
            {
                ClienteId = cliente.Id,
                PromocionId = promo.Id,
                UsuarioEnvioId = usuarioId,
                Mensaje = $"{promo.Titulo} - {promo.Descripcion}",
                EnlacePromocion = enlace,
                EnlaceWhatsApp = $"https://wa.me/{telefonoLimpio}?text={Uri.EscapeDataString($"{promo.Titulo} - {promo.Descripcion}")}",
                FechaEnvio = DateTime.Now,
                Estatus = resultado ? "Enviado" : "Fallido",
                Observaciones = resultado 
                    ? $"Enviado a {cliente.Telefono}" 
                    : $"Error: {_whatsApp.UltimoError ?? "desconocido"}"
            };
            DbContext.HistorialEnvios.Add(historial);

            if (resultado)
                enviados++;
            else
                fallidos++;
        }
        catch (Exception ex)
        {
            fallidos++;
            ultimoError = ex.Message;
            
            var historial = new HistorialEnvio
            {
                ClienteId = cliente!.Id,
                PromocionId = promo.Id,
                UsuarioEnvioId = usuarioId,
                Mensaje = $"{promo.Titulo} - {promo.Descripcion}",
                EnlacePromocion = enlace,
                EnlaceWhatsApp = "",
                FechaEnvio = DateTime.Now,
                Estatus = "Error",
                Observaciones = $"Error: {ex.Message}"
            };
            DbContext.HistorialEnvios.Add(historial);
        }

        await Task.Delay(200);
    }

    await DbContext.SaveChangesAsync();
    clientesSeleccionados.Clear();

    var mensajeResumen = fallidos == 0
        ? (enviados == 1 
            ? "Se envió 1 mensaje correctamente" 
            : $"Se enviaron {enviados} mensajes correctamente")
        : (enviados == 1 && fallidos == 1 
            ? "1 enviado, 1 fallo" 
            : fallidos == 1 
                ? $"{enviados} enviados, 1 fallo" 
                : $"{enviados} enviados, {fallidos} fallaron");

    // HTML del Swal: muestra el error de Meta si hay fallos
    var htmlError = "";
    if (fallidos > 0 && !string.IsNullOrEmpty(ultimoError))
    {
        // Escapar HTML para que no rompa el Swal
        var errorEscapado = ultimoError
            .Replace("&", "&amp;")
            .Replace("<", "&lt;")
            .Replace(">", "&gt;")
            .Replace("\"", "&quot;");

        htmlError = $@"
            <div style='margin-top: 1rem; padding: 0.75rem; background: #fef2f2; border-radius: 8px; border-left: 4px solid #ef4444; text-align: left; max-height: 200px; overflow-y: auto;'>
                <div style='font-size: 0.75rem; color: #991b1b; font-weight: 700; margin-bottom: 0.35rem;'>
                    <i class='bi bi-exclamation-triangle-fill'></i> Error de Meta WhatsApp:
                </div>
                <div style='font-size: 0.7rem; color: #7f1d1d; word-break: break-all; font-family: monospace; line-height: 1.4;'>
                    {errorEscapado}
                </div>
            </div>";
    }

    await JS.InvokeVoidAsync("Swal.fire", new
    {
        title = fallidos == 0 ? "Promoción enviada" : "Error al enviar",
        html = $@"
            <div style='display: flex; justify-content: center; gap: 2.5rem; padding: 1rem 0;'>
                <div style='text-align: center;'>
                    <div style='font-size: 1.8rem; font-weight: 700; color: #10b981;'>{enviados}</div>
                    <div style='font-size: 0.8rem; color: #6b7280;'>Enviados</div>
                </div>
                <div style='width: 1px; background: #e5e7eb;'></div>
                <div style='text-align: center;'>
                    <div style='font-size: 1.8rem; font-weight: 700; color: #ef4444;'>{fallidos}</div>
                    <div style='font-size: 0.8rem; color: #6b7280;'>Fallidos</div>
                </div>
            </div>
            <div style='font-size: 0.9rem; color: #4b5563; text-align: center; padding-top: 0.5rem;'>
                {mensajeResumen}
            </div>
            {htmlError}
        ",
        icon = fallidos == 0 ? "success" : "warning",
        confirmButtonText = "Aceptar",
        confirmButtonColor = "#0f172a",
        width = fallidos > 0 ? "600px" : "auto"   
    });
}
