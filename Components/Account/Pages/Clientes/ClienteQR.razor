@page "/cliente/{Id}"
@layout Layout.BlankLayout
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using RamsCottons.Models
@using RamsCottons.Data
@using RamsCottons.Services

@inject ApplicationDbContext DbContext
@inject NavigationManager NavigationManager
@inject QrGeneratorService QrGeneratorService

<PageTitle>Mi Tarjeta | RAMS Cottons</PageTitle>

<div class="container">
    @if (cargando)
    {
        <div class="loading">Cargando...</div>
    }
    else if (cliente == null)
    {
        <div class="error">Cliente no encontrado</div>
    }
    else
    {
        <div class="wrapper">
            <!-- Tarjeta para capturar -->
            <div id="tarjetaCaptura" class="card">
                <!-- Logo -->
                <div class="logo">
                    <img src="images/logo.png" alt="RAMS COTTONS" />
                </div>

                <!-- Folio -->
                <div class="folio">
                    FOLIO: <strong>CL-@cliente.Id.ToString("D6")</strong>
                </div>

                <!-- Nombre -->
                <h1 class="nombre">@cliente.NombreCompleto</h1>

                <!-- Categoría -->
                <div class="categoria">
                    @(nombreCategoria ?? "Cliente Premium")
                </div>

                <!-- Contacto alineado a la izquierda -->
                <div class="contacto-lista">
                    <div class="contacto-item">
                        <i class="bi bi-telephone"></i>
                        <span>@cliente.Telefono</span>
                    </div>
                    @if (!string.IsNullOrEmpty(cliente.Correo))
                    {
                        <div class="contacto-item">
                            <i class="bi bi-envelope"></i>
                            <span>@cliente.Correo</span>
                        </div>
                    }
                    <div class="contacto-item">
                        <i class="bi bi-calendar3"></i>
                        <span>Desde @cliente.FechaRegistro.ToString("dd MMM yyyy")</span>
                    </div>
                </div>

                <!-- QR más grande -->
                <div class="qr-grande">
                    <img src="@qrImagenBase64" alt="QR" />
                    <p>Escanea para compartir</p>
                </div>

                <!-- Estado -->
                <div class="estado @(cliente.Estado == 1 ? "activo" : "inactivo")">
                    <i class="bi @(cliente.Estado == 1 ? "bi-check-circle" : "bi-x-circle")"></i>
                    @(cliente.Estado == 1 ? "ACTIVO" : "INACTIVO")
                </div>
            </div>

            <!-- Botones -->
            <div class="botones">
                <a href="https://wa.me/52@cliente.Telefono?text=Hola%20@cliente.NombreCompleto"
                   class="btn-whatsapp"
                   target="_blank">
                    <i class="bi bi-whatsapp"></i> WhatsApp
                </a>
                <button class="btn-descargar" onclick="descargarTarjeta()">
                    <i class="bi bi-download"></i> Descargar
                </button>
            </div>
        </div>
    }
</div>

<script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>

<script>
    function descargarTarjeta() {
        const element = document.getElementById('tarjetaCaptura');
        
        html2canvas(element, {
            scale: 2,
            backgroundColor: '#ffffff',
            logging: false
        }).then(canvas => {
            const link = document.createElement('a');
            link.download = 'tarjeta_rams.png';
            link.href = canvas.toDataURL();
            link.click();
        });
    }
</script>

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private int ClienteId => int.TryParse(Id, out var id) ? id : 0;

    private Cliente? cliente;
    private string? nombreCategoria;
    private bool cargando = true;
    private string qrImagenBase64 = string.Empty;

protected override async Task OnInitializedAsync()
{
    await CargarDatos();
    await GenerarQRTarjeta();
}
private async Task CargarDatos()
{
    cargando = true;
    try
    {
        cliente = await DbContext.Clientes.FirstOrDefaultAsync(c => c.Id == ClienteId);
        
        if (cliente != null && cliente.IdCategoriaProducto.HasValue)
        {
            var categoria = await DbContext.CategoriaProductos
                .FirstOrDefaultAsync(c => c.IdCategoria == cliente.IdCategoriaProducto.Value);
            nombreCategoria = categoria?.NombreCat;
        }
    }
    catch (Exception ex)
    {
        Console.WriteLine($"Error: {ex.Message}");
    }
    finally
    {
        cargando = false;
    }
}

private async Task GenerarQRTarjeta()
{
    if (cliente == null) return;
    
    try
    {
        var url = $"{NavigationManager.BaseUri}cliente/{cliente.Id}";
        qrImagenBase64 = await Task.Run(() => QrGeneratorService.GenerarQRBase64(url, 12));
    }
    catch (Exception ex)
    {
        Console.WriteLine($"Error generando QR: {ex.Message}");
    }
}
}