@page "/promociones/editar/{Id:int}"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using RamsCottons.Models
@using RamsCottons.Data
@using RamsCottons.Models.CycData
@using RamsCottons.Services
@using System.ComponentModel.DataAnnotations

@attribute [Authorize(Roles = "SuperAdministrador,Administrador")]

@inject ApplicationDbContext DbContext
@inject NavigationManager NavigationManager
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IWebHostEnvironment WebHostEnvironment
@inject IJSRuntime JS
@inject SucursalService SucursalService

<PageTitle>Editar Promoción | RAMS Cottons</PageTitle>

<div class="editar-promo-container">
    <br>

    <div class="dashboard-header">
        <div class="header-content">
            <div class="header-title">
                <div class="title-icon">
                    <i class="bi bi-pencil-fill"></i>
                </div>
                <div>
                    <h1>Editar Promoción</h1>
                    <p class="subtitle">Modifique los datos de la promoción</p>
                </div>
            </div>

            <button type="button" class="btn-back" @onclick="Volver">
                <span>Volver</span>
            </button>
        </div>
    </div>

    @if (cargando)
    {
        <div class="loading-container">
            <div class="spinner-border text-primary"></div>
            <p>Cargando información de la promoción...</p>
        </div>
    }
    else if (promocion == null)
    {
        <div class="error-container">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <h3>Promoción no encontrada</h3>
            <p>La promoción que intentas editar no existe o ha sido eliminada.</p>

            <button type="button" class="btn-back" @onclick="Volver">
                Volver
            </button>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-8">
                <div class="form-card">
                    <div class="card-header">
                        <div class="header-left">
                            <i class="bi bi-pencil-square"></i>
                            <h3>Información de la Promoción</h3>
                        </div>

                        <span class="required-badge">* Campos obligatorios</span>
                    </div>

                    <div class="card-body">
                        <EditForm Model="modelo"
                                  OnValidSubmit="GuardarPromocion"
                                  FormName="editarPromocion">

                            <DataAnnotationsValidator />
                            <ValidationSummary class="validation-summary" />

                            <div class="form-grid">

                                <div class="form-group full-width">
                                    <label class="form-label">
                                        Título de la Promoción
                                        <span class="text-danger">*</span>
                                    </label>

                                    <div class="input-wrapper">
                                        <i class="bi bi-tag input-icon"></i>

                                        <InputText @bind-Value="modelo.Titulo"
                                                   class="form-control" />
                                    </div>

                                    <ValidationMessage For="() => modelo.Titulo"
                                                       class="validation-message" />
                                </div>

                                <div class="form-group full-width">
                                    <label class="form-label">
                                        Descripción
                                        <span class="text-danger">*</span>
                                    </label>

                                    <div class="input-wrapper">
                                        <i class="bi bi-file-text input-icon"></i>

                                        <InputTextArea @bind-Value="modelo.Descripcion"
                                                       class="form-control"
                                                       rows="3" />
                                    </div>

                                    <ValidationMessage For="() => modelo.Descripcion"
                                                       class="validation-message" />
                                </div>

                                <div class="form-group full-width">
                                    <label class="form-label">
                                        Tipo de Promoción
                                        <span class="text-danger">*</span>
                                    </label>

                                    <div class="tipo-promocion-grid">

                                        <div class="tipo-promocion-card @(modelo.TipoPromocion == "Catalogo" ? "selected" : "")"
                                             @onclick='() => SeleccionarTipoPromocion("Catalogo")'>

                                            <div class="radio-custom @(modelo.TipoPromocion == "Catalogo" ? "checked" : "")">
                                                @if (modelo.TipoPromocion == "Catalogo")
                                                {
                                                    <div class="radio-dot"></div>
                                                }
                                            </div>

                                            <div class="tipo-promocion-icon">
                                                <i class="bi bi-journal-richtext"></i>
                                            </div>

                                            <div class="tipo-promocion-info">
                                                <strong>Catálogo / Múltiples productos</strong>
                                                <span>Varios productos con diferentes precios.</span>
                                            </div>
                                        </div>

                                        <div class="tipo-promocion-card @(modelo.TipoPromocion == "PrecioUnico" ? "selected" : "")"
                                             @onclick='() => SeleccionarTipoPromocion("PrecioUnico")'>

                                            <div class="radio-custom @(modelo.TipoPromocion == "PrecioUnico" ? "checked" : "")">
                                                @if (modelo.TipoPromocion == "PrecioUnico")
                                                {
                                                    <div class="radio-dot"></div>
                                                }
                                            </div>

                                            <div class="tipo-promocion-icon">
                                                <i class="bi bi-tag-fill"></i>
                                            </div>

                                            <div class="tipo-promocion-info">
                                                <strong>Promoción de precio único</strong>
                                                <span>Un solo precio y descuento opcional.</span>
                                            </div>
                                        </div>

                                    </div>
                                </div>

                                @if (modelo.TipoPromocion == "PrecioUnico")
                                {
                                    <div class="form-group">
                                        <label class="form-label">
                                            Precio
                                            <span class="text-danger">*</span>
                                        </label>

                                        <div class="input-wrapper">
                                            <i class="bi bi-currency-dollar input-icon"></i>

                                            <InputNumber @bind-Value="modelo.Precio"
                                                         class="form-control"
                                                         placeholder="Ej: 500" />
                                        </div>

                                        <ValidationMessage For="() => modelo.Precio"
                                                           class="validation-message" />
                                    </div>

                                    <div class="form-group">
                                        <label class="form-label">
                                            Descuento (%)
                                        </label>

                                        <div class="input-wrapper">
                                            <i class="bi bi-percent input-icon"></i>

                                            <InputNumber @bind-Value="modelo.DescuentoPorcentaje"
                                                         class="form-control"
                                                         placeholder="Ej: 20" />
                                        </div>

                                        <ValidationMessage For="() => modelo.DescuentoPorcentaje"
                                                           class="validation-message" />
                                    </div>

                                    <div class="form-group">
                                        <label class="form-label">
                                            Descuento (Monto)
                                        </label>

                                        <div class="input-wrapper">
                                            <i class="bi bi-currency-dollar input-icon"></i>

                                            <InputNumber @bind-Value="modelo.DescuentoMonto"
                                                         class="form-control"
                                                         placeholder="Ej: 100" />
                                        </div>

                                        <ValidationMessage For="() => modelo.DescuentoMonto"
                                                           class="validation-message" />
                                    </div>
                                }

                                <div class="form-group">
                                    <label class="form-label">
                                        Fecha de Inicio
                                        <span class="text-danger">*</span>
                                    </label>

                                    <div class="input-wrapper">
                                        <i class="bi bi-calendar-plus input-icon"
                                           style="cursor:pointer; pointer-events:auto;"
                                           onclick="const el = document.getElementById('fechaInicio'); if(el.showPicker){el.showPicker();} else {el.focus(); el.click();}"></i>

                                        <InputDate @bind-Value="modelo.FechaInicio"
                                                   id="fechaInicio"
                                                   class="form-control" />
                                    </div>

                                    <ValidationMessage For="() => modelo.FechaInicio"
                                                       class="validation-message" />
                                </div>

                                <div class="form-group">
                                    <label class="form-label">
                                        Fecha de Fin
                                        <span class="text-danger">*</span>
                                    </label>

                                    <div class="input-wrapper">
                                        <i class="bi bi-calendar-x input-icon"
                                           style="cursor:pointer; pointer-events:auto;"
                                           onclick="const el = document.getElementById('fechaFin'); if(el.showPicker){el.showPicker();} else {el.focus(); el.click();}"></i>

                                        <InputDate @bind-Value="modelo.FechaFin"
                                                   id="fechaFin"
                                                   class="form-control" />
                                    </div>

                                    <ValidationMessage For="() => modelo.FechaFin"
                                                       class="validation-message" />
                                </div>

                                <div class="form-group">
                                    <label class="form-label">
                                        Estado
                                    </label>

                                    <div class="input-wrapper">
                                        <i class="bi @(modelo.Activo ? "bi-check-circle-fill text-success" : "bi-x-circle-fill text-danger") input-icon"></i>

                                        <div class="status-toggle">
                                            <label class="toggle-switch">
                                                <InputCheckbox @bind-Value="modelo.Activo" />
                                                <span class="toggle-slider"></span>
                                            </label>

                                            <span class="status-text @(modelo.Activo ? "status-active-text" : "status-inactive-text")">
                                                @(modelo.Activo ? "Activa" : "Inactiva")
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <!-- ============================================ -->
                                <!-- SUCURSALES - MULTI-SELECCIÓN TIPO TARJETAS -->
                                <!-- ============================================ -->
                                <div class="form-group full-width">
                                    <label class="form-label">
                                        Sucursales
                                        <span class="text-danger">*</span>
                                        <span class="sucursales-counter">
                                            (@selectedSucursales.Count seleccionada@(selectedSucursales.Count != 1 ? "s" : ""))
                                        </span>
                                    </label>

                                    <!-- Toolbar: Buscador + Botones -->
                                    <div class="sucursales-toolbar">
                                        <div class="sucursales-search">
                                            <i class="bi bi-search"></i>
                                            <input type="text"
                                                   placeholder="Buscar sucursal por nombre o código..."
                                                   @bind="busquedaSucursal"
                                                   @bind:event="oninput" />
                                            @if (!string.IsNullOrEmpty(busquedaSucursal))
                                            {
                                                <button type="button"
                                                        class="clear-search"
                                                        @onclick="LimpiarBusqueda">
                                                    <i class="bi bi-x"></i>
                                                </button>
                                            }
                                        </div>

                                        <button type="button"
                                                class="btn-select-all-suc"
                                                @onclick="SeleccionarTodasFiltradas">
                                            <i class="bi bi-check2-square"></i>
                                            Todas (@sucursalesFiltradas.Count())
                                        </button>

                                        @if (selectedSucursales.Any())
                                        {
                                            <button type="button"
                                                    class="btn-clear-suc"
                                                    @onclick="LimpiarSeleccionSucursales">
                                                <i class="bi bi-x-circle"></i>
                                                Limpiar
                                            </button>
                                        }
                                    </div>

                                    <!-- Grid de tarjetas -->
                                    <div class="sucursales-grid @(errorSucursal ? "has-error" : "")">
                                        @if (sucursalesFiltradas.Any())
                                        {
                                            @foreach (var sucursal in sucursalesFiltradas)
                                            {
                                                var isSelected = selectedSucursales.Contains(sucursal.Almacen);
                                                <div class="sucursal-card @(isSelected ? "selected" : "")"
                                                     @onclick="() => ToggleSucursal(sucursal)">

                                                    <div class="sucursal-card-check">
                                                        @if (isSelected)
                                                        {
                                                            <i class="bi bi-check-lg"></i>
                                                        }
                                                    </div>

                                                    <div class="sucursal-card-info">
                                                        <span class="sucursal-card-text">
                                                            <strong class="sucursal-card-code">@sucursal.Almacen</strong>
                                                            @ObtenerNombreLimpio(sucursal)
                                                        </span>
                                                    </div>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="sucursales-empty">
                                                <i class="bi bi-search"></i>
                                                <span>No se encontraron sucursales con "@busquedaSucursal"</span>
                                            </div>
                                        }
                                    </div>

                                    @if (errorSucursal)
                                    {
                                        <div class="validation-message" style="margin-top:0.5rem;">
                                            <i class="bi bi-exclamation-circle-fill me-1"></i>
                                            @mensajeErrorSucursal
                                        </div>
                                    }
                                </div>

                                <div class="form-group full-width">
                                    <label class="form-label">
                                        Archivo actual
                                    </label>

                                    @if (!string.IsNullOrEmpty(promocion.pdf_url))
                                    {
                                        <div class="current-file">

                                            @if (promocion.pdf_url.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <i class="bi bi-file-earmark-pdf-fill text-danger"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-file-earmark-image-fill text-primary"></i>
                                            }

                                            <span class="file-name-text">
                                                @promocion.pdf_nombre
                                            </span>

                                            <a href="@promocion.pdf_url"
                                               target="_blank"
                                               class="btn-view-file-modern">

                                                <i class="bi bi-eye"></i>
                                                Ver
                                            </a>
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="text-muted">
                                            No hay archivo subido
                                        </p>
                                    }
                                </div>

                                <div class="form-group full-width">
                                    <label class="form-label">
                                        Reemplazar archivo (opcional)
                                    </label>

                                    <div class="file-upload-container">
                                        <label for="fileInput"
                                               class="file-upload-btn">

                                            <i class="bi bi-cloud-upload-fill"></i>
                                            <span>Seleccionar archivo</span>
                                        </label>

                                        <span class="file-name">
                                            @(string.IsNullOrEmpty(nombreArchivoNuevo)
                                                ? "Ningún archivo nuevo seleccionado"
                                                : nombreArchivoNuevo)
                                        </span>

                                        <InputFile id="fileInput"
                                                   OnChange="OnFileSelected"
                                                   accept=".pdf,.jpg,.jpeg,.png"
                                                   style="display:none" />
                                    </div>

                                    @if (!string.IsNullOrEmpty(nombreArchivoNuevo))
                                    {
                                        <div class="selected-file-info">
                                            <i class="bi @(nombreArchivoNuevo.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase)
                                                ? "bi-file-earmark-pdf-fill"
                                                : "bi-file-earmark-image-fill")">
                                            </i>

                                            <span>
                                                @nombreArchivoNuevo
                                            </span>

                                            <button type="button"
                                                    class="btn-remove-file"
                                                    @onclick="EliminarArchivoNuevo">

                                                <i class="bi bi-x"></i>
                                            </button>
                                        </div>
                                    }
                                </div>

                            </div>

                            <div class="form-actions">
                                <button type="submit"
                                        class="btn-submit"
                                        disabled="@guardando">

                                    @(guardando ? "Guardando..." : "Guardar Cambios")
                                </button>

                                <button type="button"
                                        class="btn-cancel"
                                        @onclick="Volver">

                                    Cancelar
                                </button>
                            </div>

                        </EditForm>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="info-card">
                    <div class="info-card-header">
                        <i class="bi bi-info-circle"></i>
                        <h4>Información</h4>
                    </div>

                    <div class="info-card-body">

                        <div class="info-item">
                            <span class="info-label">ID:</span>
                            <span class="info-value">@promocion.Id</span>
                        </div>

                        <div class="info-item">
                            <span class="info-label">Tipo:</span>
                            <span class="info-value">
                                @(promocion.TipoPromocion == "Catalogo"
                                    ? "Catálogo"
                                    : "Precio único")
                            </span>
                        </div>

                        <div class="info-item">
                            <span class="info-label">Token único:</span>
                            <span class="info-value">@promocion.TokenUnico</span>
                        </div>

                        <div class="info-item">
                            <span class="info-label">Creada:</span>
                            <span class="info-value">
                                @promocion.FechaCreacion.ToString("dd/MM/yyyy HH:mm")
                            </span>
                        </div>

                        <div class="info-item">
                            <span class="info-label">Enlace:</span>

                            <span class="info-value">
                                <a href="@($"https://rams.no-ip.info:8082/promociones/{promocion.TokenUnico}")"
                                   target="_blank">
                                    Ver promoción
                                </a>
                            </span>
                        </div>

                        @if (!string.IsNullOrEmpty(promocion.ApplicationUserId))
                        {
                            <div class="info-item">
                                <span class="info-label">Creado por:</span>
                                <span class="info-value">@nombreCreador</span>
                            </div>
                        }

                    </div>
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(mensajeExito))
    {
        <div class="toast-notification toast-success">
            <i class="bi bi-check-circle-fill"></i>
            <span>@mensajeExito</span>
        </div>
    }

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="toast-notification toast-error">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>@error</span>
        </div>
    }

</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private Promocion? promocion;
    private PromocionModel modelo = new();

    private bool cargando = true;
    private bool guardando = false;
    private bool errorSucursal = false;

    private string? error;
    private string? mensajeExito;
    private string? nombreArchivoNuevo;
    private string? archivoBase64;
    private string? archivoContentType;
    private string? nombreCreador;
    private string busquedaSucursal = "";
    private string mensajeErrorSucursal = "";

    private List<SucursalCyc> SucursalesDisponibles = new();

    // ✅ Lista de sucursales seleccionadas
    private HashSet<string> selectedSucursales = new();

    private const long MaxFileSize = 100 * 1024 * 1024;

    private IEnumerable<SucursalCyc> sucursalesFiltradas =>
        string.IsNullOrWhiteSpace(busquedaSucursal)
            ? SucursalesDisponibles
            : SucursalesDisponibles.Where(s =>
                s.Almacen.Contains(busquedaSucursal, StringComparison.OrdinalIgnoreCase) ||
                (s.NombreCompleto != null && s.NombreCompleto.Contains(busquedaSucursal, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        SucursalesDisponibles = SucursalService.GetAllSucursales();

        await CargarPromocion();
    }

    private async Task CargarPromocion()
    {
        cargando = true;

        try
        {
            promocion = await DbContext.Promociones
                .FirstOrDefaultAsync(p => p.Id == Id);

            if (promocion == null)
            {
                return;
            }

            modelo = new PromocionModel
            {
                Titulo = promocion.Titulo,
                Descripcion = promocion.Descripcion ?? "",
                TipoPromocion = string.IsNullOrWhiteSpace(promocion.TipoPromocion)
                    ? "PrecioUnico"
                    : promocion.TipoPromocion,
                Precio = promocion.Precio,
                DescuentoPorcentaje = promocion.DescuentoPorcentaje,
                DescuentoMonto = promocion.DescuentoMonto,
                FechaInicio = promocion.FechaInicio,
                FechaFin = promocion.FechaFin,
                Activo = promocion.Activo
            };

            // ✅ Cargar sucursales seleccionadas (todas las que tengan el mismo TokenUnico)
            if (!string.IsNullOrEmpty(promocion.TokenUnico))
            {
                var sucursalesMismoToken = await DbContext.Promociones
                    .Where(p => p.TokenUnico == promocion.TokenUnico && !string.IsNullOrEmpty(p.IdSucursal))
                    .Select(p => p.IdSucursal!)
                    .ToListAsync();

                foreach (var suc in sucursalesMismoToken)
                {
                    selectedSucursales.Add(suc);
                }
            }
            else if (!string.IsNullOrEmpty(promocion.IdSucursal))
            {
                // Fallback: si no tiene TokenUnico, usar solo su sucursal
                selectedSucursales.Add(promocion.IdSucursal);
            }

            if (!string.IsNullOrEmpty(promocion.ApplicationUserId))
            {
                var creador = await UserManager
                    .FindByIdAsync(promocion.ApplicationUserId);

                nombreCreador = creador?.NombreCompleto
                    ?? creador?.Email
                    ?? "Usuario";
            }
        }
        catch (Exception ex)
        {
            error = $"Error al cargar la promoción: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private void SeleccionarTipoPromocion(string tipo)
    {
        modelo.TipoPromocion = tipo;

        if (tipo == "Catalogo")
        {
            modelo.Precio = null;
            modelo.DescuentoPorcentaje = null;
            modelo.DescuentoMonto = null;
        }

        StateHasChanged();
    }

    private void LimpiarBusqueda()
    {
        busquedaSucursal = "";
    }

    // ✅ Toggle de sucursal
    private void ToggleSucursal(SucursalCyc sucursal)
    {
        if (selectedSucursales.Contains(sucursal.Almacen))
        {
            selectedSucursales.Remove(sucursal.Almacen);
        }
        else
        {
            selectedSucursales.Add(sucursal.Almacen);
        }

        errorSucursal = false;
        mensajeErrorSucursal = "";
    }

    // ✅ Seleccionar todas las filtradas
    private void SeleccionarTodasFiltradas()
    {
        foreach (var suc in sucursalesFiltradas)
        {
            selectedSucursales.Add(suc.Almacen);
        }
        errorSucursal = false;
        mensajeErrorSucursal = "";
    }

    // ✅ Limpiar selección
    private void LimpiarSeleccionSucursales()
    {
        selectedSucursales.Clear();
    }

    // ✅ Limpiar el nombre quitando el prefijo del código
    private string ObtenerNombreLimpio(SucursalCyc sucursal)
    {
        if (string.IsNullOrEmpty(sucursal.NombreCompleto))
            return sucursal.Almacen;

        var nombre = sucursal.NombreCompleto.Trim();
        var almacen = sucursal.Almacen?.Trim() ?? "";

        if (!string.IsNullOrEmpty(almacen))
        {
            var prefijoConEspacio = $"{almacen} - ";
            var prefijoSinEspacio = $"{almacen}-";

            if (nombre.StartsWith(prefijoConEspacio, StringComparison.OrdinalIgnoreCase))
            {
                return nombre.Substring(prefijoConEspacio.Length).Trim();
            }

            if (nombre.StartsWith(prefijoSinEspacio, StringComparison.OrdinalIgnoreCase))
            {
                return nombre.Substring(prefijoSinEspacio.Length).Trim();
            }
        }

        if (nombre.Length > 4 && char.IsDigit(nombre[0]) && char.IsDigit(nombre[1]))
        {
            var guionIndex = nombre.IndexOf('-', 2);
            if (guionIndex > 0)
            {
                return nombre.Substring(guionIndex + 1).Trim();
            }
        }

        return nombre;
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;

        if (file == null)
        {
            return;
        }

        try
        {
            if (file.Size > MaxFileSize)
            {
                var tamañoMB = file.Size / (1024.0 * 1024.0);

                error = $"El archivo no puede superar los 100MB. Tu archivo pesa {tamañoMB:F1}MB.";

                nombreArchivoNuevo = null;
                archivoBase64 = null;
                archivoContentType = null;

                return;
            }

            nombreArchivoNuevo = file.Name;
            archivoContentType = file.ContentType;

            using var stream = file.OpenReadStream(MaxFileSize);
            using var ms = new MemoryStream();

            await stream.CopyToAsync(ms);

            archivoBase64 = Convert.ToBase64String(ms.ToArray());

            error = null;
        }
        catch (Exception ex)
        {
            error = $"Error al cargar el archivo: {ex.Message}";
        }
    }

    private void EliminarArchivoNuevo()
    {
        nombreArchivoNuevo = null;
        archivoBase64 = null;
        archivoContentType = null;
        error = null;
    }

    private async Task GuardarPromocion()
    {
        if (promocion == null)
        {
            return;
        }

        guardando = true;
        error = null;
        mensajeExito = null;
        errorSucursal = false;
        mensajeErrorSucursal = "";

        StateHasChanged();

        try
        {
            if (string.IsNullOrWhiteSpace(modelo.TipoPromocion))
            {
                error = "Debes seleccionar el tipo de promoción.";
                return;
            }

            if (modelo.TipoPromocion == "PrecioUnico")
            {
                if (!modelo.Precio.HasValue || modelo.Precio.Value <= 0)
                {
                    error = "Debes ingresar un precio válido.";
                    return;
                }
            }
            else
            {
                modelo.Precio = null;
                modelo.DescuentoPorcentaje = null;
                modelo.DescuentoMonto = null;
            }

            if (modelo.FechaInicio > modelo.FechaFin)
            {
                error = "La fecha de inicio no puede ser mayor a la fecha de fin.";
                return;
            }

            // ✅ VALIDAR SUCURSALES
            if (!selectedSucursales.Any())
            {
                error = "Debes seleccionar al menos una sucursal.";
                errorSucursal = true;
                mensajeErrorSucursal = "Debes seleccionar al menos una sucursal";
                return;
            }

            var sucursalesFinales = selectedSucursales.ToList();

            // ✅ GUARDAR ARCHIVO SI SE REEMPLAZÓ (una sola vez)
            string? nuevaRutaArchivo = null;
            string? nuevoNombreArchivo = null;
            string? nuevaUrlArchivo = null;

            if (!string.IsNullOrEmpty(archivoBase64) && !string.IsNullOrEmpty(nombreArchivoNuevo))
            {
                var uploadsFolder = Path.Combine(
                    WebHostEnvironment.WebRootPath,
                    "uploads",
                    "promociones");

                Directory.CreateDirectory(uploadsFolder);

                var extension = Path.GetExtension(nombreArchivoNuevo);
                var fileName = $"{promocion.TokenUnico}_{DateTime.Now.Ticks}{extension}";
                var filePath = Path.Combine(uploadsFolder, fileName);

                var bytes = Convert.FromBase64String(archivoBase64);
                await File.WriteAllBytesAsync(filePath, bytes);

                nuevaUrlArchivo = $"/uploads/promociones/{fileName}";
                nuevoNombreArchivo = nombreArchivoNuevo;
                nuevaRutaArchivo = filePath;
            }

            // ✅ OBTENER TODAS LAS PROMOCIONES CON EL MISMO TOKEN
            var promocionesMismoToken = await DbContext.Promociones
                .Where(p => p.TokenUnico == promocion.TokenUnico)
                .ToListAsync();

            // ✅ ACTUALIZAR LAS EXISTENTES QUE SIGAN SELECCIONADAS
            var promocionesActualizadas = new HashSet<int>();

            foreach (var prom in promocionesMismoToken)
            {
                if (selectedSucursales.Contains(prom.IdSucursal ?? ""))
                {
                    // Actualizar
                    prom.Titulo = modelo.Titulo;
                    prom.Descripcion = modelo.Descripcion ?? "";
                    prom.TipoPromocion = modelo.TipoPromocion;
                    prom.Precio = modelo.TipoPromocion == "PrecioUnico" ? modelo.Precio : null;
                    prom.DescuentoPorcentaje = modelo.TipoPromocion == "PrecioUnico" ? modelo.DescuentoPorcentaje : null;
                    prom.DescuentoMonto = modelo.TipoPromocion == "PrecioUnico" ? modelo.DescuentoMonto : null;
                    prom.FechaInicio = modelo.FechaInicio;
                    prom.FechaFin = modelo.FechaFin;
                    prom.Activo = modelo.Activo;
                    prom.FechaActualizacion = DateTime.Now;

                    if (nuevaUrlArchivo != null)
                    {
                        prom.pdf_url = nuevaUrlArchivo;
                        prom.pdf_nombre = nuevoNombreArchivo;
                        prom.pdf_ruta = nuevaRutaArchivo;
                    }

                    promocionesActualizadas.Add(prom.Id);
                }
                else
                {
                    // Eliminar la que ya no está seleccionada
                    DbContext.Promociones.Remove(prom);
                }
            }

            // ✅ CREAR LAS NUEVAS SUCURSALES QUE NO EXISTÍAN
            foreach (var sucursal in sucursalesFinales)
            {
                var yaExiste = promocionesMismoToken
                    .Any(p => p.IdSucursal == sucursal && promocionesActualizadas.Contains(p.Id));

                if (!yaExiste)
                {
                    var nuevaPromo = new Promocion
                    {
                        Titulo = modelo.Titulo,
                        Descripcion = modelo.Descripcion ?? "",
                        TipoPromocion = modelo.TipoPromocion,
                        Precio = modelo.TipoPromocion == "PrecioUnico" ? modelo.Precio : null,
                        DescuentoPorcentaje = modelo.TipoPromocion == "PrecioUnico" ? modelo.DescuentoPorcentaje : null,
                        DescuentoMonto = modelo.TipoPromocion == "PrecioUnico" ? modelo.DescuentoMonto : null,
                        FechaInicio = modelo.FechaInicio,
                        FechaFin = modelo.FechaFin,
                        TokenUnico = promocion.TokenUnico,
                        pdf_nombre = nuevoNombreArchivo ?? promocion.pdf_nombre,
                        pdf_ruta = nuevaRutaArchivo ?? promocion.pdf_ruta,
                        pdf_url = nuevaUrlArchivo ?? promocion.pdf_url,
                        Activo = modelo.Activo,
                        FechaCreacion = promocion.FechaCreacion,
                        FechaActualizacion = DateTime.Now,
                        ApplicationUserId = promocion.ApplicationUserId,
                        IdSucursal = sucursal
                    };

                    DbContext.Promociones.Add(nuevaPromo);
                }
            }

            await DbContext.SaveChangesAsync();

            mensajeExito = $"Promoción '{modelo.Titulo}' actualizada en {sucursalesFinales.Count} sucursal(es)!";

            await JS.InvokeVoidAsync("Swal.fire", new
            {
                title = "¡Éxito!",
                html = $@"
                    <p>Promoción <strong>{modelo.Titulo}</strong> actualizada.</p>
                    <p style='color:#10b981; font-weight:600; margin-top:0.5rem;'>
                        ✓ {sucursalesFinales.Count} sucursal(es) asignada(s)
                    </p>
                ",
                icon = "success",
                confirmButtonText = "Aceptar",
                confirmButtonColor = "#0f172a",
                timer = 2000,
                showConfirmButton = false
            });

            await Task.Delay(1500);

            NavigationManager.NavigateTo("/promociones", forceLoad: true);
        }
        catch (Exception ex)
        {
            if (ex is DbUpdateException dbEx)
            {
                error = $"Error de base de datos: {dbEx.InnerException?.Message ?? dbEx.Message}";
            }
            else
            {
                error = $"Error al guardar: {ex.Message}";
            }

            StateHasChanged();
        }
        finally
        {
            guardando = false;
            StateHasChanged();
        }
    }

    private void Volver()
    {
        NavigationManager.NavigateTo("/promociones");
    }

    private class PromocionModel
    {
        [Required(ErrorMessage = "El título es obligatorio")]
        [StringLength(100, MinimumLength = 3, ErrorMessage = "El título debe tener entre 3 y 100 caracteres")]
        public string Titulo { get; set; } = "";

        [Required(ErrorMessage = "La descripción es obligatoria")]
        [StringLength(500, ErrorMessage = "La descripción no puede exceder los 500 caracteres")]
        public string Descripcion { get; set; } = "";

        [Required(ErrorMessage = "El tipo de promoción es obligatorio")]
        public string TipoPromocion { get; set; } = "Catalogo";

        [Range(0.01, 999999.99, ErrorMessage = "El precio debe ser mayor a 0")]
        public decimal? Precio { get; set; }

        [Range(0, 100, ErrorMessage = "El descuento debe estar entre 0 y 100%")]
        public decimal? DescuentoPorcentaje { get; set; }

        [Range(0, 999999, ErrorMessage = "El monto debe ser mayor o igual a 0")]
        public decimal? DescuentoMonto { get; set; }

        [Required(ErrorMessage = "La fecha de inicio es obligatoria")]
        public DateTime FechaInicio { get; set; } = DateTime.Today;

        [Required(ErrorMessage = "La fecha de fin es obligatoria")]
        public DateTime FechaFin { get; set; } = DateTime.Today.AddDays(30);

        public bool Activo { get; set; } = true;
    }
}