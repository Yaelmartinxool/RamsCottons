@page "/promociones/editar/{Id:int}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using RamsCottons.Models
@using RamsCottons.Data
@using RamsCottons.Models.CycData
@using RamsCottons.Services
@using System.ComponentModel.DataAnnotations
@attribute [Authorize(Roles = "SuperAdministrador,Administrador")]

@inject ApplicationDbContext DbContext
@inject NavigationManager NavigationManager
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IWebHostEnvironment WebHostEnvironment
@inject IJSRuntime JS
@inject SucursalService SucursalService

<PageTitle>Editar Promoción | RAMS Cottons</PageTitle>

<div class="editar-promo-container">
    <br>

    <div class="dashboard-header">
        <div class="header-content">
            <div class="header-title">
                <div class="title-icon">
                    <i class="bi bi-pencil-fill"></i>
                </div>
                <div>
                    <h1>Editar Promoción</h1>
                    <p class="subtitle">Modifique los datos de la promoción</p>
                </div>
            </div>

            <button type="button" class="btn-back" @onclick="Volver">
                <span>Volver</span>
            </button>
        </div>
    </div>

    @if (cargando)
    {
        <div class="loading-container">
            <div class="spinner-border text-primary"></div>
            <p>Cargando información de la promoción...</p>
        </div>
    }
    else if (promocion == null)
    {
        <div class="error-container">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <h3>Promoción no encontrada</h3>
            <p>La promoción que intentas editar no existe o ha sido eliminada.</p>

            <button type="button" class="btn-back" @onclick="Volver">
                Volver
            </button>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-8">
                <div class="form-card">
                    <div class="card-header">
                        <div class="header-left">
                            <i class="bi bi-pencil-square"></i>
                            <h3>Información de la Promoción</h3>
                        </div>

                        <span class="required-badge">* Campos obligatorios</span>
                    </div>

                    <div class="card-body">
                        <EditForm Model="modelo"
                                  OnValidSubmit="GuardarPromocion"
                                  FormName="editarPromocion">

                            <DataAnnotationsValidator />
                            <ValidationSummary class="validation-summary" />

                            <div class="form-grid">

                                <div class="form-group full-width">
                                    <label class="form-label">
                                        Título de la Promoción
                                        <span class="text-danger">*</span>
                                    </label>

                                    <div class="input-wrapper">
                                        <i class="bi bi-tag input-icon"></i>

                                        <InputText @bind-Value="modelo.Titulo"
                                                   class="form-control" />
                                    </div>

                                    <ValidationMessage For="() => modelo.Titulo"
                                                       class="validation-message" />
                                </div>

                                <div class="form-group full-width">
                                    <label class="form-label">
                                        Descripción
                                        <span class="text-danger">*</span>
                                    </label>

                                    <div class="input-wrapper">
                                        <i class="bi bi-file-text input-icon"></i>

                                        <InputTextArea @bind-Value="modelo.Descripcion"
                                                       class="form-control"
                                                       rows="3" />
                                    </div>

                                    <ValidationMessage For="() => modelo.Descripcion"
                                                       class="validation-message" />
                                </div>

                                <div class="form-group full-width">
                                    <label class="form-label">
                                        Tipo de Promoción
                                        <span class="text-danger">*</span>
                                    </label>

                                    <div class="tipo-promocion-grid">

                                        <div class="tipo-promocion-card @(modelo.TipoPromocion == "Catalogo" ? "selected" : "")"
                                             @onclick='() => SeleccionarTipoPromocion("Catalogo")'>

                                            <div class="radio-custom @(modelo.TipoPromocion == "Catalogo" ? "checked" : "")">
                                                @if (modelo.TipoPromocion == "Catalogo")
                                                {
                                                    <div class="radio-dot"></div>
                                                }
                                            </div>

                                            <div class="tipo-promocion-icon">
                                                <i class="bi bi-journal-richtext"></i>
                                            </div>

                                            <div class="tipo-promocion-info">
                                                <strong>Catálogo / Múltiples productos</strong>
                                                <span>Varios productos con diferentes precios.</span>
                                            </div>
                                        </div>

                                        <div class="tipo-promocion-card @(modelo.TipoPromocion == "PrecioUnico" ? "selected" : "")"
                                             @onclick='() => SeleccionarTipoPromocion("PrecioUnico")'>

                                            <div class="radio-custom @(modelo.TipoPromocion == "PrecioUnico" ? "checked" : "")">
                                                @if (modelo.TipoPromocion == "PrecioUnico")
                                                {
                                                    <div class="radio-dot"></div>
                                                }
                                            </div>

                                            <div class="tipo-promocion-icon">
                                                <i class="bi bi-tag-fill"></i>
                                            </div>

                                            <div class="tipo-promocion-info">
                                                <strong>Promoción de precio único</strong>
                                                <span>Un solo precio y descuento opcional.</span>
                                            </div>
                                        </div>

                                    </div>
                                </div>

                                @if (modelo.TipoPromocion == "PrecioUnico")
                                {
                                    <div class="form-group">
                                        <label class="form-label">
                                            Precio
                                            <span class="text-danger">*</span>
                                        </label>

                                        <div class="input-wrapper">
                                            <i class="bi bi-currency-dollar input-icon"></i>

                                            <InputNumber @bind-Value="modelo.Precio"
                                                         class="form-control"
                                                         placeholder="Ej: 500" />
                                        </div>

                                        <ValidationMessage For="() => modelo.Precio"
                                                           class="validation-message" />
                                    </div>

                                    <div class="form-group">
                                        <label class="form-label">
                                            Descuento (%)
                                        </label>

                                        <div class="input-wrapper">
                                            <i class="bi bi-percent input-icon"></i>

                                            <InputNumber @bind-Value="modelo.DescuentoPorcentaje"
                                                         class="form-control"
                                                         placeholder="Ej: 20" />
                                        </div>

                                        <ValidationMessage For="() => modelo.DescuentoPorcentaje"
                                                           class="validation-message" />
                                    </div>

                                    <div class="form-group">
                                        <label class="form-label">
                                            Descuento (Monto)
                                        </label>

                                        <div class="input-wrapper">
                                            <i class="bi bi-currency-dollar input-icon"></i>

                                            <InputNumber @bind-Value="modelo.DescuentoMonto"
                                                         class="form-control"
                                                         placeholder="Ej: 100" />
                                        </div>

                                        <ValidationMessage For="() => modelo.DescuentoMonto"
                                                           class="validation-message" />
                                    </div>
                                }

                                <div class="form-group">
                                    <label class="form-label">
                                        Fecha de Inicio
                                        <span class="text-danger">*</span>
                                    </label>

                                    <div class="input-wrapper">
                                        <i class="bi bi-calendar-plus input-icon"></i>

                                        <InputDate @bind-Value="modelo.FechaInicio"
                                                   class="form-control" />
                                    </div>

                                    <ValidationMessage For="() => modelo.FechaInicio"
                                                       class="validation-message" />
                                </div>

                                <div class="form-group">
                                    <label class="form-label">
                                        Fecha de Fin
                                        <span class="text-danger">*</span>
                                    </label>

                                    <div class="input-wrapper">
                                        <i class="bi bi-calendar-x input-icon"></i>

                                        <InputDate @bind-Value="modelo.FechaFin"
                                                   class="form-control" />
                                    </div>

                                    <ValidationMessage For="() => modelo.FechaFin"
                                                       class="validation-message" />
                                </div>

                                <div class="form-group">
                                    <label class="form-label">
                                        Estado
                                    </label>

                                    <div class="input-wrapper">
                                        <i class="bi @(modelo.Activo ? "bi-check-circle-fill text-success" : "bi-x-circle-fill text-danger") input-icon"></i>

                                        <div class="status-toggle">
                                            <label class="toggle-switch">
                                                <InputCheckbox @bind-Value="modelo.Activo" />
                                                <span class="toggle-slider"></span>
                                            </label>

                                            <span class="status-text @(modelo.Activo ? "status-active-text" : "status-inactive-text")">
                                                @(modelo.Activo ? "Activa" : "Inactiva")
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <div class="form-group full-width">
                                    <label class="form-label">
                                        Sucursal
                                        <span class="text-danger">*</span>
                                    </label>

                                    <div class="sucursal-search-wrapper @(errorSucursal ? "has-error" : "")">
                                        <i class="bi bi-shop"></i>

                                        <input type="text"
                                               class="sucursal-search-input"
                                               placeholder="Busca y selecciona una sucursal..."
                                               @bind="busquedaSucursal"
                                               @bind:event="oninput"
                                               @onfocus="AbrirDropdownSucursal" />

                                        <i class="bi bi-chevron-down sucursal-search-arrow @(mostrarDropdownSucursal ? "rotated" : "")"></i>

                                        @if (mostrarDropdownSucursal)
                                        {
                                            <div class="sucursal-dropdown">
                                                @if (sucursalesFiltradas.Any())
                                                {
                                                    @foreach (var sucursal in sucursalesFiltradas)
                                                    {
                                                        <div class="sucursal-dropdown-item @(selectedSucursal == sucursal.Almacen ? "selected" : "")"
                                                             @onmousedown:preventDefault
                                                             @onclick="() => SeleccionarSucursal(sucursal)">

                                                            <span class="sucursal-almacen">
                                                                @sucursal.Almacen
                                                            </span>

                                                            <span class="sucursal-nombre">
                                                                @sucursal.NombreCompleto
                                                            </span>

                                                        </div>
                                                    }
                                                }
                                                else
                                                {
                                                    <div class="sucursal-dropdown-empty">
                                                        <i class="bi bi-search"></i>
                                                        No se encontraron sucursales
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>

                                    @if (errorSucursal)
                                    {
                                        <div class="validation-message"
                                             style="margin-top:0.25rem;">

                                            <i class="bi bi-exclamation-circle-fill me-1"></i>
                                            @mensajeErrorSucursal
                                        </div>
                                    }
                                </div>

                                <div class="form-group full-width">
                                    <label class="form-label">
                                        Archivo actual
                                    </label>

                                    @if (!string.IsNullOrEmpty(promocion.pdf_url))
                                    {
                                        <div class="current-file">

                                            @if (promocion.pdf_url.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <i class="bi bi-file-earmark-pdf-fill text-danger"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-file-earmark-image-fill text-primary"></i>
                                            }

                                            <span class="file-name-text">
                                                @promocion.pdf_nombre
                                            </span>

                                            <a href="@promocion.pdf_url"
                                               target="_blank"
                                               class="btn-view-file-modern">

                                                <i class="bi bi-eye"></i>
                                                Ver
                                            </a>
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="text-muted">
                                            No hay archivo subido
                                        </p>
                                    }
                                </div>

                                <div class="form-group full-width">
                                    <label class="form-label">
                                        Reemplazar archivo (opcional)
                                    </label>

                                    <div class="file-upload-container">
                                        <label for="fileInput"
                                               class="file-upload-btn">

                                            <i class="bi bi-cloud-upload-fill"></i>
                                            <span>Seleccionar archivo</span>
                                        </label>

                                        <span class="file-name">
                                            @(string.IsNullOrEmpty(nombreArchivoNuevo)
                                                ? "Ningún archivo nuevo seleccionado"
                                                : nombreArchivoNuevo)
                                        </span>

                                        <InputFile id="fileInput"
                                                   OnChange="OnFileSelected"
                                                   accept=".pdf,.jpg,.jpeg,.png"
                                                   style="display:none" />
                                    </div>

                                    @if (!string.IsNullOrEmpty(nombreArchivoNuevo))
                                    {
                                        <div class="selected-file-info">
                                            <i class="bi @(nombreArchivoNuevo.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase)
                                                ? "bi-file-earmark-pdf-fill"
                                                : "bi-file-earmark-image-fill")">
                                            </i>

                                            <span>
                                                @nombreArchivoNuevo
                                            </span>

                                            <button type="button"
                                                    class="btn-remove-file"
                                                    @onclick="EliminarArchivoNuevo">

                                                <i class="bi bi-x"></i>
                                            </button>
                                        </div>
                                    }
                                </div>

                            </div>

                            <div class="form-actions">
                                <button type="submit"
                                        class="btn-submit"
                                        disabled="@guardando">

                                    @(guardando ? "Guardando..." : "Guardar Cambios")
                                </button>

                                <button type="button"
                                        class="btn-cancel"
                                        @onclick="Volver">

                                    Cancelar
                                </button>
                            </div>

                        </EditForm>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="info-card">
                    <div class="info-card-header">
                        <i class="bi bi-info-circle"></i>
                        <h4>Información</h4>
                    </div>

                    <div class="info-card-body">

                        <div class="info-item">
                            <span class="info-label">ID:</span>
                            <span class="info-value">@promocion.Id</span>
                        </div>

                        <div class="info-item">
                            <span class="info-label">Tipo:</span>
                            <span class="info-value">
                                @(promocion.TipoPromocion == "Catalogo"
                                    ? "Catálogo"
                                    : "Precio único")
                            </span>
                        </div>

                        <div class="info-item">
                            <span class="info-label">Token único:</span>
                            <span class="info-value">@promocion.TokenUnico</span>
                        </div>

                        <div class="info-item">
                            <span class="info-label">Creada:</span>
                            <span class="info-value">
                                @promocion.FechaCreacion.ToString("dd/MM/yyyy HH:mm")
                            </span>
                        </div>

                        <div class="info-item">
                            <span class="info-label">Enlace:</span>

                            <span class="info-value">
                                <a href="@($"https://rams.no-ip.info:8082/promociones/{promocion.TokenUnico}")"
                                   target="_blank">
                                    Ver promoción
                                </a>
                            </span>
                        </div>

                        @if (!string.IsNullOrEmpty(promocion.ApplicationUserId))
                        {
                            <div class="info-item">
                                <span class="info-label">Creado por:</span>
                                <span class="info-value">@nombreCreador</span>
                            </div>
                        }

                    </div>
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(mensajeExito))
    {
        <div class="toast-notification toast-success">
            <i class="bi bi-check-circle-fill"></i>
            <span>@mensajeExito</span>
        </div>
    }

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="toast-notification toast-error">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>@error</span>
        </div>
    }

</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private Promocion? promocion;
    private PromocionModel modelo = new();

    private bool cargando = true;
    private bool guardando = false;
    private bool errorSucursal = false;
    private bool mostrarDropdownSucursal = false;

    private string? error;
    private string? mensajeExito;
    private string? nombreArchivoNuevo;
    private string? archivoBase64;
    private string? archivoContentType;
    private string? nombreCreador;
    private string? selectedSucursal;
    private string busquedaSucursal = "";
    private string mensajeErrorSucursal = "";

    private List<SucursalCyc> SucursalesDisponibles = new();

    private const long MaxFileSize = 100 * 1024 * 1024;

    private IEnumerable<SucursalCyc> sucursalesFiltradas =>
        string.IsNullOrWhiteSpace(busquedaSucursal)
            ? SucursalesDisponibles
            : SucursalesDisponibles.Where(s =>
                s.Almacen.Contains(
                    busquedaSucursal,
                    StringComparison.OrdinalIgnoreCase) ||
                (s.NombreCompleto != null &&
                 s.NombreCompleto.Contains(
                     busquedaSucursal,
                     StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        SucursalesDisponibles = SucursalService.GetAllSucursales();

        await CargarPromocion();
    }

    private async Task CargarPromocion()
    {
        cargando = true;

        try
        {
            promocion = await DbContext.Promociones
                .FirstOrDefaultAsync(p => p.Id == Id);

            if (promocion == null)
            {
                return;
            }

            modelo = new PromocionModel
            {
                Titulo = promocion.Titulo,
                Descripcion = promocion.Descripcion ?? "",
                TipoPromocion = string.IsNullOrWhiteSpace(promocion.TipoPromocion)
                    ? "PrecioUnico"
                    : promocion.TipoPromocion,
                Precio = promocion.Precio,
                DescuentoPorcentaje = promocion.DescuentoPorcentaje,
                DescuentoMonto = promocion.DescuentoMonto,
                FechaInicio = promocion.FechaInicio,
                FechaFin = promocion.FechaFin,
                Activo = promocion.Activo
            };

            if (!string.IsNullOrEmpty(promocion.IdSucursal))
            {
                selectedSucursal = promocion.IdSucursal;

                busquedaSucursal = SucursalesDisponibles
                    .FirstOrDefault(s => s.Almacen == promocion.IdSucursal)?
                    .NombreCompleto
                    ?? promocion.IdSucursal;
            }

            if (!string.IsNullOrEmpty(promocion.ApplicationUserId))
            {
                var creador = await UserManager
                    .FindByIdAsync(promocion.ApplicationUserId);

                nombreCreador = creador?.NombreCompleto
                    ?? creador?.Email
                    ?? "Usuario";
            }
        }
        catch (Exception ex)
        {
            error = $"Error al cargar la promoción: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private void SeleccionarTipoPromocion(string tipo)
    {
        modelo.TipoPromocion = tipo;

        if (tipo == "Catalogo")
        {
            modelo.Precio = null;
            modelo.DescuentoPorcentaje = null;
            modelo.DescuentoMonto = null;
        }

        StateHasChanged();
    }

    private void AbrirDropdownSucursal()
    {
        mostrarDropdownSucursal = true;
    }

    private void SeleccionarSucursal(SucursalCyc sucursal)
    {
        selectedSucursal = sucursal.Almacen;

        busquedaSucursal = sucursal.NombreCompleto
            ?? sucursal.Almacen;

        mostrarDropdownSucursal = false;
        errorSucursal = false;
        mensajeErrorSucursal = "";
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;

        if (file == null)
        {
            return;
        }

        try
        {
            if (file.Size > MaxFileSize)
            {
                var tamañoMB = file.Size / (1024.0 * 1024.0);

                error = $"El archivo no puede superar los 100MB. Tu archivo pesa {tamañoMB:F1}MB.";

                nombreArchivoNuevo = null;
                archivoBase64 = null;
                archivoContentType = null;

                return;
            }

            nombreArchivoNuevo = file.Name;
            archivoContentType = file.ContentType;

            using var stream = file.OpenReadStream(MaxFileSize);
            using var ms = new MemoryStream();

            await stream.CopyToAsync(ms);

            archivoBase64 = Convert.ToBase64String(ms.ToArray());

            error = null;
        }
        catch (Exception ex)
        {
            error = $"Error al cargar el archivo: {ex.Message}";
        }
    }

    private void EliminarArchivoNuevo()
    {
        nombreArchivoNuevo = null;
        archivoBase64 = null;
        archivoContentType = null;
        error = null;
    }

    private async Task GuardarPromocion()
    {
        if (promocion == null)
        {
            return;
        }

        guardando = true;
        error = null;
        mensajeExito = null;
        errorSucursal = false;
        mensajeErrorSucursal = "";

        StateHasChanged();

        try
        {
            if (string.IsNullOrWhiteSpace(modelo.TipoPromocion))
            {
                error = "Debes seleccionar el tipo de promoción.";
                return;
            }

            if (modelo.TipoPromocion == "PrecioUnico")
            {
                if (!modelo.Precio.HasValue ||
                    modelo.Precio.Value <= 0)
                {
                    error = "Debes ingresar un precio válido.";
                    return;
                }
            }
            else
            {
                modelo.Precio = null;
                modelo.DescuentoPorcentaje = null;
                modelo.DescuentoMonto = null;
            }

            if (modelo.FechaInicio > modelo.FechaFin)
            {
                error = "La fecha de inicio no puede ser mayor a la fecha de fin.";
                return;
            }

            if (string.IsNullOrEmpty(selectedSucursal))
            {
                error = "Debes seleccionar una sucursal.";
                errorSucursal = true;
                mensajeErrorSucursal = "Debes seleccionar una sucursal";
                return;
            }

            promocion.Titulo = modelo.Titulo;
            promocion.Descripcion = modelo.Descripcion ?? "";
            promocion.TipoPromocion = modelo.TipoPromocion;

            promocion.Precio =
                modelo.TipoPromocion == "PrecioUnico"
                    ? modelo.Precio
                    : null;

            promocion.DescuentoPorcentaje =
                modelo.TipoPromocion == "PrecioUnico"
                    ? modelo.DescuentoPorcentaje
                    : null;

            promocion.DescuentoMonto =
                modelo.TipoPromocion == "PrecioUnico"
                    ? modelo.DescuentoMonto
                    : null;

            promocion.FechaInicio = modelo.FechaInicio;
            promocion.FechaFin = modelo.FechaFin;
            promocion.Activo = modelo.Activo;
            promocion.FechaActualizacion = DateTime.Now;
            promocion.IdSucursal = selectedSucursal;

            if (!string.IsNullOrEmpty(archivoBase64) &&
                !string.IsNullOrEmpty(nombreArchivoNuevo))
            {
                var uploadsFolder = Path.Combine(
                    WebHostEnvironment.WebRootPath,
                    "uploads",
                    "promociones");

                Directory.CreateDirectory(uploadsFolder);

                var extension = Path.GetExtension(nombreArchivoNuevo);

                var fileName =
                    $"{promocion.TokenUnico}_{DateTime.Now.Ticks}{extension}";

                var filePath = Path.Combine(
                    uploadsFolder,
                    fileName);

                var bytes = Convert.FromBase64String(
                    archivoBase64);

                await File.WriteAllBytesAsync(
                    filePath,
                    bytes);

                promocion.pdf_url =
                    $"/uploads/promociones/{fileName}";

                promocion.pdf_nombre =
                    nombreArchivoNuevo;

                promocion.pdf_ruta =
                    filePath;
            }

            await DbContext.SaveChangesAsync();

            mensajeExito =
                $"Promoción '{modelo.Titulo}' actualizada correctamente!";

            await JS.InvokeVoidAsync(
                "Swal.fire",
                new
                {
                    title = "¡Éxito!",
                    text = mensajeExito,
                    icon = "success",
                    confirmButtonText = "Aceptar",
                    confirmButtonColor = "#0f172a",
                    timer = 2000,
                    showConfirmButton = false
                });

            await Task.Delay(1500);

            NavigationManager.NavigateTo(
                "/promociones");
        }
        catch (Exception ex)
        {
            if (ex is DbUpdateException dbEx)
            {
                error =
                    $"Error de base de datos: {dbEx.InnerException?.Message ?? dbEx.Message}";
            }
            else
            {
                error =
                    $"Error al guardar: {ex.Message}";
            }

            StateHasChanged();
        }
        finally
        {
            guardando = false;
            StateHasChanged();
        }
    }

    private void Volver()
    {
        NavigationManager.NavigateTo(
            "/promociones");
    }

    private class PromocionModel
    {
        [Required(ErrorMessage = "El título es obligatorio")]
        [StringLength(
            100,
            MinimumLength = 3,
            ErrorMessage = "El título debe tener entre 3 y 100 caracteres")]
        public string Titulo { get; set; } = "";

        [Required(ErrorMessage = "La descripción es obligatoria")]
        [StringLength(
            500,
            ErrorMessage = "La descripción no puede exceder los 500 caracteres")]
        public string Descripcion { get; set; } = "";

        [Required(ErrorMessage = "El tipo de promoción es obligatorio")]
        public string TipoPromocion { get; set; } = "Catalogo";

        [Range(
            0.01,
            999999.99,
            ErrorMessage = "El precio debe ser mayor a 0")]
        public decimal? Precio { get; set; }

        [Range(
            0,
            100,
            ErrorMessage = "El descuento debe estar entre 0 y 100%")]
        public decimal? DescuentoPorcentaje { get; set; }

        [Range(
            0,
            999999,
            ErrorMessage = "El monto debe ser mayor o igual a 0")]
        public decimal? DescuentoMonto { get; set; }

        [Required(ErrorMessage = "La fecha de inicio es obligatoria")]
        public DateTime FechaInicio { get; set; } =
            DateTime.Today;

        [Required(ErrorMessage = "La fecha de fin es obligatoria")]
        public DateTime FechaFin { get; set; } =
            DateTime.Today.AddDays(30);

        public bool Activo { get; set; } = true;
    }
}