@page "/promociones/crear"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using RamsCottons.Models
@using RamsCottons.Data
@using RamsCottons.Models.CycData
@using RamsCottons.Services
@using System.ComponentModel.DataAnnotations

@attribute [Authorize]

@inject ApplicationDbContext DbContext
@inject NavigationManager NavigationManager
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IWebHostEnvironment WebHostEnvironment
@inject IJSRuntime JS
@inject SucursalService SucursalService

<PageTitle>Nueva Promoción | RAMS Cottons</PageTitle>

<div class="crear-promo-container">
    <br />

    <div class="dashboard-header">
        <div class="header-content">
            <div class="header-title">
                <div class="title-icon">
                    <i class="bi bi-megaphone-fill"></i>
                </div>

                <div>
                    <h1>Nueva Promoción</h1>
                    <p class="subtitle">Crea una nueva promoción y compártela al instante</p>
                </div>
            </div>

            <button type="button" class="btn-back" @onclick="Volver">
                <span>Volver</span>
            </button>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-7">
            <div class="form-card">
                <div class="card-header">
                    <div class="header-left">
                        <i class="bi bi-file-pdf-fill"></i>
                        <h3>Subir Promoción</h3>
                    </div>

                    <span class="required-badge">
                        * Campos obligatorios
                    </span>
                </div>

                <div class="card-body">
                    <EditForm Model="modelo"
                              OnValidSubmit="GuardarPromocion"
                              FormName="crearPromocion">

                        <DataAnnotationsValidator />
                        <ValidationSummary class="validation-summary" />

                        <div class="form-grid">
                            <div class="form-group full-width">
                                <label class="form-label">
                                    Título de la Promoción
                                    <span class="text-danger">*</span>
                                </label>

                                <div class="input-wrapper">
                                    <i class="bi bi-tag input-icon"></i>

                                    <InputText @bind-Value="modelo.Titulo"
                                               class="form-control"
                                               placeholder="Ej: Catálogo Rams Cottons Dama Septiembre 2026" />
                                </div>

                                <ValidationMessage For="() => modelo.Titulo"
                                                   class="validation-message" />
                            </div>

                            <div class="form-group full-width">
                                <label class="form-label">
                                    Descripción
                                    <span class="text-danger">*</span>
                                </label>

                                <div class="input-wrapper">
                                    <i class="bi bi-file-text input-icon"></i>

                                    <InputTextArea @bind-Value="modelo.Descripcion"
                                                   class="form-control"
                                                   rows="3"
                                                   placeholder="Describe el contenido o los beneficios de esta promoción..." />
                                </div>

                                <ValidationMessage For="() => modelo.Descripcion"
                                                   class="validation-message" />
                            </div>

                            <div class="form-group full-width">
                                <label class="form-label">
                                    Tipo de Promoción
                                    <span class="text-danger">*</span>
                                </label>

                                <div class="tipo-promocion-grid">
                                    <div class="tipo-promocion-card @(modelo.TipoPromocion == "Catalogo" ? "selected" : "")"
                                         @onclick='() => SeleccionarTipoPromocion("Catalogo")'>

                                        <div class="radio-custom @(modelo.TipoPromocion == "Catalogo" ? "checked" : "")">
                                            @if (modelo.TipoPromocion == "Catalogo")
                                            {
                                                <div class="radio-dot"></div>
                                            }
                                        </div>

                                        <div class="tipo-promocion-icon">
                                            <i class="bi bi-journal-richtext"></i>
                                        </div>

                                        <div class="tipo-promocion-info">
                                            <strong>Catálogo / Múltiples productos</strong>
                                            <span>El archivo contiene varios productos con diferentes precios.</span>
                                        </div>
                                    </div>

                                    <div class="tipo-promocion-card @(modelo.TipoPromocion == "PrecioUnico" ? "selected" : "")"
                                         @onclick='() => SeleccionarTipoPromocion("PrecioUnico")'>

                                        <div class="radio-custom @(modelo.TipoPromocion == "PrecioUnico" ? "checked" : "")">
                                            @if (modelo.TipoPromocion == "PrecioUnico")
                                            {
                                                <div class="radio-dot"></div>
                                            }
                                        </div>

                                        <div class="tipo-promocion-icon">
                                            <i class="bi bi-tag-fill"></i>
                                        </div>

                                        <div class="tipo-promocion-info">
                                            <strong>Promoción de precio único</strong>
                                            <span>La promoción tiene un solo precio y puede incluir descuento.</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            @if (modelo.TipoPromocion == "PrecioUnico")
                            {
                                <div class="form-group">
                                    <label class="form-label">
                                        Precio
                                        <span class="text-danger">*</span>
                                    </label>

                                    <div class="input-wrapper">
                                        <i class="bi bi-currency-dollar input-icon"></i>

                                        <InputNumber @bind-Value="modelo.Precio"
                                                     class="form-control"
                                                     placeholder="Ej: 500" />
                                    </div>

                                    <ValidationMessage For="() => modelo.Precio"
                                                       class="validation-message" />
                                </div>

                                <div class="form-group">
                                    <label class="form-label">
                                        Descuento (%)
                                    </label>

                                    <div class="input-wrapper">
                                        <i class="bi bi-percent input-icon"></i>

                                        <InputNumber @bind-Value="modelo.DescuentoPorcentaje"
                                                     class="form-control"
                                                     placeholder="Ej: 20" />
                                    </div>

                                    <ValidationMessage For="() => modelo.DescuentoPorcentaje"
                                                       class="validation-message" />
                                </div>

                                <div class="form-group">
                                    <label class="form-label">
                                        Descuento (Monto)
                                    </label>

                                    <div class="input-wrapper">
                                        <i class="bi bi-currency-dollar input-icon"></i>

                                        <InputNumber @bind-Value="modelo.DescuentoMonto"
                                                     class="form-control"
                                                     placeholder="Ej: 100" />
                                    </div>

                                    <ValidationMessage For="() => modelo.DescuentoMonto"
                                                       class="validation-message" />
                                </div>
                            }

                            <div class="form-group">
                                <label class="form-label">
                                    Fecha de Inicio
                                    <span class="text-danger">*</span>
                                </label>

                                <div class="input-wrapper @(errorFechaInicio ? "is-invalid-wrapper" : "")">
                                    <i class="bi bi-calendar-plus input-icon"
                                       style="cursor:pointer; pointer-events:auto;"
                                       onclick="const el = document.getElementById('fechaInicio'); if(el.showPicker){el.showPicker();} else {el.focus(); el.click();}"></i>

                                    <InputDate @bind-Value="modelo.FechaInicio"
                                               id="fechaInicio"
                                               class="form-control" />
                                </div>

                                <ValidationMessage For="() => modelo.FechaInicio"
                                                   class="validation-message" />
                            </div>

                            <div class="form-group">
                                <label class="form-label">
                                    Fecha de Fin
                                    <span class="text-danger">*</span>
                                </label>

                                <div class="input-wrapper @(errorFechaFin ? "is-invalid-wrapper" : "")">
                                    <i class="bi bi-calendar-x input-icon"
                                       style="cursor:pointer; pointer-events:auto;"
                                       onclick="const el = document.getElementById('fechaFin'); if(el.showPicker){el.showPicker();} else {el.focus(); el.click();}"></i>

                                    <InputDate @bind-Value="modelo.FechaFin"
                                               id="fechaFin"
                                               class="form-control" />
                                </div>

                                <ValidationMessage For="() => modelo.FechaFin"
                                                   class="validation-message" />
                            </div>

                            <div class="form-group">
                                <label class="form-label">
                                    Estado
                                </label>

                                <div class="input-wrapper">
                                    <i class="bi @(modelo.Activo ? "bi-check-circle-fill text-success" : "bi-x-circle-fill text-danger") input-icon"></i>

                                    <div class="status-toggle">
                                        <label class="toggle-switch">
                                            <InputCheckbox @bind-Value="modelo.Activo" />
                                            <span class="toggle-slider"></span>
                                        </label>

                                        <span class="status-text @(modelo.Activo ? "status-active-text" : "status-inactive-text")">
                                            @(modelo.Activo ? "Activa" : "Inactiva")
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group full-width">
                                <label class="form-label">
                                    Sucursal
                                    <span class="text-danger">*</span>
                                </label>

                                <div class="sucursal-search-wrapper @(errorSucursal ? "has-error" : "")">
                                    <i class="bi bi-shop"></i>

                                    <input type="text"
                                           class="sucursal-search-input"
                                           placeholder="Busca y selecciona una sucursal..."
                                           @bind="busquedaSucursal"
                                           @bind:event="oninput"
                                           @onfocus="AbrirDropdownSucursal" />

                                    <i class="bi bi-chevron-down sucursal-search-arrow @(mostrarDropdownSucursal ? "rotated" : "")"></i>

                                    @if (mostrarDropdownSucursal)
                                    {
                                        <div class="sucursal-dropdown">
                                            @if (sucursalesFiltradas.Any())
                                            {
                                                @foreach (var sucursal in sucursalesFiltradas)
                                                {
                                                    <div class="sucursal-dropdown-item @(selectedSucursal == sucursal.Almacen ? "selected" : "")"
                                                         @onmousedown:preventDefault
                                                         @onclick="() => SeleccionarSucursal(sucursal)">

                                                        <span class="sucursal-almacen">
                                                            @sucursal.Almacen
                                                        </span>

                                                        <span class="sucursal-nombre">
                                                            @sucursal.NombreCompleto
                                                        </span>
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <div class="sucursal-dropdown-empty">
                                                    <i class="bi bi-search"></i>
                                                    No se encontraron sucursales
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>

                                @if (errorSucursal)
                                {
                                    <div class="validation-message"
                                         style="margin-top:0.25rem;">

                                        <i class="bi bi-exclamation-circle-fill me-1"></i>
                                        @mensajeErrorSucursal
                                    </div>
                                }
                            </div>

                            <div class="form-group full-width">
                                <label class="form-label">
                                    Archivo de la Promoción
                                    <span class="text-danger">*</span>
                                </label>

                                <div class="file-upload-container">
                                    <label for="fileInput"
                                           class="file-upload-btn @(errorArchivo ? "btn-file-error" : "")">

                                        <i class="bi bi-cloud-upload-fill"></i>
                                        <span>Seleccionar archivo</span>
                                    </label>

                                    <span class="file-name @(errorArchivo ? "text-danger" : "")">
                                        @(string.IsNullOrEmpty(nombreArchivo)
                                            ? "Ningún archivo seleccionado (máx. 100MB)"
                                            : nombreArchivo)
                                    </span>

                                    <InputFile id="fileInput"
                                               OnChange="OnFileSelected"
                                               accept=".pdf,.jpg,.jpeg,.png"
                                               style="display:none" />
                                </div>

                                @if (errorArchivo)
                                {
                                    <div class="validation-message"
                                         style="margin-top:0.5rem;">

                                        <i class="bi bi-exclamation-circle-fill me-1"></i>
                                        @error
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(nombreArchivo))
                                {
                                    <div class="selected-file-info">

                                        <i class="bi @(nombreArchivo.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase)
                                            ? "bi-file-earmark-pdf-fill"
                                            : "bi-file-earmark-image-fill")"></i>

                                        <span>@nombreArchivo</span>

                                        <button type="button"
                                                class="btn-remove-file"
                                                @onclick="EliminarArchivo">

                                            <i class="bi bi-x"></i>
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="form-actions">
                            <button type="submit"
                                    class="btn-submit"
                                    disabled="@guardando">

                                @(guardando ? "Guardando..." : "Crear Promoción")
                            </button>

                            <button type="button"
                                    class="btn-cancel"
                                    @onclick="Volver">

                                Cancelar
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="info-card">
                <div class="info-card-header">
                    <i class="bi bi-lightbulb"></i>
                    <h4>¿Cómo funciona?</h4>
                </div>

                <div class="info-card-body">
                    <div class="process-step">
                        <div class="step-number">1</div>
                        <div class="step-text">
                            Selecciona el tipo de promoción
                        </div>
                    </div>

                    <div class="process-step">
                        <div class="step-number">2</div>
                        <div class="step-text">
                            Completa los datos de la promoción
                        </div>
                    </div>

                    <div class="process-step">
                        <div class="step-number">3</div>
                        <div class="step-text">
                            Sube tu archivo PDF o imagen
                        </div>
                    </div>

                    <div class="process-step">
                        <div class="step-number">4</div>
                        <div class="step-text">
                            Se genera un enlace único automáticamente
                        </div>
                    </div>

                    <div class="process-step">
                        <div class="step-number">5</div>
                        <div class="step-text">
                            Comparte el enlace por WhatsApp
                        </div>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(enlaceGenerado))
            {
                <div class="link-card">
                    <div class="link-card-header">
                        <i class="bi bi-link-45deg"></i>
                        <h4>¡Promoción creada!</h4>
                    </div>

                    <div class="link-card-body">
                        <div class="link-container">
                            <input type="text"
                                   id="enlacePromocion"
                                   value="@enlaceGenerado"
                                   readonly
                                   class="link-input" />

                            <button type="button"
                                    class="btn-copy"
                                    @onclick="CopiarEnlace">

                                <i class="bi bi-files"></i>
                            </button>
                        </div>

                        <div class="whatsapp-link">
                            <a href="@($"https://wa.me/?text={Uri.EscapeDataString("¡Mira esta promoción! " + enlaceGenerado)}")"
                               target="_blank"
                               class="btn-whatsapp-share">

                                <i class="bi bi-whatsapp"></i>
                                Compartir por WhatsApp
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(mensajeExito))
    {
        <div class="toast-notification toast-success">
            <i class="bi bi-check-circle-fill"></i>
            <span>@mensajeExito</span>
        </div>
    }

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="toast-notification toast-error">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>@error</span>
        </div>
    }
</div>

@code {
    private PromocionModel modelo = new();

    private bool guardando = false;
    private bool errorArchivo = false;
    private bool errorFechaInicio = false;
    private bool errorFechaFin = false;
    private bool errorSucursal = false;
    private bool esSuperAdmin = false;
    private bool esAdmin = false;
    private bool mostrarDropdownSucursal = false;

    private string? error;
    private string? mensajeExito;
    private string? enlaceGenerado;
    private string? nombreArchivo;
    private string? archivoBase64;
    private string? archivoContentType;
    private string? selectedSucursal;
    private string? sucursalUsuarioActual;
    private string usuarioId = "";
    private string busquedaSucursal = "";
    private string mensajeErrorSucursal = "";

    private List<SucursalCyc> SucursalesDisponibles = new();

    private const long MaxFileSize = 100 * 1024 * 1024;

    private IEnumerable<SucursalCyc> sucursalesFiltradas =>
        string.IsNullOrWhiteSpace(busquedaSucursal)
            ? SucursalesDisponibles
            : SucursalesDisponibles.Where(s =>
                s.Almacen.Contains(
                    busquedaSucursal,
                    StringComparison.OrdinalIgnoreCase
                ) ||
                (
                    s.NombreCompleto != null &&
                    s.NombreCompleto.Contains(
                        busquedaSucursal,
                        StringComparison.OrdinalIgnoreCase
                    )
                )
            );

    protected override async Task OnInitializedAsync()
    {
        await CargarUsuarioActual();
        CargarSucursales();
    }

    private async Task CargarUsuarioActual()
    {
        var authState =
            await AuthenticationStateProvider
                .GetAuthenticationStateAsync();

        var user = authState.User;

        esSuperAdmin =
            user.IsInRole("SuperAdministrador");

        esAdmin =
            user.IsInRole("Administrador");

        var usuario =
            await UserManager.GetUserAsync(user);

        if (usuario != null)
        {
            usuarioId = usuario.Id;
            sucursalUsuarioActual = usuario.IdSucursal;
        }
    }

    private void CargarSucursales()
    {
        SucursalesDisponibles =
            SucursalService.GetAllSucursales();
    }

    private void AbrirDropdownSucursal()
    {
        mostrarDropdownSucursal = true;
    }

    private void SeleccionarTipoPromocion(string tipo)
    {
        modelo.TipoPromocion = tipo;

        if (tipo == "Catalogo")
        {
            modelo.Precio = null;
            modelo.DescuentoPorcentaje = null;
            modelo.DescuentoMonto = null;
        }

        StateHasChanged();
    }

    private void SeleccionarSucursal(SucursalCyc sucursal)
    {
        selectedSucursal =
            sucursal.Almacen;

        busquedaSucursal =
            sucursal.NombreCompleto ??
            sucursal.Almacen;

        mostrarDropdownSucursal = false;
        errorSucursal = false;
        mensajeErrorSucursal = "";
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;

        if (file == null)
        {
            return;
        }

        try
        {
            if (file.Size > MaxFileSize)
            {
                var tamañoMB =
                    file.Size / (1024.0 * 1024.0);

                error =
                    $"El archivo no puede superar los 100MB. Tu archivo pesa {tamañoMB:F1}MB.";

                errorArchivo = true;
                nombreArchivo = null;
                archivoBase64 = null;
                archivoContentType = null;

                StateHasChanged();

                return;
            }

            nombreArchivo =
                file.Name;

            archivoContentType =
                file.ContentType;

            using var stream =
                file.OpenReadStream(MaxFileSize);

            using var ms =
                new MemoryStream();

            await stream.CopyToAsync(ms);

            archivoBase64 =
                Convert.ToBase64String(
                    ms.ToArray()
                );

            error = null;
            errorArchivo = false;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            error =
                $"Error al cargar el archivo: {ex.Message}";

            errorArchivo = true;

            StateHasChanged();
        }
    }

    private void EliminarArchivo()
    {
        nombreArchivo = null;
        archivoBase64 = null;
        archivoContentType = null;
        errorArchivo = false;
        error = null;
    }

    private async Task GuardarPromocion()
    {
        guardando = true;
        error = null;
        mensajeExito = null;
        errorArchivo = false;
        errorFechaInicio = false;
        errorFechaFin = false;
        errorSucursal = false;
        mensajeErrorSucursal = "";

        StateHasChanged();

        try
        {
            if (string.IsNullOrWhiteSpace(modelo.TipoPromocion))
            {
                error =
                    "Debes seleccionar el tipo de promoción.";

                return;
            }

            if (modelo.TipoPromocion == "PrecioUnico")
            {
                if (!modelo.Precio.HasValue ||
                    modelo.Precio.Value <= 0)
                {
                    error =
                        "Debes ingresar un precio válido para la promoción.";

                    return;
                }
            }
            else
            {
                modelo.Precio = null;
                modelo.DescuentoPorcentaje = null;
                modelo.DescuentoMonto = null;
            }

            if (string.IsNullOrEmpty(archivoBase64))
            {
                error =
                    "Debes seleccionar un archivo para la promoción.";

                errorArchivo = true;

                return;
            }

            if (modelo.FechaInicio > modelo.FechaFin)
            {
                error =
                    "La fecha de inicio no puede ser mayor a la fecha de fin.";

                errorFechaInicio = true;
                errorFechaFin = true;

                return;
            }

            string idSucursal;

            if (esSuperAdmin || esAdmin)
            {
                if (string.IsNullOrEmpty(selectedSucursal))
                {
                    error =
                        "Debes seleccionar una sucursal para esta promoción.";

                    errorSucursal = true;

                    mensajeErrorSucursal =
                        "Debes seleccionar una sucursal";

                    return;
                }

                idSucursal =
                    selectedSucursal;
            }
            else
            {
                if (string.IsNullOrEmpty(sucursalUsuarioActual))
                {
                    error =
                        "Tu usuario no tiene una sucursal asignada.";

                    return;
                }

                idSucursal =
                    sucursalUsuarioActual;
            }

            var tokenUnico =
                Guid.NewGuid()
                    .ToString("N")
                    .Substring(0, 12)
                    .ToUpper();

            var baseUrl =
                "https://rams.no-ip.info:8082";

            var enlace =
                $"{baseUrl}/promociones/{tokenUnico}";

            var uploadsFolder =
                Path.Combine(
                    WebHostEnvironment.WebRootPath,
                    "uploads",
                    "promociones"
                );

            Directory.CreateDirectory(
                uploadsFolder
            );

            var extension =
                Path.GetExtension(nombreArchivo);

            var fileName =
                $"{tokenUnico}_{DateTime.Now.Ticks}{extension}";

            var filePath =
                Path.Combine(
                    uploadsFolder,
                    fileName
                );

            var bytes =
                Convert.FromBase64String(
                    archivoBase64
                );

            await File.WriteAllBytesAsync(
                filePath,
                bytes
            );

            var archivoUrl =
                $"/uploads/promociones/{fileName}";

            var promocion = new Promocion
            {
                Titulo = modelo.Titulo,
                Descripcion = modelo.Descripcion ?? "",
                TipoPromocion = modelo.TipoPromocion,

                Precio =
                    modelo.TipoPromocion == "PrecioUnico"
                        ? modelo.Precio
                        : null,

                DescuentoPorcentaje =
                    modelo.TipoPromocion == "PrecioUnico"
                        ? modelo.DescuentoPorcentaje
                        : null,

                DescuentoMonto =
                    modelo.TipoPromocion == "PrecioUnico"
                        ? modelo.DescuentoMonto
                        : null,

                FechaInicio = modelo.FechaInicio,
                FechaFin = modelo.FechaFin,
                TokenUnico = tokenUnico,
                pdf_nombre = nombreArchivo,
                pdf_ruta = filePath,
                pdf_url = archivoUrl,
                Activo = modelo.Activo,
                FechaCreacion = DateTime.Now,
                ApplicationUserId = usuarioId,
                IdSucursal = idSucursal
            };

            DbContext.Promociones.Add(
                promocion
            );

            await DbContext.SaveChangesAsync();

            enlaceGenerado = enlace;

            mensajeExito =
                $"Promoción '{modelo.Titulo}' creada correctamente!";

            await JS.InvokeVoidAsync(
                "Swal.fire",
                new
                {
                    title = "¡Éxito!",
                    text = mensajeExito,
                    icon = "success",
                    confirmButtonText = "Aceptar",
                    confirmButtonColor = "#0f172a",
                    timer = 1500,
                    showConfirmButton = false
                }
            );

            NavigationManager.NavigateTo(
                "/promociones",
                forceLoad: true
            );
        }
        catch (Exception ex)
        {
            error =
                $"Error inesperado: {ex.Message}";

            await JS.InvokeVoidAsync(
                "Swal.fire",
                new
                {
                    title = "Error",
                    text = error,
                    icon = "error",
                    confirmButtonText = "Aceptar",
                    confirmButtonColor = "#ef4444"
                }
            );
        }
        finally
        {
            guardando = false;

            StateHasChanged();
        }
    }

    private async Task CopiarEnlace()
    {
        if (string.IsNullOrEmpty(enlaceGenerado))
        {
            return;
        }

        await JS.InvokeVoidAsync(
            "navigator.clipboard.writeText",
            enlaceGenerado
        );

        mensajeExito =
            "Enlace copiado al portapapeles";

        await Task.Delay(2000);

        mensajeExito = null;
    }

    private void Volver()
    {
        NavigationManager.NavigateTo(
            "/promociones"
        );
    }

    private class PromocionModel
    {
        [Required(
            ErrorMessage =
                "El título es obligatorio"
        )]
        [StringLength(
            100,
            MinimumLength = 3,
            ErrorMessage =
                "El título debe tener entre 3 y 100 caracteres"
        )]
        public string Titulo { get; set; } = "";

        [Required(
            ErrorMessage =
                "La descripción es obligatoria"
        )]
        [StringLength(
            500,
            ErrorMessage =
                "La descripción no puede exceder los 500 caracteres"
        )]
        public string Descripcion { get; set; } = "";

        [Required(
            ErrorMessage =
                "El tipo de promoción es obligatorio"
        )]
        public string TipoPromocion { get; set; } = "Catalogo";

        [Range(
            0.01,
            999999.99,
            ErrorMessage =
                "El precio debe ser mayor a 0"
        )]
        public decimal? Precio { get; set; }

        [Range(
            0,
            100,
            ErrorMessage =
                "El descuento debe estar entre 0 y 100%"
        )]
        public decimal? DescuentoPorcentaje { get; set; }

        [Range(
            0,
            999999,
            ErrorMessage =
                "El monto debe ser mayor o igual a 0"
        )]
        public decimal? DescuentoMonto { get; set; }

        [Required(
            ErrorMessage =
                "La fecha de inicio es obligatoria"
        )]
        public DateTime FechaInicio { get; set; } =
            DateTime.Today;

        [Required(
            ErrorMessage =
                "La fecha de fin es obligatoria"
        )]
        public DateTime FechaFin { get; set; } =
            DateTime.Today.AddDays(30);

        public bool Activo { get; set; } = true;
    }
}