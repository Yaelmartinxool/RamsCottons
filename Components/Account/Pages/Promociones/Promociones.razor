@page "/promociones"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using RamsCottons.Models
@using RamsCottons.Data
@using RamsCottons.Models.CycData
@using RamsCottons.Services
@attribute [Authorize]

@inject ApplicationDbContext DbContext
@inject NavigationManager NavigationManager
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS
@inject SucursalService SucursalService

<PageTitle>Gestión de Promociones | RAMS Cottons</PageTitle>

<div class="promociones-container">
    <br>
    <!-- Header -->
    <div class="dashboard-header">
        <div class="header-content">
            <div class="header-title">
                <div class="title-icon">
                    <i class="bi bi-megaphone-fill"></i>
                </div>
                <div>
                    <h1>Gestión de Promociones</h1>
                    <p class="subtitle">Administra las promociones del sistema</p>
                </div>
            </div>
            <button class="btn-create" @onclick="CrearPromocion">
                <i class="bi bi-plus-lg"></i>
                <span>Nueva Promoción</span>
            </button>
        </div>
    </div>

    <!-- Control Panel -->
    <div class="control-panel">
        <div class="panel-header">
            <div class="panel-title">
                <i class="bi bi-table"></i>
                <h3>Tabla de Promociones</h3>
            </div>
            <div class="panel-actions">
                <div class="search-box">
                    <i class="bi bi-search"></i>
                    <input type="text" @bind="filtro" @bind:event="oninput" placeholder="Buscar promociones...">
                </div>
                <div class="action-buttons">
                    <button class="btn-filter" @onclick="ToggleFilters">
                        <i class="bi bi-funnel"></i>
                        Filtros
                    </button>
                    <button class="btn-refresh" @onclick="CargarPromociones">
                        <i class="bi bi-arrow-clockwise @(cargando ? "fa-spin" : "")"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Filtros -->
        <div class="filters-panel @(mostrarFiltros ? "show" : "")">
            <div class="filter-row">
                <div class="filter-group">
                    <label>Estado</label>
                    <select class="select-custom" @bind="filtroEstado">
                        <option value="">Todos</option>
                        <option value="activo">Activas</option>
                        <option value="inactivo">Inactivas</option>
                    </select>
                </div>

                <div class="filter-group">
                    <label>Ordenar por</label>
                    <select class="select-custom" @bind="ordenarPor">
                        <option value="reciente">Más recientes primero</option>
                        <option value="antiguo">Más antiguos primero</option>
                        <option value="titulo">Título A-Z</option>
                        <option value="fechaFin">Fecha de fin</option>
                    </select>
                </div>

                <div class="filter-group">
                    <label>Filas por página</label>
                    <select class="select-custom" @bind="elementosPorPagina">
                        <option value="5">5</option>
                        <option value="10">10</option>
                        <option value="15" selected>15</option>
                        <option value="20">20</option>
                        <option value="25">25</option>
                        <option value="30">30</option>
                    </select>
                </div>
            </div>

            <div class="filter-row">
                <!-- BUSCADOR DE SUCURSAL CON DROPDOWN -->
                <div class="filter-group">
                    <label>Sucursal</label>
                    <div class="sucursal-search-wrapper">
                        <i class="bi bi-shop"></i>
                        <input type="text" 
                               class="sucursal-search-input" 
                               placeholder="Busca y selecciona una sucursal..."
                               @bind="busquedaSucursal"
                               @bind:event="oninput"
                               @onfocus="AbrirDropdownSucursal" />
                        <i class="bi bi-chevron-down sucursal-search-arrow @(mostrarDropdownSucursal ? "rotated" : "")"></i>
                        
                        @if (mostrarDropdownSucursal)
                        {
                            <div class="sucursal-dropdown">
                                <div class="sucursal-dropdown-item @(string.IsNullOrEmpty(filtroSucursal) ? "selected" : "")"
                                     @onmousedown:preventDefault
                                     @onclick="() => SeleccionarSucursal(null)">
                                    <i class="bi bi-x-circle"></i>
                                    <span class="sucursal-nombre">Todas las sucursales</span>
                                </div>
                                
                                @if (sucursalesFiltradas.Any())
                                {
                                    @foreach (var sucursal in sucursalesFiltradas)
                                    {
                                        <div class="sucursal-dropdown-item @(filtroSucursal == sucursal.Almacen ? "selected" : "")"
                                             @onmousedown:preventDefault
                                             @onclick="() => SeleccionarSucursal(sucursal)">
                                            <span class="sucursal-almacen">@sucursal.Almacen</span>
                                            <span class="sucursal-nombre">@sucursal.NombreCompleto</span>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="sucursal-dropdown-empty">
                                        <i class="bi bi-search"></i>
                                        No se encontraron sucursales
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="filter-group">
                    <label>&nbsp;</label>
                    <button class="btn-clear-filters" @onclick="LimpiarFiltros">
                        <i class="bi bi-x-circle"></i>
                        Limpiar Filtros
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading -->
    @if (cargando)
    {
        <div class="loading-container">
            <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;"></div>
            <p class="mt-3 text-muted">Cargando promociones...</p>
        </div>
    }
    else
    {
        <!-- Main Table -->
        <div class="table-container">
            <div class="table-responsive">
                <table class="crud-table">
                    <thead>
                        <tr>
                            <th>Título</th>
                            <th>Precio</th>
                            <th>Descuento</th>
                            <th>Fecha Inicio</th>
                            <th>Fecha Fin</th>
                            <th>Sucursal</th>
                            <th>Estado</th>
                            <th>Enlace</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!promocionesPaginadas.Any())
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5">
                                    <div class="no-data">
                                        <i class="bi bi-megaphone display-4 text-muted"></i>
                                        <p class="mb-0">No hay promociones registradas</p>
<button class="btn-create-promo-empty" @onclick="CrearPromocion">
    <i class="bi bi-plus-lg"></i>
    <span>Crear primera promoción</span>
</button>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var promo in promocionesPaginadas)
                            {
                                var enlace = $"https://rams.no-ip.info:8082/promociones/{promo.TokenUnico}";
                                <tr class="promo-row">
                                    <td class="col-titulo">
                                        <div class="titulo-info">
                                            <i class="bi @(promo.pdf_url?.EndsWith(".pdf") == true ? "bi-file-earmark-pdf-fill text-danger" : "bi-file-earmark-image-fill text-primary")"></i>
                                            <span class="titulo-nombre">@promo.Titulo</span>
                                        </div>
                                        <small class="text-muted">@promo.Descripcion</small>
                                    </td>
<td class="col-precio">
    @if (promo.TipoPromocion == "Catalogo")
    {
        <span class="precio">Varios precios</span>
    }
    else if (promo.Precio.HasValue)
    {
        <span class="precio">$@promo.Precio.Value.ToString("N2")</span>
    }
    else
    {
        <span class="text-muted">-</span>
    }
</td>
                                    <td class="col-descuento">
                                        @if (promo.DescuentoPorcentaje.HasValue)
                                        {
                                            <span class="descuento-badge">@promo.DescuentoPorcentaje% OFF</span>
                                        }
                                        else if (promo.DescuentoMonto.HasValue)
                                        {
                                            <span class="descuento-badge">$@promo.DescuentoMonto OFF</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td class="col-fecha">
                                        @promo.FechaInicio.ToString("dd/MM/yyyy")
                                    </td>
                                    <td class="col-fecha">
                                        @promo.FechaFin.ToString("dd/MM/yyyy")
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(promo.IdSucursal))
                                        {
                                            <span class="sucursal-badge">
                                                @GetSucursalNombreHtml(promo.IdSucursal)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td class="col-estado">
                                        <span class="status-badge @(promo.Activo ? "status-active" : "status-inactive")">
                                            <i class="bi @(promo.Activo ? "bi-check-circle-fill" : "bi-x-circle-fill")"></i>
                                            @(promo.Activo ? "Activa" : "Inactiva")
                                        </span>
                                    </td>
                                    <td class="col-enlace">
                                        <button class="btn-copy-link" @onclick="() => CopiarEnlace(enlace)">
                                            <i class="bi bi-files"></i>
                                            <span>Copiar</span>
                                        </button>
                                    </td>
                                    <td class="col-acciones">
                                        <div class="action-buttons">
                                            <button class="btn-action btn-edit" @onclick="() => EditarPromocion(promo.Id)" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button class="btn-action btn-toggle" @onclick="() => ToggleEstado(promo)" title="@(promo.Activo ? "Desactivar" : "Activar")">
                                                <i class="bi @(promo.Activo ? "bi-pause-circle" : "bi-play-circle")"></i>
                                            </button>
                                            <button class="btn-action btn-delete" @onclick="() => ConfirmarEliminar(promo)" title="Eliminar">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- Paginación -->
            @if (promocionesFiltradas.Any())
            {
                <div class="table-footer">
                    <div class="footer-info">
                        <div class="total-count">
                            Mostrando <span>@promocionesPaginadas.Count()</span> de <span>@promocionesFiltradas.Count()</span> promociones
                        </div>
                        <div class="pagination-info">
                            Página @paginaActual de @totalPaginas
                        </div>
                    </div>

                    @if (totalPaginas > 1)
                    {
                        <div class="pagination-wrapper">
                            <ul class="pagination">
                                <li class="page-item @(paginaActual == 1 ? "disabled" : "")">
                                    <button class="page-link" @onclick="() => CambiarPagina(paginaActual - 1)">
                                        <i class="bi bi-chevron-left"></i>
                                    </button>
                                </li>
                                @for (int i = 1; i <= totalPaginas; i++)
                                {
                                    if (i == 1 || i == totalPaginas || (i >= paginaActual - 2 && i <= paginaActual + 2))
                                    {
                                        <li class="page-item @(i == paginaActual ? "active" : "")">
                                            <button class="page-link" @onclick="() => CambiarPagina(i)">@i</button>
                                        </li>
                                    }
                                    else if (i == paginaActual - 3 || i == paginaActual + 3)
                                    {
                                        <li class="page-item disabled">
                                            <span class="page-link">...</span>
                                        </li>
                                    }
                                }
                                <li class="page-item @(paginaActual == totalPaginas ? "disabled" : "")">
                                    <button class="page-link" @onclick="() => CambiarPagina(paginaActual + 1)">
                                        <i class="bi bi-chevron-right"></i>
                                    </button>
                                </li>
                            </ul>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

<!-- Modal Eliminar Promoción -->
@if (mostrarModalEliminar && promocionEliminar != null)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(5px); z-index: 1050;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> Confirmar eliminación
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModalEliminar" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center p-4">
                    <div class="rounded-circle bg-danger bg-opacity-10 d-flex align-items-center justify-content-center mx-auto mb-4"
                         style="width: 80px; height: 80px;">
                        <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 2.5rem;"></i>
                    </div>
                    
                    <h5 class="fw-bold mb-3">¿Eliminar promoción?</h5>
                    <p class="text-muted mb-4">
                        Estás a punto de eliminar la promoción
                        <br />
                        <span class="fw-bold text-dark" style="font-size: 1.1rem;">@promocionEliminar.Titulo</span>
                        <br />
                        <span class="text-muted small">Esta acción no se puede deshacer.</span>
                    </p>
                </div>
                <div class="modal-footer justify-content-center border-0 pb-4">
                    <button class="btn btn-dark px-5 py-2 rounded-3" @onclick="CerrarModalEliminar">
                        Cancelar
                    </button>
                    <button class="btn btn-danger px-5 py-2 rounded-3" @onclick="EliminarPromocion">
                        Eliminar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Promocion> promociones = new();
    private List<SucursalCyc> SucursalesDisponibles = new();
    private Dictionary<string, string> SucursalesCache = new();
    private bool cargando = true;
    private bool mostrarFiltros = false;
    private string filtro = "";
    private string filtroEstado = "";
    private string filtroSucursal = "";
    private string ordenarPor = "reciente";
    private int paginaActual = 1;
    private int elementosPorPagina = 15;
    
    // Modal de confirmación para eliminar
    private bool mostrarModalEliminar = false;
    private Promocion? promocionEliminar;

    // Buscador de sucursal
    private string busquedaSucursal = "";
    private bool mostrarDropdownSucursal = false;

    // Variables para roles
    private bool esSuperAdmin = false;
    private bool esAdmin = false;

    // Propiedad para filtrar sucursales según búsqueda
    private IEnumerable<SucursalCyc> sucursalesFiltradas =>
        string.IsNullOrWhiteSpace(busquedaSucursal)
            ? SucursalesDisponibles
            : SucursalesDisponibles.Where(s =>
                s.Almacen.Contains(busquedaSucursal, StringComparison.OrdinalIgnoreCase) ||
                (s.NombreCompleto != null && s.NombreCompleto.Contains(busquedaSucursal, StringComparison.OrdinalIgnoreCase)));

    private IEnumerable<Promocion> promocionesFiltradas
    {
        get
        {
            var query = promociones.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(filtro))
            {
                query = query.Where(p =>
                    p.Titulo.Contains(filtro, StringComparison.OrdinalIgnoreCase) ||
                    (p.Descripcion != null && p.Descripcion.Contains(filtro, StringComparison.OrdinalIgnoreCase))
                );
            }

            if (filtroEstado == "activo")
            {
                query = query.Where(p => p.Activo);
            }
            else if (filtroEstado == "inactivo")
            {
                query = query.Where(p => !p.Activo);
            }

            if (!string.IsNullOrEmpty(filtroSucursal))
            {
                query = query.Where(p => p.IdSucursal == filtroSucursal);
            }

            query = ordenarPor switch
            {
                "antiguo" => query.OrderBy(p => p.FechaCreacion),
                "titulo" => query.OrderBy(p => p.Titulo),
                "fechaFin" => query.OrderBy(p => p.FechaFin),
                _ => query.OrderByDescending(p => p.FechaCreacion)
            };

            return query;
        }
    }

    private int totalPaginas => (int)Math.Ceiling((double)promocionesFiltradas.Count() / elementosPorPagina);
    
    private IEnumerable<Promocion> promocionesPaginadas =>
        promocionesFiltradas
            .Skip((paginaActual - 1) * elementosPorPagina)
            .Take(elementosPorPagina);

    protected override async Task OnInitializedAsync()
    {
        CargarSucursalesDisponibles();
        await CargarPromociones();
    }

    private void CargarSucursalesDisponibles()
    {
        SucursalesDisponibles = SucursalService.GetAllSucursales();
        SucursalesCache = SucursalesDisponibles.ToDictionary(s => s.Almacen, s => s.NombreCompleto);
    }

    private string GetSucursalNombre(string? almacen)
    {
        if (string.IsNullOrEmpty(almacen))
            return "Sin sucursal";

        if (SucursalesCache.TryGetValue(almacen, out var nombre))
            return nombre;

        return almacen;
    }

    /// <summary>
    /// Retorna el nombre de la sucursal con un salto de línea HTML
    /// SOLO si el nombre es largo (más de 35 caracteres) y tiene paréntesis con contenido real
    /// </summary>
    private MarkupString GetSucursalNombreHtml(string? almacen)
    {
        if (string.IsNullOrEmpty(almacen))
            return new MarkupString("Sin sucursal");

        if (!SucursalesCache.TryGetValue(almacen, out var nombre))
            return new MarkupString(almacen);

        if (nombre.Length <= 35)
            return new MarkupString(nombre);

        var indexParentesis = nombre.IndexOf('(');
        if (indexParentesis > 0)
        {
            var parte1 = nombre.Substring(0, indexParentesis).Trim();
            var parte2 = nombre.Substring(indexParentesis).Trim();

            var contenidoParentesis = parte2.Trim('(', ')', ' ').Trim();
            if (string.IsNullOrEmpty(contenidoParentesis) || contenidoParentesis == "." || contenidoParentesis.Length <= 2)
            {
                return new MarkupString(nombre);
            }

            return new MarkupString($"{parte1}<br/>{parte2}");
        }

        return new MarkupString(nombre);
    }

    private async Task CargarPromociones()
    {
        cargando = true;
        try
        {
            var query = DbContext.Promociones.AsQueryable();
            
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            
            esSuperAdmin = user.IsInRole("SuperAdministrador");
            esAdmin = user.IsInRole("Administrador");
            
            // FILTRO POR ROL
            // SuperAdmin y Administrador ven TODAS las promociones
            // (el filtro por sucursal se hace en el cliente)
            
            promociones = await query
                .OrderByDescending(p => p.FechaCreacion)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            cargando = false;
        }
    }

    // ============================================
    // BUSCADOR DE SUCURSAL
    // ============================================

    private void AbrirDropdownSucursal()
    {
        mostrarDropdownSucursal = true;
    }

    private void SeleccionarSucursal(SucursalCyc? sucursal)
    {
        if (sucursal == null)
        {
            filtroSucursal = "";
            busquedaSucursal = "";
        }
        else
        {
            filtroSucursal = sucursal.Almacen;
            busquedaSucursal = sucursal.NombreCompleto ?? sucursal.Almacen;
        }
        
        mostrarDropdownSucursal = false;
        paginaActual = 1;
    }

    private async Task CopiarEnlace(string enlace)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", enlace);
        await JS.InvokeVoidAsync("Swal.fire", new
        {
            title = "¡Enlace copiado!",
            text = "El enlace se ha copiado al portapapeles",
            icon = "success",
            confirmButtonText = "Aceptar",
            timer = 2000,
            showConfirmButton = false
        });
    }

    private void CrearPromocion() => NavigationManager.NavigateTo("/promociones/crear");
    private void EditarPromocion(int id) => NavigationManager.NavigateTo($"/promociones/editar/{id}");
    private void ToggleFilters() => mostrarFiltros = !mostrarFiltros;
    
    private void LimpiarFiltros() 
    { 
        filtro = ""; 
        filtroEstado = ""; 
        filtroSucursal = "";
        busquedaSucursal = "";
        paginaActual = 1;
    }
    
    private void CambiarPagina(int pagina) => paginaActual = pagina;

    private async Task ToggleEstado(Promocion promo)
    {
        promo.Activo = !promo.Activo;
        await DbContext.SaveChangesAsync();
        await CargarPromociones();
    }

    private void ConfirmarEliminar(Promocion promo)
    {
        promocionEliminar = promo;
        mostrarModalEliminar = true;
    }

    private async Task EliminarPromocion()
    {
        if (promocionEliminar == null) return;

        try
        {
            DbContext.Promociones.Remove(promocionEliminar);
            await DbContext.SaveChangesAsync();
            await CargarPromociones();
            
            await JS.InvokeVoidAsync("Swal.fire", new
            {
                title = "¡Eliminada!",
                text = $"La promoción '{promocionEliminar.Titulo}' fue eliminada correctamente.",
                icon = "success",
                confirmButtonText = "Aceptar",
                confirmButtonColor = "#0f172a"
            });
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("Swal.fire", new
            {
                title = "Error",
                text = $"No se pudo eliminar la promoción: {ex.Message}",
                icon = "error",
                confirmButtonText = "Aceptar",
                confirmButtonColor = "#ef4444"
            });
        }
        finally
        {
            CerrarModalEliminar();
        }
    }

    private void CerrarModalEliminar()
    {
        mostrarModalEliminar = false;
        promocionEliminar = null;
    }
}