@page "/promociones/{token}"
@layout Layout.BlankLayout
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using RamsCottons.Models
@using RamsCottons.Data

@inject ApplicationDbContext DbContext
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>Promoción | RAMS Cottons</PageTitle>

@if (cargando)
{
    <div class="loading-container">
        <div class="spinner-border text-primary"></div>
        <p>Cargando promoción...</p>
    </div>
}
else if (promocion == null)
{
    <div class="error-container">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <h3>Promoción no encontrada</h3>
        <p>La promoción que buscas no existe o ha expirado.</p>
    </div>
}
else
{
    <div class="promocion-publica">
        <div class="promocion-card">

            <div class="logo">
                <img src="/images/logo.png" alt="RAMS COTTONS" />
            </div>

            <h1 class="titulo">@promocion.Titulo</h1>
            <p class="descripcion">@promocion.Descripcion</p>

            <div class="info-grid">

                @if (promocion.TipoPromocion == "Catalogo")
                {
                    <div class="info-item">
                        <i class="bi bi-tags"></i>
                        <span>Precio: Varios precios</span>
                    </div>
                }
                else
                {
                    <div class="info-item">
                        <i class="bi bi-tag"></i>
                        <span>
                            Precio:
                            @(promocion.Precio.HasValue
                                ? $"${promocion.Precio.Value:N2}"
                                : "-")
                        </span>
                    </div>
                }

                @if (promocion.TipoPromocion == "PrecioUnico" &&
                     promocion.DescuentoPorcentaje.HasValue)
                {
                    <div class="info-item descuento">
                        <i class="bi bi-percent"></i>
                        <span>@promocion.DescuentoPorcentaje.Value.ToString("N2")% OFF</span>
                    </div>
                }

                @if (promocion.TipoPromocion == "PrecioUnico" &&
                     promocion.DescuentoMonto.HasValue)
                {
                    <div class="info-item descuento">
                        <i class="bi bi-currency-dollar"></i>
                        <span>
                            Descuento: $@promocion.DescuentoMonto.Value.ToString("N2")
                        </span>
                    </div>
                }

                <div class="info-item">
                    <i class="bi bi-calendar"></i>
                    <span>
                        Válido hasta: @promocion.FechaFin.ToString("dd MMMM yyyy")
                    </span>
                </div>

            </div>

            @if (!string.IsNullOrEmpty(promocion.pdf_url))
            {
                <div class="archivo-container">

                    @if (promocion.pdf_url.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="pdf-card">

                            <div class="pdf-icon-wrapper">
                                <i class="bi bi-file-earmark-pdf-fill"></i>
                            </div>

                            <div class="pdf-info">
                                <span class="pdf-nombre">
                                    @promocion.pdf_nombre
                                </span>

                                <span class="pdf-tamaño">
                                    PDF • Documento
                                </span>
                            </div>

                            <a href="@promocion.pdf_url"
                               target="_blank"
                               class="pdf-boton">

                                <i class="bi bi-eye"></i>
                                <span>Abrir</span>
                            </a>

                        </div>
                    }
                    else
                    {
                        <div class="imagen-card">

                            <img src="@promocion.pdf_url"
                                 alt="@promocion.Titulo" />

                            <a href="@promocion.pdf_url"
                               target="_blank"
                               class="imagen-boton">

                                <i class="bi bi-arrows-fullscreen"></i>
                                Ver completo
                            </a>

                        </div>
                    }

                </div>
            }

            <a href="https://wa.me/?text=@Uri.EscapeDataString($"¡Mira esta promoción de RAMS COTTONS! {NavigationManager.Uri}")"
               class="btn-whatsapp"
               target="_blank">

                <i class="bi bi-whatsapp"></i>
                Compartir por WhatsApp
            </a>

            <div class="footer">
                <p>© 2026 RAMS COTTONS - Todos los derechos reservados</p>
            </div>

        </div>
    </div>
}

@code {
    [Parameter]
    public string Token { get; set; } = string.Empty;

    private Promocion? promocion;
    private bool cargando = true;

    protected override async Task OnInitializedAsync()
    {
        await CargarPromocion();
    }

    private async Task CargarPromocion()
    {
        cargando = true;

        try
        {
            promocion = await DbContext.Promociones
                .FirstOrDefaultAsync(p =>
                    p.TokenUnico == Token &&
                    p.Activo);

            if (promocion != null &&
                (promocion.FechaFin < DateTime.Today ||
                 promocion.FechaInicio > DateTime.Today))
            {
                promocion = null;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
            promocion = null;
        }
        finally
        {
            cargando = false;
        }
    }
}