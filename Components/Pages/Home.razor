@page "/"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using RamsCottons.Data
@using RamsCottons.Models
@using RamsCottons.Services
@using Microsoft.AspNetCore.Identity
@attribute [Authorize]
@implements IDisposable
@inject ApplicationDbContext DbContext
@inject StatsService StatsService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject PermisoService PermisoService

<PageTitle>Dashboard | RAMS Cottons</PageTitle>

<AuthorizeView Context="authContext">
    <Authorized>
        @if (autorizadoInicio)
        {
        <div class="dashboard-container">

            <!-- HEADER -->
            <div class="hero-section">
                <div class="hero-content">
                    <div class="hero-text">
                        <div class="greeting-chip">
                            <i class="bi bi-stars"></i>
                            <span>@GetSaludo()</span>
                        </div>
                        <h1 class="hero-title">
                            Hola, <span class="hero-name">@authContext.User.Identity?.Name</span>
                        </h1>
                        <p class="hero-subtitle">
                            <i class="bi bi-calendar3"></i> @FormatearFecha(DateTime.Now)
                            <span class="dot">•</span>
                            <i class="bi bi-clock"></i> <span id="live-clock">@DateTime.Now.ToString("hh:mm:ss tt")</span>
                        </p>
                    </div>
                    <div class="hero-decoration">
                        <div class="stats-badge">
                            <div class="stats-badge-icon">
                                <i class="bi bi-bar-chart-steps"></i>
                            </div>
                            <div class="stats-badge-info">
                                <span class="stats-badge-value">@Capitalizar(DateTime.Now.ToString("MMMM", new System.Globalization.CultureInfo("es-ES")))</span>
                                <span class="stats-badge-label">En curso</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="hero-wave">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 120">
                        <path fill="#ffffff" fill-opacity="1" d="M0,64L80,69.3C160,75,320,85,480,80C640,75,800,53,960,48C1120,43,1280,53,1360,58.7L1440,64L1440,120L1360,120C1280,120,1120,120,960,120C800,120,640,120,480,120C320,120,160,120,80,120L0,120Z"></path>
                    </svg>
                </div>
            </div>

            <!-- TARJETAS KPI -->
            <div class="kpi-grid">
                @if (EsSuperAdmin)
                {
                    <div class="kpi-card">
                        <div class="kpi-icon users"><i class="bi bi-people-fill"></i></div>
                        <div class="kpi-info">
                            <div class="kpi-value">@TotalUsuarios</div>
                            <div class="kpi-label">Usuarios</div>
                        </div>
                    </div>
                }

                <div class="kpi-card">
                    <div class="kpi-icon promotions"><i class="bi bi-megaphone-fill"></i></div>
                    <div class="kpi-info">
                        <div class="kpi-value">@PromocionesActivas</div>
                        <div class="kpi-label">Promociones Activas</div>
                    </div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-icon clients"><i class="bi bi-person-badge"></i></div>
                    <div class="kpi-info">
                        <div class="kpi-value">@TotalClientes</div>
                        <div class="kpi-label">Clientes</div>
                    </div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-icon whatsapp"><i class="bi bi-whatsapp"></i></div>
                    <div class="kpi-info">
                        <div class="kpi-value">@TotalEnvios</div>
                        <div class="kpi-label">Envíos WhatsApp</div>
                    </div>
                </div>
            </div>

            <!-- RESUMEN DEL DÍA -->
            <div class="summary-card">
                <div class="summary-header">
                    <div>
                        <h3><i class="bi bi-pie-chart me-2"></i>Resumen del Día</h3>
                        <p class="summary-subtitle">Estadísticas de hoy</p>
                    </div>
                    <div class="refresh-btn" @onclick="() => CargarDatos()">
                        <i class="bi bi-arrow-repeat"></i>
                    </div>
                </div>
                <div class="summary-grid">
                    <div class="summary-item">
                        <div class="summary-icon blue"><i class="bi bi-calendar-check"></i></div>
                        <div class="summary-info">
                            <span class="summary-label">Registros hoy</span>
                            <span class="summary-number">@ClientesHoy</span>
                        </div>
                    </div>
                    <div class="summary-item">
                        <div class="summary-icon green"><i class="bi bi-send"></i></div>
                        <div class="summary-info">
                            <span class="summary-label">Envíos hoy</span>
                            <span class="summary-number">@EnviosHoy</span>
                        </div>
                    </div>
                    <div class="summary-item">
                        <div class="summary-icon orange"><i class="bi bi-graph-up"></i></div>
                        <div class="summary-info">
                            <span class="summary-label">Promedio diario</span>
                            <span class="summary-number">@PromedioDiario</span>
                        </div>
                    </div>
                    <div class="summary-item">
                        <div class="summary-icon purple"><i class="bi bi-percent"></i></div>
                        <div class="summary-info">
                            <span class="summary-label">Tasa de envío</span>
                            <span class="summary-number">@TasaEnvio%</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ACTIVIDAD RECIENTE -->
            <div class="recent-section">
                <div class="section-header">
                    <h3><i class="bi bi-clock-history me-2"></i>Actividad Reciente</h3>
                    <p class="section-subtitle">Últimas actualizaciones del sistema</p>
                </div>

                <div class="recent-grid">
                    <!-- Últimos Envíos -->
                    <div class="recent-card">
                        <div class="recent-card-header">
                            <div class="recent-icon whatsapp-bg"><i class="bi bi-whatsapp"></i></div>
                            <div>
                                <h4>Últimos Envíos</h4>
                                <span class="recent-count">@TotalEnvios total</span>
                            </div>
                        </div>
                        <div class="recent-list">
                            @if (UltimosEnvios.Any())
                            {
                                @foreach (var envio in UltimosEnvios)
                                {
                                    <div class="recent-item">
                                        <div class="recent-avatar whatsapp-avatar"><i class="bi bi-whatsapp"></i></div>
                                        <div class="recent-info">
                                            <span class="recent-name">Cliente #@envio.ClienteId</span>
                                            <span class="recent-time">@envio.FechaEnvio.ToString("dd MMM, HH:mm")</span>
                                        </div>
                                        <div class="recent-badge success">Enviado</div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="empty-state">
                                    <i class="bi bi-inbox"></i>
                                    <p>No hay envíos recientes</p>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Promociones Activas -->
                    <div class="recent-card">
                        <div class="recent-card-header">
                            <div class="recent-icon promo-bg"><i class="bi bi-megaphone"></i></div>
                            <div>
                                <h4>Promociones Activas</h4>
                                <span class="recent-count">@PromocionesActivas activas</span>
                            </div>
                        </div>
                        <div class="recent-list">
                            @if (UltimasPromociones.Any())
                            {
                                @foreach (var promo in UltimasPromociones)
                                {
                                    <div class="recent-item">
                                        <div class="recent-avatar promo-avatar"><i class="bi bi-tag"></i></div>
                                        <div class="recent-info">
                                            <span class="recent-name">@promo.Titulo</span>
                                            <span class="recent-time">Vence @promo.FechaFin.ToString("dd MMM")</span>
                                        </div>
                                        <div class="recent-badge warning">@((promo.FechaFin - DateTime.Now).Days) días</div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="empty-state">
                                    <i class="bi bi-megaphone"></i>
                                    <p>No hay promociones activas</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- FOOTER -->
            <div class="dashboard-footer">
                <p>© 2026 RAMS COTTONS - Sistema de Gestión de Promociones</p>
            </div>
        </div>
        }
    </Authorized>
</AuthorizeView>

@code {
    private System.Threading.Timer? _timer;
    private StatsCache stats = new();
    private bool autorizadoInicio = false;

    // Variables para la vista
    private bool EsSuperAdmin { get; set; }
    private bool EsAdmin { get; set; }

    private int TotalClientes { get; set; }
    private int TotalEnvios { get; set; }
    private int ClientesHoy { get; set; }
    private int EnviosHoy { get; set; }
    private int TotalUsuarios { get; set; }
    private int PromocionesActivas { get; set; }
    private int PromedioDiario { get; set; }
    private int TasaEnvio { get; set; }

    private List<HistorialEnvio> UltimosEnvios { get; set; } = new();
    private List<Promocion> UltimasPromociones { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        var authStatePermiso = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userPermiso = authStatePermiso.User;

        var tienePermisoInicio = await PermisoService.TienePermisoAsync(
            userPermiso,
            Permissions.Inicio_Ver
        );

        if (!tienePermisoInicio)
        {
            NavigationManager.NavigateTo("/clientes", true);
            return;
        }

        autorizadoInicio = true;

        await CargarDatos();

        stats = await StatsService.GetStats();
        TotalUsuarios = stats.TotalUsuarios;

        await base.OnInitializedAsync();
    }

    private async Task CargarDatos()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            EsSuperAdmin = user.IsInRole("SuperAdministrador");
            EsAdmin = user.IsInRole("Administrador");

            // ==================== CLIENTES ====================
            var queryClientes = DbContext.Clientes.AsQueryable();

            TotalClientes = await queryClientes.CountAsync();
            ClientesHoy = await queryClientes.CountAsync(c => c.FechaRegistro.Date == DateTime.Today);

            // ==================== ENVÍOS - LINQ PURO ====================
            try
            {
                var clientesIds = await queryClientes.Select(c => c.Id).ToListAsync();

                if (clientesIds.Any())
                {
                    // TOTAL DE ENVÍOS (LINQ)
                    TotalEnvios = await DbContext.HistorialEnvios
                        .CountAsync(h => clientesIds.Contains(h.ClienteId));

                    // ENVÍOS DE HOY (LINQ)
                    var hoy = DateTime.Today;
                    EnviosHoy = await DbContext.HistorialEnvios
                        .CountAsync(h => clientesIds.Contains(h.ClienteId) 
                                      && h.FechaEnvio.Date == hoy);

                    // ÚLTIMOS 5 ENVÍOS (LINQ)
                    UltimosEnvios = await DbContext.HistorialEnvios
                        .Where(h => clientesIds.Contains(h.ClienteId))
                        .OrderByDescending(h => h.FechaEnvio)
                        .Take(5)
                        .ToListAsync();
                }
                else
                {
                    TotalEnvios = 0;
                    EnviosHoy = 0;
                    UltimosEnvios = new List<HistorialEnvio>();
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error al contar envíos: {ex.Message}");
                TotalEnvios = 0;
                EnviosHoy = 0;
                UltimosEnvios = new List<HistorialEnvio>();
            }

            // ==================== PROMOCIONES ====================
            var queryPromos = DbContext.Promociones.AsQueryable();

            PromocionesActivas = await queryPromos.CountAsync(p => p.Activo);

            UltimasPromociones = await queryPromos
                .Where(p => p.Activo)
                .OrderBy(p => p.FechaFin)
                .Take(5)
                .ToListAsync();

            // ==================== ESTADÍSTICAS ====================
            
            // ✅ FIX 1: Promedio Diario = promedio de envíos por día
            // Calcula los días desde el primer envío hasta hoy
            if (TotalEnvios > 0)
            {
                var primerEnvio = await DbContext.HistorialEnvios
                    .OrderBy(h => h.FechaEnvio)
                    .FirstOrDefaultAsync();

                if (primerEnvio != null)
                {
                    var dias = (DateTime.Today - primerEnvio.FechaEnvio.Date).Days + 1;
                    PromedioDiario = dias > 0 ? TotalEnvios / dias : TotalEnvios;
                }
                else
                {
                    PromedioDiario = 0;
                }
            }
            else
            {
                // Si no hay envíos, usa el promedio de registros por día
                if (TotalClientes > 0)
                {
                    var primerCliente = await queryClientes
                        .OrderBy(c => c.FechaRegistro)
                        .FirstOrDefaultAsync();

                    if (primerCliente != null)
                    {
                        var dias = (DateTime.Today - primerCliente.FechaRegistro.Date).Days + 1;
                        PromedioDiario = dias > 0 ? TotalClientes / dias : TotalClientes;
                    }
                    else
                    {
                        PromedioDiario = 0;
                    }
                }
                else
                {
                    PromedioDiario = 0;
                }
            }

            // ✅ FIX 2: Tasa de Envío limitada a 100% (nunca puede pasar de 100%)
            TasaEnvio = TotalClientes > 0 
                ? Math.Min((TotalEnvios * 100 / TotalClientes), 100) 
                : 0;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error general en CargarDatos: {ex.Message}");
        }
    }

    protected override void OnInitialized()
    {
        _timer = new System.Threading.Timer((_) =>
        {
            InvokeAsync(StateHasChanged);
        }, null, 0, 1000);
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }

    private string GetSaludo()
    {
        var hour = DateTime.Now.Hour;
        if (hour < 12) return "Buenos días";
        if (hour < 18) return "Buenas tardes";
        return "Buenas noches";
    }

    private string Capitalizar(string texto)
    {
        if (string.IsNullOrEmpty(texto))
            return texto;

        return char.ToUpper(texto[0]) + texto.Substring(1);
    }

    private string FormatearFecha(DateTime fecha)
    {
        var cultura = new System.Globalization.CultureInfo("es-ES");

        var dia = fecha.ToString("dddd", cultura);
        var mes = fecha.ToString("MMMM", cultura);

        dia = Capitalizar(dia);
        mes = Capitalizar(mes);

        return $"{dia}, {fecha.Day} {mes} {fecha.Year}";
    }
}